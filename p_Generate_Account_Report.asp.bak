' END ADD AKBAR 14 JANUARI 1013	   

Dim ScriptExecuted, v_tahun, v_Bulan

ScriptExecuted = ""
ScriptExecuted = Request("ScriptExecuted")

if ScriptExecuted = "ByVariable" then
	v_tahun = Request("txtYear")
	v_Bulan = Request("txtMonth")
else
	v_tahun = Cdbl( Left( cmdAccountPeriodClose("Costbook") , 4))
	v_Bulan = Cdbl( Right( cmdAccountPeriodClose("Costbook") , 2))
end if

Dim month_from : month_from = ""
Dim month_until : month_until = ""

month_from = v_tahun & Lpad(v_Bulan, "0", 2)
month_until = v_tahun & Lpad(v_Bulan, "0", 2)
%>

	<br/><!--Enter-->
	Anda Sedang Memproses <strong><%=PCase(textReportName)%></strong> Bulan: <strong><%=Bulan(v_Bulan)%></strong> Tahun: <strong><%=v_tahun%></strong>
	<br/><!--Enter-->
	<br/><!--Enter-->
	Please Wait...
	<br/><!--Enter-->
<%

'***************************************************************************************'
'   Keterangan: 1. Kami nonaktifkan proses yang lama
'               2. Proses generate kami rubah menjadi eksekusi package (API)
'               3. Modifikasi oleh Uqie tgl 20 feb 2014
'***************************************************************************************'

Dim oRecordset, oQuery

'***** For temporary purposes we make the hardcode *****'
Dim budget_year : budget_year = 1900
Dim budget_version : budget_version = 1
Dim module_version : module_version = 1
'*******************************************************'

'********** GENERATE ACCOUNT REPORT TM TBM DAN BIBITAN **********'
	budget_year = v_tahun

	oQuery	= 	" BEGIN GENERATE_AR_REPORT_API.GenerateUnit(" & _
				"                                    '" & month_from & "'" & _
				"                                    , '" & month_until & "'" & _
				"                                    , '" & Session("FCBA") & "'" & _
				"                                    , " & budget_year & "" & _
				"                                    , " & budget_version & "" & _
				"                                    , " & module_version & "" & _
				" ); END; "

	'Response.Write oQuery & "<br/>"
	
	connStr.execute(oQuery)
			
'********** END GENERATE ACCOUNT REPORT TM TBM DAN BIBITAN **********'










