var jumlwip = $('#jumldatawip').val();
var StartIterationwip =  jumlwip + 1	
function addrowWIP(trid)
{

	var lstwip = this.StartIterationwip++;
	if (lstwip < 2) {
		var row = $("#trheader4").after("<tr id='trw" + lstwip + "'></tr>");
		var kurangbutton = "&nbsp;";
	} else {
		var row = $('#trw' + trid).after("<tr id='trw" + lstwip + "'></tr>");
		var kurangbutton = "<img src='css/login/images/del.png' onclick='deleterowWIP(" + lstwip + ")' />";
	}

	var spkno = "<select name='spkno' id='spkno" + lstwip + "' class='lebarspkno'></select>";
	$('#trw' + lstwip).append("<td class='ratakiri'>" + spkno + "</td>");

	var contractorcode = "<select name='contractorcode' id='contractorcode" + lstwip + "' class='lebaractivity'></select>";
	$('#trw' + lstwip).append("<td class='ratakiri'>" + contractorcode + "</td>");

	var activityiwip = "<select name='activityiwip' id='activityiwip" + lstwip + "' class='lebaractivity'></select>";
	$('#trw' + lstwip).append("<td class='ratakiri'>" + activityiwip + "</td>");

	var tcwip = "<select name='tcwip' id='tcwip" + lstwip + "' class='lebarabsen ratatengah'></select>";
	$('#trw' + lstwip).append("<td class='ratakiri'>" + tcwip + "</td>");

	var qtywip = "<input type='text' name='qtywip' id='qtywip" + lstwip + "' value='0' class='lebarabsen ratatengah'>";
	$('#trw' + lstwip).append("<td class='ratakiri'>" + qtywip + "</td>");

	var unitwip = "<input type='text' name='unitwip' id='unitwip" + lstwip + "' value='0' class='lebarabsen ratatengah'>";
	$('#trw' + lstwip).append("<td class='ratakiri'>" + unitwip + "</td>");

	var outputwip = "<input type='text' name='outputwip' id='outputwip" + lstwip + "' value='0' class='lebarabsen ratatengah'>";
	$('#trw' + lstwip).append("<td class='ratakiri'>" + outputwip + "</td>");

	var tambahbutton = "<img src='css/login/images/add.jpg' onclick='addrowWIP(" + lstwip + ")' />";
	$('#trw' + lstwip).append("<td>" + tambahbutton + "</td>");

	$('#trw' + lstwip).append("<td>" + kurangbutton + "</td>");

	showSPK("spkno" + lstwip);
	showContractor("contractorcode" + lstwip);
	showActivitySPK("activityiwip" + lstwip);
	showtcWIP("tcwip" + lstwip);
	getjmlRowwip();
	
}

// DELETE ROW WIP
function deleterowWIP(i) {
	Spry.Widget.Utils.destroyWidgets('spkno' + i);
