//getLoadUpah
function getLoad() {
		
	var bkmno = $("#bkmno").val();
	var upahedit = 2;
	$.post("bkm_employee_load.asp?upahedit=" + upahedit +"&bkmno=" + bkmno, function(data) {
		
		var json  = JSON.parse(data);
		var jumlview  = json.results.length;
		for (var i = 0; i < jumlview; i++) {

			showEmployee("fccode" + i);
			showFCBA("lokasi" + i);
			showAbsen("absen" + i);
			showActivity("activity" + i);
			showTC("tcupah" + i);
			showAllowed("allowedcode" + i);
			
		}
	});
	
	
}


var jumlinv = $('#jumldata').val();
var StartIteration =  jumlinv + 1	
function addrowUpah(trid) {
	 
	var lastrow = this.StartIteration++;
	if (lastrow < 2) {
		var row = $("#trheader2").after("<tr id='tru" + lastrow + "'></tr>");
		var kurangbutton = "&nbsp;";
	} else {
		var row = $('#tru' + trid).after("<tr id='tru" + lastrow + "'></tr>");
		var kurangbutton = "<img src='css/login/images/del.png' onclick='deleterowUpah(" + lastrow + ")' />";
	}

	var fccode = "<select name='fccode" + lastrow + "' id='fccode" + lastrow + "' class='lebaractivity'></select>";
	$('#tru' + lastrow).append("<td>" + fccode + "</td>");

	var lokasi = "<select name='lokasi" + lastrow + "" + lastrow + "' id='lokasi" + lastrow + "' class='ratakiri lebarlokasi'></select>";
	$('#tru' + lastrow).append("<td class='ratakiri lebarlokasi'>" + lokasi + "</td>");


	var absen = "<select name='absen" + lastrow + "' id='absen" + lastrow + "' class='lebarabsen' onchange='getDisable(" + lastrow + ");'></select>";
	$('#tru' + lastrow).append("<td class='ratakiri lebarabsen'>" + absen + "</td>");

	var activity = "<select name='activity" + lastrow + "' id='activity" + lastrow + "' class='lebaractivity' onchange='getTC(" + lastrow + ");getDisable2(" + lastrow + ")'></select>";
	$('#tru' + lastrow).append("<td>" + activity + "</td>");

	var tc = "<select name='tcupah" + lastrow + "' id='tcupah" + lastrow + "' class='lebartc ratatengah'></select>";
	$('#tru' + lastrow).append("<td>" + tc + "</td>");

	var hk = "<input type='text' name='hk" + lastrow + "' id='hk" + lastrow + "' value='0' class='lebarabsen ratatengah'>";
	$('#tru' + lastrow).append("<td>" + hk + "</td>");

	var bunch = "<input type='text' name='bunch" + lastrow + "' id='bunch" + lastrow + "' onkeyup='hanyaAngka(this)' value='0' class='ratatengah lebarabsen'>";
	$('#tru' + lastrow).append("<td class='ratatengah'>" + bunch + "</td>");

	var abw = "<input type='text' name='abw" + lastrow + "' id='abw" + lastrow + "' onkeyup='hanyaAngka(this)' value='0' class='ratatengah lebarabsen'>";
	$('#tru' + lastrow).append("<td class='ratatengah'>" + abw + "</td>");

	var kgbrondolan = "<input type='text' name='kgbrondolan" + lastrow + "' id='kgbrondolan" + lastrow + "' onkeyup='hanyaAngka(this)' value='0' class='ratatengah lebarabsen'>";
	$('#tru' + lastrow).append("<td class='ratatengah'>" + kgbrondolan + "</td>");


	var unit = "<input type='text' name='unit" + lastrow + "' id='unit" + lastrow + "' value='0' class='lebarabsen ratatengah'>";
	$('#tru' + lastrow).append("<td>" + unit + "</td>");

	var output = "<input type='text' name='output" + lastrow + "' id='output" + lastrow + "' value='0' class='lebarabsen ratatengah'>";
	$('#tru' + lastrow).append("<td>" + output + "</td>");

	var ratekb = "<input type='text' name='ratekb" + lastrow + "' id='ratekb" + lastrow + "' onkeyup='hanyaAngka(this)' value='0' class='ratatengah lebarrate'>";
	$('#tru' + lastrow).append("<td class='ratatengah'>" + ratekb + "</td>");


	var allowedcode = "<select name='allowedcode" + lastrow + "' id='allowedcode" + lastrow + "' class='lebarallow'></select>";
	$('#tru' + lastrow).append("<td>" + allowedcode + "</td>");


	var amount = "<input type='text' name='amount" + lastrow + "' id='amount" + lastrow + "' value='0' class='lebarupah ratakanan'>";
	$('#tru' + lastrow).append("<td>" + amount + "</td>");

	
	var tambahbutton = "<img src='css/login/images/add.jpg' onclick='addrowUpah(" + lastrow + ")' />";
	$('#tru' + lastrow).append("<td>" + tambahbutton + "</td>");

	$('#tru' + lastrow).append("<td>" + kurangbutton + "</td>");

	showEmployee("fccode" + lastrow);
	showFCBA("lokasi" + lastrow);
	showAbsen("absen" + lastrow);
	showActivity("activity" + lastrow);
	showTC("tc" + lastrow);
	showAllowed("allowedcode" + lastrow);
	getjmlRow();
}


function deleterowUpah(i) {
	Spry.Widget.Utils.destroyWidgets('fccode' + i);
	Spry.Widget.Utils.destroyWidgets('lokasi' + i);
	Spry.Widget.Utils.destroyWidgets('absen' + i);
	Spry.Widget.Utils.destroyWidgets('activity' + i);
	Spry.Widget.Utils.destroyWidgets('tcupah' + i);
	Spry.Widget.Utils.destroyWidgets('hk' + i);
	Spry.Widget.Utils.destroyWidgets('bunch' + i);
	Spry.Widget.Utils.destroyWidgets('abw' + i);
	Spry.Widget.Utils.destroyWidgets('kgbrondolan' + i);
	Spry.Widget.Utils.destroyWidgets('unit' + i);
	Spry.Widget.Utils.destroyWidgets('output' + i);
	Spry.Widget.Utils.destroyWidgets('ratekb' + i);
	Spry.Widget.Utils.destroyWidgets('allowedcode' + i);
		
	 $('#tru' + i).remove();
	 getjmlRow();
}

//hitung jumlah row pada tabel upah
function getjmlRow()
{
	
	var oRows = document.getElementById('table2').getElementsByTagName('tr');
	var iRowCount = oRows.length;
