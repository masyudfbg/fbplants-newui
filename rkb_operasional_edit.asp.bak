//getLoaditem
function getLoaditem() {
	
	var bkmno = $("#bkmno").val();
	var jmlitem = 1;
	$.post("bkm_show_item.asp?jmlitem=" + jmlitem +"&bkmno=" + bkmno, function(data) {
		var json  = JSON.parse(data);
		var jumlview  = json.results.length;
		
		for (var i = 0; i < jumlview; i++) {

			//showTC("tc" + i);
			showItem("ITEMCODE" + i);
			showActivityitem("activityitem" + i);
			
		}
	});
	
	
}


