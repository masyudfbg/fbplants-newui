var jumlitem = $('#jumldataitem').val();
var StartIterationitem =  jumlitem + 1	
function addrowBahan(trid)
{

	var lstitem = this.StartIterationitem++;
	if (lstitem < 2) {
		var row = $("#trheader2").after("<tr id='trb" + lstitem + "'></tr>");
		var kurangbutton = "&nbsp;";
	} else {
		var row = $('#trb' + trid).after("<tr id='trb" + lstitem + "'></tr>");
		var kurangbutton = "<img src='css/login/images/del.png' onclick='deleterowBahan(" + lstitem + ")' />";
	}

	var ITEMCODE = "<select name='ITEMCODE' id='ITEMCODE" + lstitem + "' class='lebaritembarang'></select>";
	$('#trb' + lstitem).append("<td class='ratakiri'>" + ITEMCODE + "</td>");

	var uom = "<input type='text' name='uom' id='uom" + lstitem + "' value='' class='lebarabsen ratatengah'>";
	$('#trb' + lstitem).append("<td class='ratakiri'>" + uom + "</td>");

	var activityitem = "<select name='activityitem' id='activityitem" + lstitem + "' class='lebaractbarang'></select>";
	$('#trb' + lstitem).append("<td class='ratakiri'>" + activityitem + "</td>");

	var tcitem = "<select name='tcitem' id='tcitem" + lstitem + "' class='lebarabsen ratatengah'></select>";
	$('#trb' + lstitem).append("<td class='ratakiri'>" + tcitem + "</td>");

	var qtyitem = "<input type='text' name='qtyitem' id='qtyitem" + lstitem + "' value='0' class='lebarabsen ratatengah'>";
	$('#trb' + lstitem).append("<td class='ratakiri'>" + qtyitem + "</td>");

	var tambahbutton = "<img src='css/login/images/add.jpg' onclick='addrowBahan(" + lstitem + ")' />";
	$('#trb' + lstitem).append("<td>" + tambahbutton + "</td>");

	$('#trb' + lstitem).append("<td>" + kurangbutton + "</td>");

	showItem("ITEMCODE" + lstitem);
	showActivityitem("activityitem" + lstitem);

	
}


function deleterowBahan(i) {
	Spry.Widget.Utils.destroyWidgets('ITEMCODE' + i);
	Spry.Widget.Utils.destroyWidgets('uom' + i);
	Spry.Widget.Utils.destroyWidgets('activityitem' + i);
	Spry.Widget.Utils.destroyWidgets('tcitem' + i);
	Spry.Widget.Utils.destroyWidgets('qtyitem' + i);
	 $('#trb' + i).remove();
}


var jumlvh = $('#jumlvh').val();
var StartIterationvh =  jumlvh + 1	
function addrowVH(trid)
{

	var lstvh = this.StartIterationvh++;
	if (lstvh < 2) {
		var row = $("#trheader3").after("<tr id='trv" + lstvh + "'></tr>");
		var kurangbutton = "&nbsp;";
	} else {
		var row = $('#trv' + trid).after("<tr id='trv" + lstvh + "'></tr>");
		var kurangbutton = "<img src='css/login/images/del.png' onclick='deleterowVH(" + lstvh + ")' />";
	}

	var employeecode = "<select name='employeecode" + lstvh + "' id='employeecode" + lstvh + "' class='lebarvehicle'></select>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + employeecode + "</td>");

	var lokasivh = "<select name='lokasivh" + lstvh + "' id='lokasivh" + lstvh + "' class='ratakiri lebarabsen'></select>";
	$('#trv' + lstvh).append("<td class='ratakiri lebarabsen'>" + lokasivh + "</td>");


	var vehiclecode = "<select name='vehiclecode' id='vehiclecode" + lstvh + "' class='lebarvehicle'></select>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + vehiclecode + "</td>");

	var timestart = "<input type='text' name='timestart' id='timestart" + lstvh + "' value='' class='lebartime ratatengah'>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + timestart + "</td>");

	var activityivh = "<select name='activityivh' id='activityivh" + lstvh + "' class='lebaractivity'></select>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + activityivh + "</td>");

	var tcvh = "<select name='tcvh' id='tcvh" + lstvh + "' class='lebarabsen ratatengah'></select>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + tcvh + "</td>");

	var kattransport = "<select name='kattransport' id='kattransport" + lstvh + "' class='lebaractivity'></select>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + kattransport + "</td>");

	var trip = "<input type='text' name='trip" + lstvh + "' id='trip" + lstvh + "' value='0' onkeyup='hanyaAngka(this)' class='lebarabsen ratatengah'>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + trip + "</td>");


	var jamkerja = "<input type='text' name='jamkerja' id='jamkerja" + lstvh + "' value='0' class='lebarabsen ratatengah'>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + jamkerja + "</td>");

	var kmhm = "<input type='text' name='kmhm' id='kmhm" + lstvh + "' value='0' class='lebarabsen ratatengah'>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + kmhm + "</td>");

	var output = "<input type='text' name='output' id='output" + lstvh + "' value='0' class='lebarabsen ratatengah'>";
	$('#trv' + lstvh).append("<td class='ratakiri'>" + output + "</td>");

	var tambahbutton = "<img src='css/login/images/add.jpg' onclick='addrowVH(" + lstvh + ")' />";
	$('#trv' + lstvh).append("<td>" + tambahbutton + "</td>");

	$('#trv' + lstvh).append("<td>" + kurangbutton + "</td>");

	showEmployeeVH("employeecode" + lstvh);
	showFCBAVH("lokasivh" + lstvh);
	showVH("vehiclecode" + lstvh);
	showActivityVH("activityivh" + lstvh);
	showtcVH("tcvh" + lstvh);
	showkategoriTR("kattransport" + lstvh);
	getjmlRowvh();

	
}

function deleterowVH(i) {
	Spry.Widget.Utils.destroyWidgets('employeecode' + i);
	Spry.Widget.Utils.destroyWidgets('lokasi' + i);
	Spry.Widget.Utils.destroyWidgets('vehiclecode' + i);
	Spry.Widget.Utils.destroyWidgets('timestart' + i);
	Spry.Widget.Utils.destroyWidgets('activityivh' + i);
	Spry.Widget.Utils.destroyWidgets('tcvh' + i);
	Spry.Widget.Utils.destroyWidgets('kattransport' + i);
	Spry.Widget.Utils.destroyWidgets('trip' + i);
	Spry.Widget.Utils.destroyWidgets('jamkerja' + i);
	Spry.Widget.Utils.destroyWidgets('kmhm' + i);
	Spry.Widget.Utils.destroyWidgets('outputvh' + i);
	 $('#trv' + i).remove();
	 getjmlRowvh();
}


