<%@Language=VBScript%>
<% Option Explicit %>
<% ValidateSession %>
<!--#include virtual="/connDb1.inc"-->
<!--#include virtual="/txtFunction.inc"-->
<!--#include virtual="/adovbs.inc"-->
<%
Dim v_txtYear, v_txtMonth, v_txtGangCode, v_txtGrade
Dim ScriptName
Dim rsEmployee, strEmployee, rsAtt, strAtt, rsKJ, strKJ
Dim NO, cClass, nday

v_txtYear		=	Request("txtYear")
v_txtMonth		=	Request("txtMonth")
v_txtGangCode	=	Request("txtGangCode")
v_txtGrade		=	Request("txtGrade")

ScriptName	=	Request.ServerVariables("SCRIPT_NAME")

if request("txtYear")="" then
   v_txtYear	=	Year(Session("v_Employee"))
end if
if request("txtMonth")="" then
   v_txtMonth	=	Month(Session("v_Employee"))
end if

strEmployee	=	" SELECT em.gangcode" & _
				"        , ag.employeecode" & _
				"        , em.fcname employeename" & _
				"        , em.presentgrade status" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),1,overtime_hours,0)) day_overtime_hours_1" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),2,overtime_hours,0)) day_overtime_hours_2" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),3,overtime_hours,0)) day_overtime_hours_3" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),4,overtime_hours,0)) day_overtime_hours_4" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),5,overtime_hours,0)) day_overtime_hours_5" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),6,overtime_hours,0)) day_overtime_hours_6" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),7,overtime_hours,0)) day_overtime_hours_7" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),8,overtime_hours,0)) day_overtime_hours_8" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),9,overtime_hours,0)) day_overtime_hours_9" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),10,overtime_hours,0)) day_overtime_hours_10" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),11,overtime_hours,0)) day_overtime_hours_11" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),12,overtime_hours,0)) day_overtime_hours_12" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),13,overtime_hours,0)) day_overtime_hours_13" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),14,overtime_hours,0)) day_overtime_hours_14" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),15,overtime_hours,0)) day_overtime_hours_15" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),16,overtime_hours,0)) day_overtime_hours_16" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),17,overtime_hours,0)) day_overtime_hours_17" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),18,overtime_hours,0)) day_overtime_hours_18" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),19,overtime_hours,0)) day_overtime_hours_19" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),20,overtime_hours,0)) day_overtime_hours_20" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),21,overtime_hours,0)) day_overtime_hours_21" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),22,overtime_hours,0)) day_overtime_hours_22" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),23,overtime_hours,0)) day_overtime_hours_23" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),24,overtime_hours,0)) day_overtime_hours_24" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),25,overtime_hours,0)) day_overtime_hours_25" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),26,overtime_hours,0)) day_overtime_hours_26" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),27,overtime_hours,0)) day_overtime_hours_27" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),28,overtime_hours,0)) day_overtime_hours_28" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),29,overtime_hours,0)) day_overtime_hours_29" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),30,overtime_hours,0)) day_overtime_hours_30" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),31,overtime_hours,0)) day_overtime_hours_31" & _
				"        , SUM(overtime_hours) total_overtime_hours" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),1,othrs,0)) day_1" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),2,othrs,0)) day_2" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),3,othrs,0)) day_3" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),4,othrs,0)) day_4" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),5,othrs,0)) day_5" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),6,othrs,0)) day_6" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),7,othrs,0)) day_7" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),8,othrs,0)) day_8" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),9,othrs,0)) day_9" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),10,othrs,0)) day_10" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),11,othrs,0)) day_11" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),12,othrs,0)) day_12" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),13,othrs,0)) day_13" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),14,othrs,0)) day_14" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),15,othrs,0)) day_15" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),16,othrs,0)) day_16" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),17,othrs,0)) day_17" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),18,othrs,0)) day_18" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),19,othrs,0)) day_19" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),20,othrs,0)) day_20" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),21,othrs,0)) day_21" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),22,othrs,0)) day_22" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),23,othrs,0)) day_23" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),24,othrs,0)) day_24" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),25,othrs,0)) day_25" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),26,othrs,0)) day_26" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),27,othrs,0)) day_27" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),28,othrs,0)) day_28" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),29,othrs,0)) day_29" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),30,othrs,0)) day_30" & _
				"        , SUM(DECODE(TO_NUMBER(TO_CHAR(fddate, 'dd')),31,othrs,0)) day_31" & _
				"        , SUM(NVL(othrs,0)) total" & _
				" FROM (" & _
				" SELECT fcba, fddate, gangcode, employeecode, SUM(othrs) othrs, SUM(overtime_hours) overtime_hours" & _
				" FROM attendance_gad_temp " & _
				" WHERE fcba = '" & Session ("FCBA") & "'" & _
				"       AND TO_CHAR(fddate, 'yyyymm') = '" & v_txtYear & "'||LPAD('" & v_txtMonth & "', 2, 0)" & _
				"       AND attendance IN ('KJ', 'WH', 'WS', 'KK', 'KL')"
if  LEN(TRIM(v_txtGangCode)) > 0 then
	strEmployee = strEmployee & " AND gangcode = '" & v_txtGangCode & "'"
end if
strEmployee = strEmployee & " GROUP BY fcba, fddate, gangcode, employeecode" & _
							" UNION ALL " & _
							" SELECT a.fcba, bkmdate fddate, gangcode, employeecode, SUM(othconvertion) othrs, SUM(overtime_hours) overtime_hours" & _
							" FROM bkmupahdtl a inner join bkmhdr b on (a.bkmno=b.bkmno and a.fcba=b.fcba) " & _ 
							" WHERE a.fcba = '" & Session ("FCBA") & "'" & _
							"       AND TO_CHAR(bkmdate, 'yyyymm') = '" & v_txtYear & "'||LPAD('" & v_txtMonth & "', 2, 0)" & _
							"       AND attendance IN ('KJ', 'WH', 'WS', 'KK', 'KL') "
if  LEN(TRIM(v_txtGangCode)) > 0 then
	strEmployee = strEmployee & " AND gangcode = '" & v_txtGangCode & "'"
end if
strEmployee = strEmployee &	" GROUP BY a.fcba, bkmdate, gangcode, employeecode" & _
							") ag  LEFT JOIN employee em ON (ag.fcba = em.fcba AND ag.employeecode = em.fccode)" & _
							" WHERE 1=1"
if  LEN(TRIM(v_txtGrade)) > 0 then
	strEmployee	=	strEmployee & " AND em.presentgrade = '" & v_txtGrade & "'"
end if
if  LEN(TRIM(v_txtGangCode)) > 0 then
	strEmployee	=	strEmployee & " AND em.gangcode = '" & v_txtGangCode & "'"
end if

strEmployee = strEmployee & " GROUP BY em.gangcode" & _
							"          , ag.employeecode" & _
							"          , em.fcname" & _
							"          , em.presentgrade" & _
							" ORDER BY ag.employeecode" 

							
' response.write strEmployee
%>
<html>

<head>
<link rel="stylesheet" href="/css/stylereport2.css" type="text/css" />
<title>ePlaS Reporting - Lembur Karyawan</title>
<script language="JavaScript" src='/js/x.js'></script>
<script language="JavaScript" src='/js/xtableheaderfixed.js'></script>
<script language="JavaScript">
xAddEventListener(window, 'load',
  function() {
    new xTableHeaderFixed('xthf-site', window);
    new xTableHeaderFixed('xthf-green', window);
    new xTableHeaderFixed('xthf-blue', window);
  }, false
);
</script>
<script language="JavaScript" src="/js/date-picker.js"></script> 
<script language="JavaScript">
var newwin;
function launchwin(winurl,winname,winfeatures)
{
	//This launches a new window and then
	//focuses it if window.focus() is supported.
	newwin = window.open(winurl,winname,winfeatures);

}
</script>
</head>

<body>
	<div id="wrapper">
	<!--#include file="../print_excel.asp"-->
	<div id="header-wrapper">
	<!--#include file="menutop.asp"-->
    <table id="form-table" class="centered-margin">
	<form action="<%=ScriptName%>" method="post" name="frmEntry">
	<tr>
		<td><font face="verdana" size="1">YEAR</font></td><td width="4"><input type="text" name="txtYear" width="4" value="<%=v_txtYear%>"></td>
		<td><font face="verdana" size="1">MONTH</font></td><td width="2"><input type="text" name="txtMonth" width="2" value="<%=v_txtMonth%>"></td>
		<td><font face="verdana" size="1">GANGCODE</font></td><td><select name="txtGangCode" ><option value=""></option>
		<%
		Dim rsGangCode, strGangCode
		strGangCode	=	" SELECT FCCODE, FCNAME FROM GANG WHERE ACTIVATION = 'Y' AND FCBA = '" & Session("FCBA") & "' ORDER BY FCCODE ASC"
		
		Set rsGangCode = Server.CreateObject("ADODB.Recordset")
		rsGangCode.Open strGangCode, connstr, adOpenStatic 
		
		if not rsGangCode.eof then
		Do While Not rsGangCode.eof
		if rsGangCode("FCCODE") = v_txtGangCode then%>
		        <option value="<%=rsGangCode("FCCODE")%>" Selected><%=rsGangCode("FCCODE")%>-<%=rsGangCode("FCNAME")%></option> 
		     <%Else%>
		        <option value="<%=rsGangCode("FCCODE")%>"><%=rsGangCode("FCCODE")%>-<%=rsGangCode("FCNAME")%></option>  
		    <%End if
			rsGangCode.movenext
		loop
		end if
		rsGangCode.Close
		set rsGangCode = Nothing
		%>
		</select></td>
		<td><font face="verdana" size="1">STATUS</font></td><td><select name="txtGrade" ><option value=""></option>
		<%
		Dim rsGrade, strGrade
		strGrade	=	" SELECT 'KHL' FCCODE, 'Karyawan Harian Lepas' FCNAME FROM DUAL" & _
						" UNION" & _
						" SELECT 'KHT' FCCODE, 'Karyawan Harian Tetap' FCNAME FROM DUAL" & _
						" UNION" & _
						" SELECT 'KBT' FCCODE, 'Karyawan Bulanan Tetap' FCNAME FROM DUAL"
		
		Set rsGrade = Server.CreateObject("ADODB.Recordset")
		rsGrade.Open strGrade, connstr, adOpenStatic 
		
		if not rsGrade.eof then
		Do While Not rsGrade.eof
		if rsGrade("FCCODE") = v_txtGrade then%>
		        <option value="<%=rsGrade("FCCODE")%>" Selected><%=rsGrade("FCCODE")%>-<%=rsGrade("FCNAME")%></option> 
		     <%Else%>
		        <option value="<%=rsGrade("FCCODE")%>"><%=rsGrade("FCCODE")%>-<%=rsGrade("FCNAME")%></option>  
		    <%End if
			rsGrade.movenext
		loop
		end if
		rsGrade.Close
		set rsGrade = Nothing
		%>
		</select></td>
		<td><input type="submit" value="View" /></td>
	</tr>
	</form>
</table>
</div>
<table border="0" width="100%" id="product-table" class="xthf-site">
<thead>
	<tr>
    <th colspan="50" style="background-color:#FFFFFF; border:none;">  
	<div id="header-wrapper">
		<div id="head_judul" style="float:left; text-align:left;">
		<h4>PT. <%=Session("COMPANY")%></h4>
		<h5><%=Session("BA")%></h5>
	</div>
	<div id="subheader" class="centered" style="width:50%; margin:auto;">
		<h2>LAPORAN LEMBUR KARYAWAN</h3>
		<br/>
		<h4>PERIODE&nbsp;:&nbsp;<%=textMonth(v_txtMonth)%>&nbsp;<%=v_txtYear%></h4>
	</div>
	</div>
       </th>
  </tr>
	<tr>
		<th>NO</th>
		<th>NO PEKERJA</th>
		<th>NAMA PEKERJA</th>
		<th>STATUS</th>
		<th>GANG</th>
<%for nday = 1 to 31%>
<th><%=nday%></th>
<%next%>
		<th>TOTAL</th>
	</tr>
</thead>
<tbody>
<%
Set rsEmployee = Server.CreateObject("ADODB.Recordset")
rsEmployee.Open strEmployee, connstr, adOpenStatic

Dim nday_1
Dim nday_2
Dim nday_3
Dim nday_4
Dim nday_5
Dim nday_6
Dim nday_7
Dim nday_8
Dim nday_9
Dim nday_10
Dim nday_11
Dim nday_12
Dim nday_13
Dim nday_14
Dim nday_15
Dim nday_16
Dim nday_17
Dim nday_18
Dim nday_19
Dim nday_20
Dim nday_21
Dim nday_22
Dim nday_23
Dim nday_24
Dim nday_25
Dim nday_26
Dim nday_27
Dim nday_28
Dim nday_29
Dim nday_30
Dim nday_31
Dim nTOTAL

if rsEmployee.eof and rsEmployee.eof then
%>
	<tr>
		<td colspan="37">NO DATA AVAILABLE</td>
	</tr>
<%end if
		NO = 1
		
		nday_1 = 0
		nday_2 = 0
		nday_3 = 0
		nday_4 = 0
		nday_5 = 0
		nday_6 = 0
		nday_7 = 0
		nday_8 = 0
		nday_9 = 0
		nday_10 = 0
		nday_11 = 0
		nday_12 = 0
		nday_13 = 0
		nday_14 = 0
		nday_15 = 0
		nday_16 = 0
		nday_17 = 0
		nday_18 = 0
		nday_19 = 0
		nday_20 = 0
		nday_21 = 0
		nday_22 = 0
		nday_23 = 0
		nday_24 = 0
		nday_25 = 0
		nday_26 = 0
		nday_27 = 0
		nday_28 = 0
		nday_29 = 0
		nday_30 = 0
		nday_31 = 0
		nTOTAL = 0


		while not rsEmployee.eof
			if no  mod 2 = 1 then
				cClass = "odd"
			else
				cClass = "default"
			end if
%>
			<tr class="<%=cClass%>">
				<td align="center"><%=NO%></td>
				<td align="center"><%=rsEmployee("EMPLOYEECODE")%></td>
				<td align="left"><%=rsEmployee("EMPLOYEENAME")%></td>
				<td align="center"><%=rsEmployee("STATUS")%></td>
				<td align="center"><%=rsEmployee("GANGCODE")%></td>
				<td align="right"><%=rsEmployee("day_1")%></td>
				<td align="right"><%=rsEmployee("day_2")%></td>
				<td align="right"><%=rsEmployee("day_3")%></td>
				<td align="right"><%=rsEmployee("day_4")%></td>
				<td align="right"><%=rsEmployee("day_5")%></td>
				<td align="right"><%=rsEmployee("day_6")%></td>
				<td align="right"><%=rsEmployee("day_7")%></td>
				<td align="right"><%=rsEmployee("day_8")%></td>
				<td align="right"><%=rsEmployee("day_9")%></td>
				<td align="right"><%=rsEmployee("day_10")%></td>
				<td align="right"><%=rsEmployee("day_11")%></td>
				<td align="right"><%=rsEmployee("day_12")%></td>
				<td align="right"><%=rsEmployee("day_13")%></td>
				<td align="right"><%=rsEmployee("day_14")%></td>
				<td align="right"><%=rsEmployee("day_15")%></td>
				<td align="right"><%=rsEmployee("day_16")%></td>
				<td align="right"><%=rsEmployee("day_17")%></td>
				<td align="right"><%=rsEmployee("day_18")%></td>
				<td align="right"><%=rsEmployee("day_19")%></td>
				<td align="right"><%=rsEmployee("day_20")%></td>
				<td align="right"><%=rsEmployee("day_21")%></td>
				<td align="right"><%=rsEmployee("day_22")%></td>
				<td align="right"><%=rsEmployee("day_23")%></td>
				<td align="right"><%=rsEmployee("day_24")%></td>
				<td align="right"><%=rsEmployee("day_25")%></td>
				<td align="right"><%=rsEmployee("day_26")%></td>
				<td align="right"><%=rsEmployee("day_27")%></td>
				<td align="right"><%=rsEmployee("day_28")%></td>
				<td align="right"><%=rsEmployee("day_29")%></td>
				<td align="right"><%=rsEmployee("day_30")%></td>
				<td align="right"><%=rsEmployee("day_31")%></td>
				<td align="right"><%=rsEmployee("TOTAL")%></td>
<%
			NO = NO + 1
			
			nday_1 =  nday_1 + Cdbl(rsEmployee("day_1"))
			nday_2 =  nday_2 + Cdbl(rsEmployee("day_2"))
			nday_3 =  nday_3 + Cdbl(rsEmployee("day_3"))
			nday_4 =  nday_4 + Cdbl(rsEmployee("day_4"))
			nday_5 =  nday_5 + Cdbl(rsEmployee("day_5"))
			nday_6 =  nday_6 + Cdbl(rsEmployee("day_6"))
			nday_7 =  nday_7 + Cdbl(rsEmployee("day_7"))
			nday_8 =  nday_8 + Cdbl(rsEmployee("day_8"))
			nday_9 =  nday_9 + Cdbl(rsEmployee("day_9"))
			nday_10 =  nday_10 + Cdbl(rsEmployee("day_10"))
			nday_11 =  nday_11 + Cdbl(rsEmployee("day_11"))
			nday_12 =  nday_12 + Cdbl(rsEmployee("day_12"))
			nday_13 =  nday_13 + Cdbl(rsEmployee("day_13"))
			nday_14 =  nday_14 + Cdbl(rsEmployee("day_14"))
			nday_15 =  nday_15 + Cdbl(rsEmployee("day_15"))
			nday_16 =  nday_16 + Cdbl(rsEmployee("day_16"))
			nday_17 =  nday_17 + Cdbl(rsEmployee("day_17"))
			nday_18 =  nday_18 + Cdbl(rsEmployee("day_18"))
			nday_19 =  nday_19 + Cdbl(rsEmployee("day_19"))
			nday_20 =  nday_20 + Cdbl(rsEmployee("day_20"))
			nday_21 =  nday_21 + Cdbl(rsEmployee("day_21"))
			nday_22 =  nday_22 + Cdbl(rsEmployee("day_22"))
			nday_23 =  nday_23 + Cdbl(rsEmployee("day_23"))
			nday_24 =  nday_24 + Cdbl(rsEmployee("day_24"))
			nday_25 =  nday_25 + Cdbl(rsEmployee("day_25"))
			nday_26 =  nday_26 + Cdbl(rsEmployee("day_26"))
			nday_27 =  nday_27 + Cdbl(rsEmployee("day_27"))
			nday_28 =  nday_28 + Cdbl(rsEmployee("day_28"))
			nday_29 =  nday_29 + Cdbl(rsEmployee("day_29"))
			nday_30 =  nday_30 + Cdbl(rsEmployee("day_30"))
			nday_31 =  nday_31 + Cdbl(rsEmployee("day_31"))
			nTOTAL =  nTOTAL + Cdbl(rsEmployee("TOTAL"))

			rsEmployee.MoveNext
		Wend
rsEmployee.Close
set rsEmployee = Nothing
%>
	<tr>
		<td colspan="5" align="center"><strong>TOTAL</strong></td>
		<td align="right"><%=nday_1%></td>
		<td align="right"><%=nday_2%></td>
		<td align="right"><%=nday_3%></td>
		<td align="right"><%=nday_4%></td>
		<td align="right"><%=nday_5%></td>
