							"                    18 OrderData," & _
							"                    'Weighbridge' Module," & _
							"                    'Weighbridge Ticket' SubModule," & _
							"                    'NULL' detail" & _
							"               FROM (SELECT FCCODE FCBA, TANGGAL, 0 Hitung" & _
							"                       FROM (SELECT   TO_DATE ('" & v_FirstDate & "', 'MM/DD/YYYY')" & _
							"                                    + ROWNUM" & _
							" -1" & _
							"                                       TANGGAL" & _
							"                               FROM ALL_OBJECTS" & _
							"                              WHERE ROWNUM <=" & _
							"                                         TO_DATE ('" & v_LastDate & "', 'MM/DD/YYYY')" & _
							"                                       - TO_DATE ('" & v_FirstDate & "', 'MM/DD/YYYY')" & _
							"                                       + 1)," & _
							"                            BUSINESSUNIT" & _
