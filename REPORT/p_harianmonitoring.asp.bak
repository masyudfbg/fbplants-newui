                            "						WHERE module='Nursery' and submodule='Culling' and  detail='NULL' and to_number(to_char(fddate,'MMYYYY'))=" & v_txtMonth  & v_txtYear & ")" & _
							
							"              WHERE     fcba = '" & Session("FCBA") & "'" & _
