					" , '" & EMPLOYEECODE & "'" & _
					" , " & " to_date('" & fddate & "','mm/dd/yyyy')" & _
					" , '" & TIME & "'" & _
					" , '" & JOB & "'" & _
					" , '" & locationtype & "'" & _
					" , '" & LOCATION  & "'" & _
					" , '" & chargeunit & "'" & _
					" , '" & chargejob & "'" & _
					" , '" & chargetype & "'" & _
					" , '" & chargecode  & "'" & _				
					" , '" & HOURS & "'" & _
					" , '" & UNIT & "'" & _
					" , '0'" & _
					" , '" & OUTPUT & "'" & _				
					" , '" & Trim(reference) & "'" & _
					" , '" & REMARKS & "'" & _
					" , '" & Session("CodeName") & "'" & _
					" , '" & Session("CodeName") & "'" & _
					" , '" & Request.ServerVariables("REMOTE_ADDR") &"'" & _
					" , '" & Session("fcBA") & "'" & _
					" , sysdate" & _
					" , To_Char(sysdate,'HH24:MI')" & _
					" )"
					
			'response.Write(q)
			response.Flush()
			connStr.execute(q)
		End If
	Else
		Call DeleteDataWorkshop
		Call InsertDataWorkshop
	end if
End Sub
		
Cek_IsAccClosing = IsAccClosing(fcba, fddate)
if 	Cek_IsAccClosing = "FALSE" then  
if Request("txtJenis")="New" or Request("txtJenis")= "Delete" or Request("txtJenis")="Edit" Then
	if Request("txtJenis")= "Delete" then
		Cek_IsDailyClosing = IsDailyClosing(Session("FCBA"), fddate)
