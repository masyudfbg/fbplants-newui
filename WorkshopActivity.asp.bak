						else
							Dim val_Charge : val_Charge = 0
							val_Charge = CheckCharge(chargetype, chargecode, chargejob, businessunit, fdDate, sourcetype)
							If val_Charge <> "Success" Then
								Err.Number = 1001
								Err.Description = val_Charge
							Else
								If len(trim(""&unit)) = 0 Then
									err.number = 1001
									err.description = "Anda Harus Mengisi Kolom Unit! "
								Else
							q	=	" Insert into WORKSHOPACTIVITY (" & _
									" WORKSHOPCODE" & _
									" , PID" & _
									" , EMPLOYEECODE" & _
									" , WORKSHOPDATE" & _
									" , TIME" & _
									" , JOB" & _
									" , LOCATIONTYPE" & _
									" , LOCATIONCODE" & _
									" , CHARGEUNIT" & _
									" , CHARGEJOB" & _
									" , CHARGETYPE" & _
									" , CHARGECODE" & _
									" , HOURS" & _
									" , UNIT" & _
									" , AMOUNT" & _
									" , OUTPUT" & _
									" , REF" & _
									" , REMARKS" & _
									" , FCENTRY" & _
									" , FCEDIT" & _
									" , FCIP" & _
									" , FCBA" & _
									" , LASTUPDATE" & _
									" , LASTTIME" & _
									" ) " & _
									" values (" & _
									" '" & FCCODE & "'" & _
									" , LOWER(regexp_replace(rawtohex(sys_guid()), '([A-F0-9]{8})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{4})([A-F0-9]{12})','\1-\2-\3-\4-\5'))" & _
									" , '" & EMPLOYEECODE & "'" & _
									" , " & " to_date('" & fddate & "','mm/dd/yyyy')" & _
									" , '" & TIME & "'" & _
									" , '" & JOB & "'" & _
									" , '" & locationtype & "'" & _
									" , '" & LOCATION  & "'" & _
									" , '" & chargeunit & "'" & _
									" , '" & chargejob & "'" & _
									" , '" & chargetype & "'" & _
									" , '" & chargecode  & "'" & _				
									" , '" & HOURS & "'" & _
									" , '" & UNIT & "'" & _
									" , '0'" & _
									" , '" & OUTPUT & "'" & _				
									" , '" & Trim(reference) & "'" & _
									" , '" & REMARKS & "'" & _
									" , '" & Session("CodeName") & "'" & _
									" , '" & Session("CodeName") & "'" & _
									" , '" & Request.ServerVariables("REMOTE_ADDR") &"'" & _
									" , '" & Session("fcBA") & "'" & _
									" , sysdate" & _
									" , To_Char(sysdate,'HH24:MI')" & _
									" )"
									
							'response.Write(q)
							response.Flush()
							connStr.execute(q)
							End If
						End If
					End If
				End If
				Else
					err.description = "Kode Karyawan tidak termasuk dalam Master"
					err.number = 10001
				End If
			Else
				err.description = "Masukkan Kode Karyawan di kolom Mechanic"
				err.number = 10001
			End If
			
		else
			err.number = 1001
			err.description = "Tanggal """ & fddate & """, sudah di closing, sehingga tidak bisa melakukan insert/update/delete data, Silahkan konsultasikan dengan administrator anda"
		End If
		cmdView	= "True"
	elseif Request("txtJenis")="Edit" and Request("Add")="Update" then	
		Cek_IsDailyClosing = IsDailyClosing(Session("FCBA"), fddate)
		If Cek_IsDailyClosing = "FALSE" then
			' Call UpdateDataVehicle
			qLineMax = " select count(1) fccode, fcba from intraco_tab where status='TRUE' and fccode = '"& JOB &"' group by fcba"			
			' response.write qLineMax
			set rsqLineMax = Server.CreateObject("ADODB.Recordset")
			rsqLineMax.Open qLineMax, connstr
			if not rsqLineMax.eof then
				code = cdbl(to_nol(rsqLineMax("fccode")))
				'businessunit = rsqLineMax("fcba")
				businessunit = chargeunit
			end if 
			if code = 0 then
				if ( len(trim(""&chargetype)) <> 0 or len(trim(""&chargecode)) <> 0 or len(trim(""&chargejob)) <> 0 or len(trim(""&chargeunit)) <> 0 ) then
					err.number = 1001
					err.description = "Anda tidak harus input Charge Job, Charge Type dan Charge Code! "
				else
					q	=	" Update WORKSHOPACTIVITY set" & _
							" HOURS = '" & HOURS & "'" & _
							" , UNIT = '" & UNIT & "'" & _
							" , OUTPUT = '" & OUTPUT & "'" & _
							" , remarks = '" & remarks & "'" & _
							" , JOB = '" & JOB & "'" & _
							" , LOCATIONTYPE = '" & LOCATIONTYPE & "'" & _
							" , LOCATIONCODE = '" & LOCATION & "'" & _
							" , chargeunit = '" & chargeunit & "'" & _
							" , chargejob = '" & chargejob & "'" & _
							" , chargetype = '" & chargetype & "'" & _
							" , chargecode = '" & chargecode & "'" & _
							" , EMPLOYEECODE = '" & EMPLOYEECODE & "'" & _
							" , LASTUPDATE = sysdate " & _
							" , LASTTIME = To_Char(sysdate,'HH24:MI') " & _
							" where PID = '" & PID & "'" & _
							" and fcBA = '" & Session("fcBA") & "'"
							
					'response.Write(q)
					connStr.execute(q)
				End If
			Else
				if ( len(trim(""&chargetype)) = 0 or len(trim(""&chargecode)) = 0 or len(trim(""&chargejob)) = 0 or len(trim(""&chargeunit)) = 0 ) then
					err.number = 1001
					err.description = "Anda harus input Charge Unit, Charge Job, Charge Type dan Charge Code! "
				else
					Dim val_Charges : val_Charges = 0
					val_Charges = CheckCharge(chargetype, chargecode, chargejob, businessunit, fdDate, sourcetype)
					If val_Charges <> "Success" Then
						Err.Number = 1001
						Err.Description = val_Charges
					Else
					q	=	" Update WORKSHOPACTIVITY set" & _
							" HOURS = '" & HOURS & "'" & _
							" , UNIT = '" & UNIT & "'" & _
							" , OUTPUT = '" & OUTPUT & "'" & _
							" , remarks = '" & remarks & "'" & _
							" , JOB = '" & JOB & "'" & _
							" , LOCATIONTYPE = '" & LOCATIONTYPE & "'" & _
							" , LOCATIONCODE = '" & LOCATION & "'" & _
							" , chargeunit = '" & chargeunit & "'" & _
							" , chargejob = '" & chargejob & "'" & _
							" , chargetype = '" & chargetype & "'" & _
							" , chargecode = '" & chargecode & "'" & _
							" , EMPLOYEECODE = '" & EMPLOYEECODE & "'" & _
							" , LASTUPDATE = sysdate " & _
							" , LASTTIME = To_Char(sysdate,'HH24:MI') " & _
							" where PID = '" & PID & "'" & _
							" and fcBA = '" & Session("fcBA") & "'"
							
					' response.Write(q)
					connStr.execute(q)
				End If
			End If
			End If
			' connStr.execute("commit")
			
		else
			err.number = 1001
			err.description = "Tanggal """ & fddate & """, sudah di closing, sehingga tidak bisa melakukan insert/update/delete data, Silahkan konsultasikan dengan administrator anda"
		End If
		cmdView	= "True"
    else
        cmdView	= "True"
	end if								 
	'Response.Write "sql " & q
else
    cmdView	= request("cmdView")
End if
else
    err.number = 1001
	err.description = "Accounting Period  " & ACCOUNTINGPERIOD & "/" & ACCOUNTINGYEAR & "  LOCKED !!!"
	cmdView	= request("cmdView")
End if 

Dim txtModule,txtTable,txtSearch,txtField,i,q,nCountofField,NO,txtJenis
if Request("fddate")<>"" then
   fddate   =Request("fddate")
else
   fddate   =textDate(date)
end if

txtTable =Request("txtTable")
txtModule=Request("txtModule")
txtSearch=Request("txtSearch")
txtField =Request("txtField")
txtJenis = request("txtJenis")
if err.number <> 0 then
   response.Write  "<div class = ""error"">" & err.description & "</div>"
End if

Dim val_IsTrue : val_IsTrue = "N"
Dim oRecordSet, oSQLQuery
oSQLQuery = " select 'Y' istrue" & _
            " from periodcontrol" & _
	        " where fcba = '" & Session("fcBA") & "'" & _
	        "       and to_date ('" & fdDate & "', 'mm/dd/yyyy') >= currentdate" & _
	        "       and to_date ('" & fdDate & "', 'mm/dd/yyyy') <= last_day(add_months(currentdate, 1))" & _
	        "       and upper(system) = upper('Workshop')"
			
set oRecordSet = server.CreateObject("Adodb.recordset")
oRecordSet.Open oSQLQuery, connstr
If Not oRecordSet.Eof then
	val_IsTrue = oRecordSet("istrue")
Else
	val_IsTrue = "N"
End if
'response.Write oSQLQuery
oRecordSet.Close
Set oRecordSet = Nothing
%>
 <!-------------ISI Payment Form------------->
 <form name="frmEntry" method="post" action="WorkshopActivity.asp">
	<table class="data">
		<tr><td align="left">Date</td>
		<td align="left"><input class="datepicker" type="text" maxlength="10" name="fdDate" size="10" value="<%=fdDate%>"><font color="#FF0000">&nbsp;*</font>
		</td></tr>
		<tr><td  align="left">Workshop Code</td>
		<td>
        <select name="FCCODE">
	    <%cmdCallCombo "WORKSHOP",FCCODE,"",""%>
        </select>
		<font color="#FF0000">&nbsp;*</font>
		</td>
		</tr>
		<tr><td colspan="2"  align="left">
		<input Type="Hidden" Value="True" Name="cmdView">
		<input Type="Hidden" Value="<%=request("txtTable")%>" Name="txtTable">
		<input Type="Hidden" Value="<%=request("txtModule")%>" Name="txtModule">
		<input Type="Submit"  name="Add" value="Select">&nbsp;&nbsp;
		<a href="PrintWorkshop.Asp?txtTable=<%=request("txtTable")%>&txtModule=<%=request("txtModule")%>&fdDate=<%=fdDate%>&WorkshopCode=<%=fcCode%>" 
		title="Print Data" target="_blank"><img src="IMAGES/Print.gif" border="0"></a>
		<!-- HADIR -->
		<%
		dim dataModule,dataSubmodule,dataDetail
		dataModule 		= "Workshop"
		dataSubmodule 	= "Workshop Activity"
		dataDetail 		= "NULL"
		%>
		<a class="jqplot-image-button" style="" href="ajax/hadirAjax.asp?dataModule=<%=dataModule%>&dataSubmodule=<%=dataSubmodule%>&dataDetail=<%=dataDetail%>"><i class="fa fa-check-square-o"></i>&nbsp;Hadir</a>
		<!-- END:HADIR -->
		</td>
		</tr> 
    </table>  
 </form>
<%
if cmdView = "True" and len(trim(FCCODE)) > 0 Then
	Dim rsWS,intRecordsPerPage,cColor
	set rsWS = server.CreateObject("Adodb.recordset")
	
	q	=	"select" & _
			"  WORKSHOPCODE" & _
			" , EMPLOYEECODE" & _
			" , WORKSHOPDATE" & _
			" , TIME" & _
			" , JOB" & _
			" , LOCATIONTYPE" & _
			" , LOCATIONCODE" & _
			" , CHARGEUNIT" & _
			" , CHARGEJOB" & _
			" , CHARGETYPE" & _
			" , CHARGECODE" & _
			" , HOURS" & _
			" , UNIT" & _
			" , AMOUNT" & _
			" , OUTPUT" & _
			" , TRIM(REF) REF" & _
			" , REMARKS" & _
			" , FCENTRY" & _
			" , FCEDIT" & _
			" , FCIP" & _
			" , FCBA" & _
			" , PID" & _
			" from WorkshopActivity where" & _
			" fcBA = '" & session("fcBA") & "'"
			
If Len(Trim(fdDate)) > 0 Then
	q	=	q & " and WORKSHOPDATE = to_date('" & fdDate & "', 'MM/DD/YYYY')"
End If

If Len(Trim(fcCode)) > 0 Then
	q	=	q & " and WorkshopCode ='" & fcCode & "'"
End If

	'response.Write q	
	Set rsWS = Server.CreateObject("ADODB.Recordset")
	rsWS.CursorType = 3
	rsWS.CursorLocation = 3
	rsWS.Open q, connstr
%>
<%
        tempStringHours = "select PARAMETER_COMB_UOM_api.GetUom_Hours('WORKSHOPACTIVITY',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'" & Session("fcBA") & "') HoursName from dual"
		set rsStringHours = connStr.execute(tempStringHours)
		
		HoursDescription = rsStringHours("HoursName")
		rsStringHours.close()
		rsStringHours=null
		
		
		tempStringUnit = "select PARAMETER_COMB_UOM_api.GetUom_Unit('WORKSHOPACTIVITY',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'" & Session("fcBA") & "') UnitName from dual"
		set rsStringUnit = connStr.execute(tempStringUnit)
		
		UnitDescription = rsStringUnit("UnitName")
		rsStringUnit.close()
		rsStringUnit=null
		
		
		tempStringOutput = "select PARAMETER_COMB_UOM_api.GetUom_Output('WORKSHOPACTIVITY',NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,'" & Session("fcBA") & "') OutputName from dual"
		set rsStringOutput = connStr.execute(tempStringOutput)
		
		OutputDescription = rsStringOutput("OutputName")
		rsStringOutput.close()
		rsStringOutput=null

%>
   <form action="WorkshopActivity.Asp" method="post" name="eForm">
   <table class="data" cellpadding="0" cellspacing="0">
		<!--Yang tidak bisa di edit adalah PK Table-->
			<tr>
				<td align="left">
					<font face="Verdana" size="1">Mechanic</font>
				</td>
				<td align="left">
					<input id="empcode" type="text" size="15" name="EMPLOYEECODE" value="<%=EMPLOYEECODE%>" onchange="GetEmpName(this.value);" >
					<span id="nonscript_empcd" style="color:black;">&nbsp;*&nbsp;
					<a id ="nonscriptempcd_a" href="javascript:launchwin('PrintData.Asp?txtModule=Data Master&txtTable=Employee&txtSearch=<%=txtSearch%>&txtField=<%=txtField%>&Mode=Print','newwindow','width='+(700)+',height='+(505)+',screenX=0,screenY=0,directories=0,fullscreen=0,location=0,menubar=0,scrollbars=1,status=0,toolbar=1')">
					<font face="Verdana"   size="1">Employee</font></a></span>
				</td>	
			</tr>
			<tr>
				<td align="Left">Time (HH:MM-HH:MM)
				</td>
				<td align="Left"><input type="text" size="15" name="TIME" value="<%=TIME%>" placeholder="hh:mm-hh:mm" class="timepicker" autocomplete="off">
				</td>
			</tr>
		    <tr>
		    	<td align="Left">Job Code</td>
		    	<td align="Left"><input type="text" size="15" id="jobcode" onchange="javascript:getTragettype();" name="JOB" value="<%=JOB%>">&nbsp;<font color="#FF0000">*</font>&nbsp;<a href="javascript:launchwin('PrintData.Asp?txtModule=Data Master&txtTable=Job&txtSearch=<%=txtSearch%>&txtField=<%=txtField%>&Mode=Print','newwindow','width='+(700)+',height='+(505)+',screenX=0,screenY=0,directories=0,fullscreen=0,location=0,menubar=0,scrollbars=1,status=0,toolbar=1')"><font face="Verdana"   size="1">Activity</font></a>
		    	</td>
		    </tr>
		     <tr>
		     	<td align="Left">Target Type</td>
		     	<td align="Left"><input type="text" size="15" id="locationtype" name="locationtype" value="<%=locationtype%>" style="background-color: #eee;" readonly>&nbsp;<font color="#FF0000">*</font>&nbsp;<a href="javascript:launchwin('PrintData.Asp?txtModule=Data Master&txtTable=LocationType&txtSearch=<%=txtSearch%>&txtField=<%=txtField%>&Mode=Print','newwindow','width='+(700)+',height='+(505)+',screenX=0,screenY=0,directories=0,fullscreen=0,location=0,menubar=0,scrollbars=1,status=0,toolbar=1')"><font face="Verdana"   size="1">Location Type</font></a></td>
		     </tr>
		     <tr><td align="Left">Target Code</td><td align="Left"><input type="text" size="15" name="LOCATION" value="<%=LOCATION%>"></td></tr>
		     <!-- Add Charge Job, Charge Type, Charge Code -->
		     <tr>
                <td align="left">
                    Charge Unit
                </td>
                <td align="left">
                   <select  name="chargeunit"  >
							<option value=""></option>
							<%
							qlov = 	 " select fccode,fcname " & _
									 "	from businessunit " & _
									 "	where fccompanycode = businessunit_api.get_CompanyCode('" & session("fcba") & "') " & _
									 "	and businessunit_api.Isactive(fccode)='TRUE' " & _ 
									 "  and fccode <> '" & session("fcba") & "'"
									 
							Set rslov = Server.CreateObject("ADODB.Recordset")
							rslov.Open qlov, connstr 
							if Not rslov.eof then
								While Not rslov.EOF
							%>
							<option value="<%=rslov("fccode")%>" <%if chargeunit = rslov("fccode") then%>selected<%end if%>><%=rslov("fccode")%> </option>
							<%
									rslov.MoveNext
								Wend
							end if
							%>
					</select>
                </td>
            </tr>
			 <tr>
                <td align="left">
                    Charge Job
                </td>
                <td align="left">
                    <input type="text" size="15" name="chargejob" value="<%=chargejob%>">&nbsp;<font color="#FF0000">*</font>
                    <a href="javascript:launchwin('PrintData.Asp?txtModule=Data Master&txtTable=Job&txtSearch=<%=txtSearch%>&txtField=<%=txtField%>&Mode=Print','newwindow','width='+(700)+',height='+(505)+',screenX=0,screenY=0,directories=0,fullscreen=0,location=0,menubar=0,scrollbars=1,status=0,toolbar=1')">
					<font face="Verdana" size="1">Activity</font>
                </td>
            </tr>
            <tr>
                <td align="left">
                    Charge Type
                </td>
                <td align="left">
                    <input type="text" size="15" name="chargetype" value="<%=chargetype%>">&nbsp;<font
                        color="#FF0000">* <a href="javascript:launchwin('PrintData.Asp?txtModule=Data Master&txtTable=LocationType&txtSearch=<%=txtSearch%>&txtField=<%=txtField%>&Mode=Print','newwindow','width='+(700)+',height='+(505)+',screenX=0,screenY=0,directories=0,fullscreen=0,location=0,menubar=0,scrollbars=1,status=0,toolbar=1')">
                            <font face="Verdana" size="1">Location Type</font></a>
                </td>
            </tr>
            <tr>
                <td align="left">
                    Charge Code
                </td>
                <td align="left">
                    <input type="text" size="15" name="chargecode" value="<%=chargecode%>">&nbsp;<font
                        color="#FF0000">*</font>
                </td>
            </tr>
		<tr><td align="Left">Hours</td><td align="Left"><input type="text" size="15" name="HOURS" value="<%=HOURS%>"><span class="satuan_item" id="hours">&nbsp;<%=HoursDescription%></span></td></tr>
		<tr><td align="Left">Hours/ Km/ Hm/ Ha</td><td align="Left"><input type="text" size="15" name="UNIT" value="<%=UNIT%>"><span class="satuan_item" id="unit">&nbsp;<%=UnitDescription%></span></td></tr>
		<tr><td align="Left">Output</td><td align="Left"><input type="text" size="15" name="OUTPUT" value="<%=OUTPUT%>"><span class="satuan_item" id="output">&nbsp;<%=OutputDescription%></span></td></tr>
		<tr><td align="Left">Reference</td><td align="Left"><input type="text" size="50" name="Reference" value="<%=Reference%>" <%IF txtJenis="Edit" Then%> readonly="True" style="background:#999999" <%End If%>></td></tr>
		<tr><td align="Left">Remarks</td><td align="Left"><input type="text" size="50" name="REMARKS" value="<%=REMARKS%>"></td></tr>
	    <TR><td colspan="2" align="Left">
	      <input type="hidden" name="fcCode" value="<%=fcCode%>">
		  <input type="hidden" name="fdDate" value="<%=fdDate%>">
		  <input type="hidden" name="PID" value="<%=PID%>">
		  <input Type="Hidden" Value="<%=request("txtTable")%>" Name="txtTable">
		  <input Type="Hidden" Value="<%=request("txtModule")%>" Name="txtModule">
		  <!-- Validasi Period Control In Here -->
		  <%IF Request("txtJenis")="Edit" then%>
		       <input type="hidden" name="txtJenis" value="Edit">
		       <input Type="Submit" name="Add" value="Update">
		  <%Else%>
		       <input type="hidden" name="txtJenis" value="New">
		       <input Type="Submit" name="Add" value="Add">
		  <%End if%>
		  <!-- End -->
		  <input Type="Reset"  name="Reset" value="Reset">
		  <input Type="Button" value="Back" name="B2" OnClick="javascript:history.back(1)"></td>
	  </tr>
   </table>

   <table class="data">
  	<BR>
	<tr bgcolor="#0C5B24" style="color:#FFFFFF;" style="color:#FFFFFF;" >
	<TD align="left">NO</TD>
	<TD colspan="2">&nbsp;</TD>
	<TD align="left">WORKSHOP CODE</TD>
	<TD align="left">EMPLOYEE CODE</TD>	
	<TD align="left">DATE</TD>	
	<TD align="left">TIME</TD>
	<TD align="left">JOB</TD>		
	<TD align="left">LOC TYPE</TD>	
	<TD align="left">LOC CODE</TD>
	<TD align="left">CHARGE UNIT</TD>	
	<TD align="left">CHARGE JOB</TD>	
	<TD align="left">CHARGE TYPE</TD>	
	<TD align="left">CHARGE CODE</TD>	
	<TD align="left">HOURS</TD>
	<TD align="left">UNIT</TD>
	<TD align="left">AMOUNT</TD>		
	<TD align="left">OUTPUT</TD>	
	<TD align="left">REFERENCES</TD>	
	<TD align="left">REMARKS</TD>	
	</tr>

   <%
   if Not rsWS.eof then
      nCountofField=rsWS.fields.count-1
	  no=1
	  While Not rsWS.EOF
		  if no  mod 2 = 1 then
             cColor = "#EEEEEE"
		  else
		     cColor = "#E5E5E5"
		  end if%>
		  <tr bgcolor="<%=cColor%>">
		  <td align="left" valign="top"><%=NO%></td>
			<!-- Validasi Period Control In Here -->
				<td valign="middle" width="30">
					<a href="WorkshopActivity.Asp?PID=<%=rsWS("PID")%>&EMPLOYEECODE=<%=rsWS("EMPLOYEECODE")%>&fcCode=<%=rsWS("WORKSHOPCODE")%>&fdDate=<%=rsWS("WORKSHOPDATE")%>&time=<%=rsWS("TIME")%>&JOB=<%=rsWS("JOB")%>&LOCATIONTYPE=<%=rsWS("LOCATIONTYPE")%>&LOCATION=<%=rsWS("LOCATIONcode")%>&HOURS=<%=rsWS("HOURS")%>&UNIT=<%=rsWS("UNIT")%>&OUTPUT=<%=rsWS("OUTPUT")%>&reference=<%=rsWS("ref")%>&remarks=<%=rsWS("remarks")%>&chargeunit=<%=rsWS("chargeunit")%>&chargejob=<%=rsWS("chargejob")%>&chargetype=<%=rsWS("chargetype")%>&ChargeCode=<%=rsWS("ChargeCode")%>&txtJenis=Edit"><img src="IMAGES/edit.gif" alt="Edit Data : <%=rsWS(1)%>" border="0"></a>
				</td>
				<td>
					<a href="WorkshopActivity.Asp?PID=<%=rsWS("PID")%>&EMPLOYEECODE=<%=rsWS("EMPLOYEECODE")%>&fcCode=<%=rsWS("WORKSHOPCODE")%>&fdDate=<%=rsWS("WORKSHOPDATE")%>&time=<%=rsWS("TIME")%>&JOB=<%=rsWS("JOB")%>&LOCATIONTYPE=<%=rsWS("LOCATIONTYPE")%>&LOCATION=<%=rsWS("LOCATIONcode")%>&reference=<%=rsWS("ref")%>&txtJenis=Delete" onClick="return confirm('Are you sure to delete');"><img src="IMAGES/delete.gif" alt="Delete Data : <%=rsWS(1)%>" border="0"></a>
				</td>
			<!-- End Validasi Period Control In Here -->
		    <%for i = 0 to nCountofField-5%>
			    <td align="left" title="<%=rsWS(i).Name%>" valign="top"><%=rsWS(i)%></td>
		    <%next%>
		  </tr>
		  <%
		  rsWS.MoveNext
		  intRecordsPerPage = intRecordsPerPage - 1
		  no=no+1
	  Wend
   end if 
   rsWS.Close
   set rsWS = Nothing%>
   </div>
   </TABLE>
   </form>
<%End if%>  
 
  <!-------------akhir------------->
</div></div>
  <!--#include file="bottom.jsp"-->
<script>
	$(function() {
	  $("input:text").keyup(function() {
			$(this).val($(this).val().replace(/|,|'|"|&|\r\n|\r|\n/g, ""));
	  });
	});

	$.mask.definitions['H'] = "[0-2]";
	$.mask.definitions['h'] = "[0-9]";
	$.mask.definitions['M'] = "[0-5]";
	$.mask.definitions['m'] = "[0-9]";
	$.mask.definitions['P'] = "[AaPp]";
	$.mask.definitions['p'] = "[Mm]";

	$(".timepicker").mask("Hh:Mm-Hh:Mm");

	getTragettype();
</script>
</body>
</html>
