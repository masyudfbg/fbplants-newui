<table width="100%">
<tr>
 <td width="22%" valign="top">
 <!--#include file="menu.asp"-->
 </td>
 <td width="78%" valign="top">
 <%
 '-------------awal-----------------------
 Dim FCCODE,RETENTION,QTY,RATE,AGREEMENTLINENO,WIPDATE
 Dim FDDATE, JOB
 Dim LOCATIONTYPE
 Dim LOCATIONCode,UNIT, OUTPUT, REMARKS, FCENTRY, FCEDIT, FCIP, FCBA
 Dim cmdView
Dim CheckQTY, rsCheckQTY, varSelisih, varTotalAgreement
Dim varError
Dim getAgreementCode, rsAgreementCode
		
 if Request("txtJenis")="New" or Request("txtJenis")= "Delete" or Request("txtJenis")="Edit" Then
	WIPDATE =request("fdDate")
	fcCode =request("fcCode")
	QTY=request("QTY")
	AGREEMENTLINENO=request("AGREEMENTLINENO")
	WIPDATE=REQUEST("WIPDATE")
	REMARKS=request("REMARKS")
	if Request("txtJenis")= "Delete" then
       q="Delete from WORKINPROGRESS  where  to_char(wiPDATE,'"& "mm/dd/yyyy" & "')='" & wipdate & _
	   "' AND AGREEMENTCODE='" & FCCODE & "' And AGREEMENTLINENO='" & AGREEMENTLINENO & "'" & _
		 " and fcBA='" & Session("fcBA") & "'"
   	   ConnStr.execute(q)
       cmdView	= "True"
	elseif Request("txtJenis")="New" then
	
		'Validasi Qty
		CheckQTY = "SELECT   fcba, agreementcode, lineno, SUM (totalagreement) totalagreement," & _
					" SUM (totalwip) totalwip,   SUM (totalagreement) - SUM (totalwip) selisih" & _
					" FROM ((SELECT   fcba, agreementcode, lineno, SUM (qty) totalagreement, 0 totalwip" & _
					" FROM agreementdetail GROUP BY fcba, agreementcode, lineno) UNION (" &_
					" SELECT   fcba, agreementcode, agreementlineno lineno, 0 totalagreement, SUM (qty) totalwip" & _
					" FROM workinprogress GROUP BY fcba, agreementcode, agreementlineno)) dataall" & _
					" WHERE fcba = '" & Session("fcBA") & "' AND agreementcode = '" & FCCODE & "'" & _
					" AND lineno = '" & AGREEMENTLINENO & "' GROUP BY fcba, agreementcode, lineno"
		
		Set rsCheckQTY = Server.CreateObject("ADODB.Recordset")
		rsCheckQTY.CursorType = 3
		rsCheckQTY.CursorLocation = 3 
		rsCheckQTY.Open CheckQTY, connstr
		
		if Not rsCheckQTY.Eof then
		   varSelisih = cdbl(rsCheckQTY("selisih"))
		Else
		   varSelisih = 0
		End if

		if (varSelisih  - cdbl(QTY) ) >=  0 then
	  q="Insert into WORKINPROGRESS (AGREEMENTCODE, WIPDATE, AGREEMENTLINENO, QTY, POSTEDFLAG, PROGRESSPAYMENTDATE, " & _
	    "FCENTRY, FCEDIT, FCIP, FCBA) " & _
		"values ('" & FCCODE & "', to_date('" & WIPDATE & "','mm/dd/yyyy') " & _
		"," & AGREEMENTLINENO  & ","  &  QTY & "," &  0 & ",sysdate," & _
		"'" & Session("CodeName") & "','" & Session("CodeName") & "','" & _
		Request.ServerVariables("REMOTE_ADDR") &"','" & Session("fcBA") & "')"
	    connStr.execute(q)
        cmdView	= "True"
		varError = ""
	    else
			varError = "Total Quantity yang anda masukan melebihi dari kontrak yang disepakati "  
        end if
		
		rsCheckQTY.Close
		Set rsCheckQTY = Nothing
	elseif Request("txtJenis")="Edit" and Request("Add")="Update" then
	
       q="Delete from WORKINPROGRESS  where  to_char(wiPDATE,'"& "mm/dd/yyyy" & "')='" & wipdate & _
	   "' AND AGREEMENTCODE='" & FCCODE & "' And AGREEMENTLINENO='" & AGREEMENTLINENO & "'" & _
		 " and fcBA='" & Session("fcBA") & "'"
   	   ConnStr.execute(q)
	   
		'Validasi Qty
		CheckQTY = "SELECT   fcba, agreementcode, lineno, SUM (totalagreement) totalagreement," & _
					" SUM (totalwip) totalwip,   SUM (totalagreement) - SUM (totalwip) selisih" & _
					" FROM ((SELECT   fcba, agreementcode, lineno, SUM (qty) totalagreement, 0 totalwip" & _
					" FROM agreementdetail GROUP BY fcba, agreementcode, lineno) UNION (" &_
					" SELECT   fcba, agreementcode, agreementlineno lineno, 0 totalagreement, SUM (qty) totalwip" & _
					" FROM workinprogress GROUP BY fcba, agreementcode, agreementlineno)) dataall" & _
					" WHERE fcba = '" & Session("fcBA") & "' AND agreementcode = '" & FCCODE & "'" & _
					" AND lineno = '" & AGREEMENTLINENO & "' GROUP BY fcba, agreementcode, lineno"
		
		Set rsCheckQTY = Server.CreateObject("ADODB.Recordset")
		rsCheckQTY.CursorType = 3
		rsCheckQTY.CursorLocation = 3 
		rsCheckQTY.Open CheckQTY, connstr
		
		if Not rsCheckQTY.Eof then
		   varSelisih = cdbl(rsCheckQTY("selisih"))
		Else
		   varSelisih = 0
		End if

		if (varSelisih  - cdbl(QTY) ) >=  0 then
	  q="Insert into WORKINPROGRESS (AGREEMENTCODE, WIPDATE, AGREEMENTLINENO, QTY, POSTEDFLAG, PROGRESSPAYMENTDATE, " & _
	    "FCENTRY, FCEDIT, FCIP, FCBA) " & _
		"values ('" & FCCODE & "', to_date('" & WIPDATE & "','mm/dd/yyyy') " & _
		"," & AGREEMENTLINENO  & ","  &  QTY & "," &  0 & ",sysdate," & _
		"'" & Session("CodeName") & "','" & Session("CodeName") & "','" & _
		Request.ServerVariables("REMOTE_ADDR") &"','" & Session("fcBA") & "')"
	    connStr.execute(q)
        cmdView	= "True"
		varError = ""
	    else
			varError = "Total Quantity yang anda masukan melebihi dari kontrak yang disepakati "  
        end if
		
		rsCheckQTY.Close
		Set rsCheckQTY = Nothing
		'sValidasi Qty
		' CheckQTY = "SELECT   fcba, agreementcode, lineno, SUM (totalagreement) totalagreement," & _
					' " SUM (totalwip) totalwip,   SUM (totalagreement) - SUM (totalwip) selisih" & _
					' " FROM ((SELECT   fcba, agreementcode, lineno, SUM (qty) totalagreement, 0 totalwip" & _
					' " FROM agreementdetail GROUP BY fcba, agreementcode, lineno) UNION (" &_
					' " SELECT   fcba, agreementcode, agreementlineno lineno, 0 totalagreement, SUM (qty) totalwip" & _
					' " FROM workinprogress GROUP BY fcba, agreementcode, agreementlineno)) dataall" & _
					' " WHERE fcba = '" & Session("fcBA") & "' AND agreementcode = '" & FCCODE & "'" & _
					' " AND lineno = '" & AGREEMENTLINENO & "' GROUP BY fcba, agreementcode, lineno"
		
		' Set rsCheckQTY = Server.CreateObject("ADODB.Recordset")
		' rsCheckQTY.CursorType = 3
		' rsCheckQTY.CursorLocation = 3 
		' rsCheckQTY.Open CheckQTY, connstr
		
		' if Not rsCheckQTY.Eof then
		   ' varSelisih = cdbl(rsCheckQTY("selisih"))
		' Else
		   ' varSelisih = 0
		' End if
		
       ' q="Update WORKINPROGRESS set WIPDATE " & "= to_date('" & WIPDATE & "','mm/dd/yyyy') " & _
		' ",QTY='" & QTY  & "'" & _
        ' " where to_char(WIPDATE,'"& "mm/dd/yyyy" & "')='" & WIPDATE & _
		' "' AND  AGREEMENTCODE='" & FCCODE & "' And AGREEMENTLINENO='" & AGREEMENTLINENO & "'" & _
		 ' " and fcBA='" & Session("fcBA") & "'"
		
		

		
            ' if varSelisih + cdbl(QTY) >= 0 then 
				' connStr.execute(q)
		        ' connStr.execute("commit")			
				' varError = ""  
			' else
			    ' connStr.execute("rollback")
				' varError = "Total Quantity yang anda masukan melebihi dari kontrak yang disepakati "  
			' end if
        cmdView	= "True"
    else
        cmdView	= "True"
	end if								 
	'Response.Write "sql " & q
else
    cmdView	= request("cmdView")
End if
Dim txtModule,txtTable,txtSearch,txtField,i,q,nCountofField,NO,txtJenis
if Request("fddate")<>"" then
   fddate   =Request("fddate")
else
   fddate   =textDate(date)
end if

txtTable =Request("txtTable")
txtModule=Request("txtModule")
txtSearch=Request("txtSearch")
txtField =Request("txtField")
fcCode=request("fcCode")
txtJenis = request("txtJenis")

if err.number <> 0 then
   response.Write  "<font color=#FF0000 pointsize=9 face=Arial, Helvetica, sans-serif>" & "Error Number : " & err.number & " because : " & err.description & "</font>"
End if
 '-------------ISI Payment Form
 %>
 <form name="frmEntry" method="post" action="WIP.asp ">
	<font color=red><%=varError%></font>
	<table class="data" width="100%">
		<tr><td  align="left">Agreement Code</td>
		<td align="left">
		<select name= "fcCODE" >
		<%
			getAgreementCode = "Select Distinct(AGREEMENTCODE) AGREEMENTCODE from AGREEMENTDETAIL" & _
								" WHERE FCBA = '" & Session("fcBA") & "'"
			Set rsAgreementCode = Server.CreateObject("ADODB.Recordset")
			rsAgreementCode.CursorType = 3
			rsAgreementCode.CursorLocation = 3
			rsAgreementCode.Open getAgreementCode, connstr
			if not rsAgreementCode.eof then
		%>
			<option value="" Selected></option>
		<%
			Do While Not rsAgreementCode.eof
			if rsAgreementCode("AGREEMENTCODE") = FCCODE then%>
		   <option value="<%=rsAgreementCode("AGREEMENTCODE")%>" Selected><%=rsAgreementCode("AGREEMENTCODE")%></option> 
		<%Else%>
		   <option value="<%=rsAgreementCode("AGREEMENTCODE")%>"><%=rsAgreementCode("AGREEMENTCODE")%></option>  
		<%End if
		rsAgreementCode.movenext
	 loop
	End if
	rsAgreementCode.Close
	set rsAgreementCode = Nothing
		%>
		</select>
		<!--<input type="text" maxlength="15" name="fcCODE" size="15" value="<%=fcCODE%>">--></td>
		</tr>
		<tr><td colspan="2"  align="left">
		<input Type="Hidden" Value="True" Name="cmdView">
		<input Type="Hidden" Value="<%=request("txtTable")%>" Name="txtTable">
		<input Type="Hidden" Value="<%=request("txtModule")%>" Name="txtModule">
		<input Type="Submit" style="background-color: #298CF7; color: #F7C610;
		font-weight: bold; font-size: 8pt; font-family:Verdana" name="Add" value="Select">&nbsp;&nbsp;
		<a href="PrintWIP.asp?txtTable=<%=request("txtTable")%>&txtModule=<%=request("txtModule")%>&fcCode=<%=fcCode%>" 
		title="Print Data" target="_blank"><img src="IMAGES/Print.gif" border="0"></a>
		</td>
		</tr>
    </table>  
 </form>
<%
	if cmdView = "True" Then
		Dim rsWC,intRecordsPerPage,cColor
		set rsWC = server.CreateObject("Adodb.recordset")
		'Field Numeric Jangan di Sum karena ditampilkan mesti level detail
		'Field Date Mesti to_char(WIPDATE,'mm/dd/yyyy') as WIPDATE
		q = "select AGREEMENTCODE,to_char(WIPDATE,'mm/dd/yyyy') as WIPDATE, AGREEMENTLINENO, QTY,FCENTRY, FCEDIT, FCIP, FCBA " & _
		" from WORKINPROGRESS  where " & _
		" AGREEMENTCODE ='" & fcCode & "'" & _
		" and fcBA='" & session("fcBA") & "'"
		'response.Write q
		Set rsWC = Server.CreateObject("ADODB.Recordset")
		rsWC.CursorType = 3
		rsWC.CursorLocation = 3
		rsWC.Open q, connstr
%>
   <form action="WIP.asp " method="post" name="eForm">
   <table class="data" cellpadding="0" cellspacing="0" width="100%">
		<%
		'Yang tidak bisa di edit adalah PK Table
		%>
		<%IF txtJenis="Edit" Then%>
			 <tr><td align="left">AGREEMENTLINENO</td><td align="left"><input type="text" size="15" name="AGREEMENTLINENO" value="<%=AGREEMENTLINENO%>"  readonly="True" style="background:#999999"></td></tr>
			 <tr><td align="left">WIPDATE</td><td align="left"><input type="text" size="15" name="WIPDATE" value="<%=WIPDATE%>" readonly="True" style="background:#999999">
				<a href="javascript:show_calendar('eForm.WIPDATE');" onMouseOver="window.status='Date Picker';return true;" 
				onmouseout="window.status='';return true;">
				<img src="Images/show-calendar.gif" width=24 height=22 border=0 align=top></a>
			 </td></tr>
		<%else%>
 		     <tr><td align="left">AGREEMENTLINENO</td><td align="left"><input type="text" size="15" name="AGREEMENTLINENO" value="<%=AGREEMENTLINENO%>"></td></tr>
			 <tr><td align="left">WIPDATE</td><td align="left"><input type="text" size="15" name="WIPDATE" value="<%=WIPDATE%>">
				<a href="javascript:show_calendar('eForm.WIPDATE');" onMouseOver="window.status='Date Picker';return true;" 
				onmouseout="window.status='';return true;">
				<img src="Images/show-calendar.gif" width=24 height=22 border=0 align=top></a>
			 </td></tr>
		<%End if%>
		<tr><td align="left">QUANTITY</td><td align="left"><input type="text" size="15" name="QTY" value="<%=QTY%>"></td></tr>
	    <TR><td colspan="2" align="left">
	      <input type="hidden" name="fcCode" value="<%=fcCode%>">
		  <input Type="Hidden" Value="<%=request("txtTable")%>" Name="txtTable">
		  <input Type="Hidden" Value="<%=request("txtModule")%>" Name="txtModule">
		  <%IF Request("txtJenis")="Edit" then%>
		       <input type="hidden" name="txtJenis" value="Edit">
		       <input Type="Submit" style="background-color: #298CF7; color: #F7C610; font-weight: 
		       bold; font-size: 8pt; font-family:Verdana" name="Add" value="Update">
		  <%Else%>
		       <input type="hidden" name="txtJenis" value="New">
		       <input Type="Submit" style="background-color: #298CF7; color: #F7C610; font-weight: 
		       bold; font-size: 8pt; font-family:Verdana" name="Add" value="Add">
		  <%End if%>
		  <input Type="Reset" style="background-color: #298CF7; color: #F7C610; font-weight:
		  bold; font-size: 8pt; font-family:Verdana" name="Reset" value="Reset">
		  <input Type="Button" style="background-color: #298CF7; color: #F7C610; font-weight: 
		  bold; font-size: 8pt; font-family:Verdana" value="Back" name="B2" OnClick="javascript:history.back(1)"></td>
	  </tr>
   </table>

   <table class="data">
   <BR>
	<tr bgcolor="#6666FF" >
	<TD align="left">NO</TD>
	<TD colspan="2">&nbsp;</TD>
	<TD align="left">AGREEMENT CODE</TD>	
	<TD align="left">WIP DATE</TD>	
	<TD align="left">AGREEMENT LINE NO</TD>	
	<TD align="left">QUANTITY</TD>	
	</tr>   
   <%
   if Not rsWC.eof then
      nCountofField=rsWC.fields.count-1
	  no=1
	  While Not rsWC.EOF
		  if no  mod 2 = 1 then
             cColor = "#EEEEEE"
		  else
		     cColor = "#E5E5E5"
		  end if%>
		  <tr bgcolor="<%=cColor%>">
		  <td align="left" valign="top"><%=NO%></td>
			<td valign="middle" width="30">
			<a href="WIP.asp?fcCode=<%=rsWC("AGREEMENTCODE")%>&AGREEMENTLINENO=<%=rsWC("AGREEMENTLINENO")%>&wipdate=<%=rsWC("WIPDATE")%>&QTY=<%=rsWC("QTY")%>&txtJenis=Edit"><img src="IMAGES/edit.gif" alt="Edit Data : <%=rsWC(1)%>" border="0"></a></td><td>
			<a href="WIP.asp?fcCode=<%=rsWC("AGREEMENTCODE")%>&AGREEMENTLINENO=<%=rsWC("AGREEMENTLINENO")%>&wipdate=<%=rsWC("WIPDATE")%>&txtJenis=Delete"><img src="IMAGES/delete.gif" alt="Delete Data : <%=rsWC(1)%>" border="0"   onClick="return confirm('Are you sure to delete');"></a>
			</td>
		    <%for i = 0 to nCountofField-4%>
			    <td align="left" title="<%=rsWC(i).Name%>" valign="top"><%=rsWC(i)%></td>
		    <%next%>
		  </tr>
		  <%
		  rsWC.MoveNext
		  intRecordsPerPage = intRecordsPerPage - 1
		  no=no+1
	  Wend
   end if 
   rsWC.Close
   set rsWC = Nothing%>
   </TABLE>
   </form>
<%End if%>  
 
  <%'-------------akhir----------------------%>
 </td>
</tr>
<tr>
  <td colspan="2">
  <!--#include file="bottom.jsp"-->
  </td>
</tr>
</table>
</body>
</html>
