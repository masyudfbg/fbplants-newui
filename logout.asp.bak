		<title>FB-PlantS</title>
		<link href="css/login/login.min.css" rel="stylesheet" type="text/css">
		<link href="css/login/font-awesome.min.css" rel="stylesheet" type="text/css">
</head>


  <%
  '--ATAS ISI--
  Dim txtUser,txtBA,txtPassword,q,sesCompany, tempStringUsers, tempStringFcba, rsFcba,firstAddress_,txtBU,rsCompany,txtCompany
  txtUser=Request("txtUser")
  txtPassword=Request("txtPassword")
  txtBU=Request("businessunit")
  txtCompany=Request("company")

	Session("fcBa")= ""
	Session("Crop")=""
	Session("BA") = ""
	Session("COMPANY")=""
	Session("FCMANAGER") = ""
	Session("KTU") = ""
	Session("Estate_Mill") = ""
	Session("v_Bank")=""
	Session("v_Purchase")=""
