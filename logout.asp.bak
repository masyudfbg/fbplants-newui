	Session("v_Sales")=""
    Session("USERNAME") = ""
	Session("CodeName") = ""

	Session("cls_Bank")= ""
	Session("cls_Purchase")= ""
	Session("cls_Stores")= ""
	Session("cls_Employee")= ""
