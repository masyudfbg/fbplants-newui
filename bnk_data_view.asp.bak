								sqldtlupah = " SELECT a.sivcode,a.sivdate,a.storecode,b.jobcode,job_api.get_jobcode_name(jobcode,a.fcba) jobname, " & _ 
								             " b.locationcode,b.quantity,b.reference,b.remarks " & _
											 " FROM  issue a INNER JOIN issuedetails b ON a.sivcode=b.sivcode AND a.fcba=b.fcba " & _
											 " WHERE a.fcba='" & businessunit & "' AND b.stockcode='" & bkmno& "' " & _
											 " AND to_char(a.sivdate,'YYYYMM')=to_char(to_date('"& tglbkm & "','MM/DD/YYYY'),'YYYYMM') " & _
											 " ORDER BY a.sivdate DESC " 



                           	
								set rsdtlupah = connStr.Execute(sqldtlupah)
								no = 0
								totalamount = 0
								While Not rsdtlupah.EOF %>
								<tr id="tru<%=no%>">
									
									<td class="ratakiri">
										<%=rsdtlupah("sivcode")%>
									</td>
									<td class="ratakiri">
										<%=rsdtlupah("sivdate")%>
									</td>
									<td class="ratakiri">
										<%=rsdtlupah("storecode")%>
									</td>
									<td class="ratakiri">
										<%=rsdtlupah("jobname")%>
									</td>
									<td class="ratakiri">
										<%=rsdtlupah("locationcode")%>
									</td>
									
									
									<td class="ratakiri">
										<%=rsdtlupah("remarks")%>
									</td>
									<td>
										<%=formatnumber(rsdtlupah("quantity"),2)%>
									</td>
																
									<td>
									<a href="IssueDetails.Asp?fccOde=<%=rsdtlupah("sivcode")%>&txtJenis=Edit"> <img src="IMAGES/edit.gif" alt="Edit Data : <%=rsdtlupah("sivcode")%>" border="0"></a>								
									</td>
									
								</tr>
								<%

									no = no +1
									totalamount = cdbl(totalamount) + cdbl(rsdtlupah("quantity"))
									rsdtlupah.MoveNext
									Wend
								%>
								<tr class="ratakanan">
										<td colspan="6" class="tebal">Total</td>
										<td class="tebal"><input class="ratakanan lebarupah" type="text" readonly  style="background-color:#eee;" name="amount" id="amount<%=no%>" value="<%=FormatNumber(totalamount,0)%>"/></td>
									</tr>

							</table>
						</div>	
<!-- WRITEOFF -->
                        <div class="TabbedPanelsContent">
							<table align=center border="0" width="900" class='data' id='table2'>
								<tr id="trheader2">									
									<th>No.WO</th>
									<th>Date.WO</th>
									<th>Store</th>
									<th>Description</th>
									<th>Qty</th>
									<th>Action</th>	
									
								</tr>

								<% 
								
								
								'get data detail upah
								'dim sqldtlupah,rsdtlupah,no,totalamount
								sqldtlupah = "  SELECT a.writeoffcode,a.wodate,a.storecode,b.quantity,b.reference,b.remarks " & _
											 "	FROM  writeoff a " & _
											 "	INNER JOIN writeoffdetails b ON a.writeoffcode=b.writeoffcode AND a.fcba=b.fcba " & _
											 "	WHERE a.fcba='" & businessunit & "' AND b.stockcode='" & bkmno& "' " & _
											 "	AND to_char(a.wodate,'YYYYMM')=to_char(to_date('"& tglbkm & "','MM/DD/YYYY'),'YYYYMM') " & _
											 "	ORDER BY a.wodate DESC "




                           	
								set rsdtlupah = connStr.Execute(sqldtlupah)
								no = 0
								totalamount = 0
								While Not rsdtlupah.EOF %>
								<tr id="tru<%=no%>">
									
									<td class="ratakiri">
										<%=rsdtlupah("writeoffcode")%>
									</td>
									<td class="ratakiri">
										<%=rsdtlupah("wodate")%>
									</td>
									<td class="ratakiri">
										<%=rsdtlupah("storecode")%>
									</td>
									<td class="ratakiri">
										<%=rsdtlupah("remarks")%>
									</td>
									
									<td>
										<%=formatnumber(rsdtlupah("quantity"),2)%>
									</td>
									
									
																
									<td>
									<a href="WriteOff.Asp?fccOde=<%=rsdtlupah("writeoffcode")%>&txtJenis=Edit"> <img src="IMAGES/edit.gif" alt="Edit Data : <%=rsdtlupah("writeoffcode")%>" border="0"></a>								
									</td>
									
								</tr>
								<%

									no = no +1
									totalamount = cdbl(totalamount) + cdbl(rsdtlupah("quantity"))
									rsdtlupah.MoveNext
									Wend
								%>
								<tr class="ratakanan">
										<td colspan="4" class="tebal">Total</td>
										<td class="tebal"><input class="ratakanan lebarupah" type="text" readonly  style="background-color:#eee;" name="amount" id="amount<%=no%>" value="<%=FormatNumber(totalamount,0)%>"/></td>
								</tr>


							</table>
						</div>							

					</div>
				</div>
			</td>
		</tr>
		<tr class="ratatengah">
			
