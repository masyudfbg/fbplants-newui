			function(data) {
				try {
					var json  = JSON.parse(data);
					// Angka: pemisah ribuan & rata kanan (tampilan saja)
					var qty = $.fn.dataTable.render.number(',', '.', 2);

					$('#tablemutasistockharian').DataTable({
						destroy: true,
						data: json.results,
						paging: true,
						searching: true,
						ordering: true,
						pageLength: 10,
						scrollY: "420px",
						scrollX: true,
						scrollCollapse: true,
						columns: [
							{ data: "stockcode", className: "huruftebal" },
							{ data: "stockname" },
							{ data: "stockgroup" },
							{ data: "storecode" },
							{ data: "satuan" },
							{ data: "openingbalanceqty", render: qty, className: "ratakanan" },
							{ data: "terima_hi", render: qty, className: "ratakanan" },
							{ data: "terimasd_hi", render: qty, className: "ratakanan" },
							{ data: "keluar_hi", render: qty, className: "ratakanan" },
							{ data: "keluarsd_hi", render: qty, className: "ratakanan" },
							{
								data: null,
								className: "ratakanan huruftebal",
								render: function(data, type, row) {
									let jml = (row.openingbalanceqty || 0) + (row.terima_hi || 0) + (row.terimasd_hi || 0);
									let kurang = (row.keluar_hi || 0) + (row.keluarsd_hi || 0);
									return $.fn.dataTable.render.number(',', '.', 2).display(jml-kurang);
								}
							}
						],
						language: {
							lengthMenu: "Tampilkan _MENU_ baris per halaman",
							zeroRecords: "Data tidak ditemukan",
							emptyTable: "Tidak ada mutasi stock untuk filter ini",
							info: "Menampilkan _START_ sampai _END_ dari _TOTAL_ data",
							infoEmpty: "Tidak ada data",
							infoFiltered: "(disaring dari total _MAX_ data)",
							search: "Cari:",
							paginate: {
								first: "Awal",
								last: "Akhir",
								next: "Berikutnya",
								previous: "Sebelumnya"
							}
						},
						dom: 'Blfrtip',
						lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
						buttons: [
							{
								extend: 'excelHtml5',
								text: 'Export Excel',
								className: 'btn-excel',
								title: 'Monitoring Stock Harian'
							},
							{
								extend: 'pdfHtml5',
								text: 'Export PDF',
								className: 'btn-pdf',
								orientation: 'landscape',  // bisa 'portrait' atau 'landscape'
								pageSize: 'A4',            // ukuran halaman PDF
								title: 'Monitoring Stock Harian'       // judul di PDF
							}
						]
					});

					// document.getElementById("totalIn").innerText      	= totalIn.toLocaleString();
					// document.getElementById("totalOut").innerText     	= totalOut.toLocaleString();
					// document.getElementById("saldoEnding").innerText     	= saldo.toLocaleString();
					// document.getElementById("totalNominal").innerText 	= totalNominal.toLocaleString();

					$('#mshEmpty').hide();
					$('#loadingjudul').hide();
					$('#loading').hide();
				} catch (e) {
					console.error("JSON parse error:", e, data);
					$('#loadingjudul').hide();
					$('#loading').hide();
					$('#mshEmpty').html('<i class="fa fa-exclamation-triangle" aria-hidden="true"></i>Data gagal dimuat. Periksa filter lalu coba lagi.').show();
					return;
				}
			}
		);
	}

	</script>
