	function togglePeriode() {
		var mode = $('input[name="periodebnk"]:checked').val();

		if (mode === 'bulan') {
			$("#bulanbnk").prop("disabled", false);
			$("#tahunbnk").prop("disabled", false);
			$("#hppfrom").prop("disabled", true);
			$("#hppto").prop("disabled", true);
		} else {
			$("#bulanbnk").prop("disabled", true);
			$("#tahunbnk").prop("disabled", true);
			$("#hppfrom").prop("disabled", false);
			$("#hppto").prop("disabled", false);
		}
	}

	// Format tampilan tabel: ribuan koma + 2 desimal (1,234,567.89). numformat() lama tetap dipakai untuk input.
	function numformat2(val) {
		var n = parseFloat(String(val == null ? '' : val).replace(/,/g, ''));
		if (isNaN(n)) return val == null ? '' : val;
		var p = (Math.abs(n) < 0.005 ? 0 : n).toFixed(2).split('.');
		return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1];
	}

	function numformat(val) {
		var nStr = Math.round(val).toString();
		nStr = nStr.replace(/\,/g, "");
		var x = nStr.split('.');
		var x1 = x[0];
		var x2 = x.length > 1 ? '.' + x[1] : '';
		var rgx = /(\d+)(\d{3})/;
		while (rgx.test(x1)) {
			x1 = x1.replace(rgx, '$1' + '.' + '$2');
		}
		return x1 + x2;
	}


