		}

		function launchwin(winurl,winname,winfeatures){
			newwin = window.open(winurl,winname,winfeatures);
		}

		function showPrdStock(buss_unit) {
			$('#productstock').empty();
			$('#productstock').select2({
				ajax: {
					delay: 1000,
					url : 'getListfcbaallajax.asp?fccompanycode=' + buss_unit + '&idresta=' + 6,
