		// Format tampilan tabel: ribuan koma + 2 desimal (1,234,567.89). numformat() lama tetap dipakai untuk input.
		function numformat2(val) {
			var n = parseFloat(String(val == null ? '' : val).replace(/,/g, ''));
			if (isNaN(n)) return val == null ? '' : val;
			var p = (Math.abs(n) < 0.005 ? 0 : n).toFixed(2).split('.');
			return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1];
		}

		function numformat(val) {
			var nStr = Math.round(val).toString();
			nStr = nStr.replace(/\,/g, "");
			var x = nStr.split('.');
			var x1 = x[0];
			var x2 = x.length > 1 ? '.' + x[1] : '';
			var rgx = /(\d+)(\d{3})/;
			while (rgx.test(x1)) {
				x1 = x1.replace(rgx, '$1' + '.' + '$2');
			}
			return x1 + x2;
		}

		function getDayFromMMDDYYYY(dateString) {
			// Memecahkan string tanggal
			const parts = dateString.split('/');

			// Ekstrak bagian hari (indeks 1 dalam array berindeks 0)
			const day = parseInt(parts[1], 10);

			return day;
		}

		function tampilDataKartuStock(){
			var pfcba			= $("#buss_unit").val();
			var wrhouse			= $("#wrhouse").val();
			var productstock  	= $("#itemcode").val();
			var datefrom	  	= $("#datefrom").val();
			var dateto		  	= $("#dateto").val();

			var tanggal = getDayFromMMDDYYYY(datefrom);

			if(pfcba == 0){
				alert("Business Unit belum dipilih!");
			}

			if(productstock == 0 || productstock == null){
				alert("Product belum dipilih!");
			}

			$.post("bkm_viewdata.asp?fcba=" + pfcba + "&idview=" + 35 + "&productstock=" + productstock + "&datefrom=" + datefrom + "&dateto=" + dateto + '&wrhouse=' + wrhouse, function(data) {
				console.log("DATA:", data);   // sudah object
				console.log("Status:", data.status);
				console.log("Message:", data.message);

				if (data.status === "success") {
					console.log("SUKSESSSS");
					getDataStockAwal(pfcba, productstock, datefrom, dateto, wrhouse);
				} else {
					alert("Gagal: " + data.message);
				}
			});
		}

		function getDataStockAwal(pfcba, productstock, datefrom, dateto, wrhouse){
			$('#loadingjudul').show();
			$('#loading').show();
			
			$.post("bkm_viewdata.asp?fcba=" + pfcba + "&idview=" + 36 + "&productstock=" + productstock + "&dateto=" + dateto + "&datefrom=" + datefrom + "&wrhouse=" + wrhouse, function(data) {
				var openStock = data.results.opening[0].openingbalanceqty;
				var amtStock = data.results.opening[0].amt;

				document.getElementById('saldoawal').innerHTML = openStock.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");
				document.getElementById('nominalawal').innerHTML = amtStock.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ",");

				if (data.status === "success") {
					console.log("SUKSES 37");
					$.post("bkm_viewdata.asp?fcba=" + pfcba + "&idview=" + 37 + "&productstock=" + productstock + "&datefrom=" + datefrom + "&dateto=" + dateto + '&wrhouse=' + wrhouse, function(data) {
						$('#bodytablekartustock').empty();
						try {
							var json  = JSON.parse(data);
							var jumlview  = json.results.length;
							var no = 1;

							var totalIn = 0, totalOut = 0, totalNominal = 0;
							var saldo = openStock;

							for (var i = 0; i < jumlview; i++) {
								document.getElementById('companyname').innerHTML = json.results[i].fccompanycode;
								document.getElementById('fcbaname').innerHTML = json.results[i].fccode;

								saldo = saldo + json.results[i].inqty - json.results[i].outqty;
								
								totalIn      += parseFloat(json.results[i].inqty) || 0;
								totalOut     += parseFloat(json.results[i].outqty) || 0;
								totalNominal += parseFloat(json.results[i].amount) || 0;

								//alert(x);
								var docketlist = '';
								if (json.results[i].get_stockminimum != 0 && json.results[i].closing_balance_day <= json.results[i].get_stockminimum) {
									docketlist += '<tr bgcolor= "red" id="tru'+i+'">';
								} else {
									docketlist += '<tr id="tru'+i+'">';
								}
									
								docketlist += '<td align="left">' + json.results[i].fccompanycode + '</td>';
								docketlist += '<td align="left">' + json.results[i].fccode + '</td>';
								docketlist += '<td align="left">' + json.results[i].store + '</td>';
								docketlist += '<td align="left">' + json.results[i].tgl + '</td>';
								docketlist += '<td align="left">' + json.results[i].sivcode + '</td>';
								docketlist += '<td align="left">' + json.results[i].modul + '</td>';
								docketlist += '<td align="right">' + json.results[i].inqty.toLocaleString() + '</td>';
								docketlist += '<td align="right">' + json.results[i].outqty.toLocaleString() + '</td>';
								docketlist += '<td align="right">' + saldo.toLocaleString() + '</td>';
								docketlist += '<td align="right">' + json.results[i].amount.toLocaleString() + '</td>';
								docketlist += '</tr>';

								$('#bodytablekartustock').append(docketlist);
								
								no++;
								$("#jumldata").val(jumlview);
							}

							document.getElementById("totalIn").innerText      	= totalIn.toLocaleString();
							document.getElementById("totalOut").innerText     	= totalOut.toLocaleString();
							document.getElementById("saldoEnding").innerText     	= saldo.toLocaleString();
							document.getElementById("totalNominal").innerText 	= totalNominal.toLocaleString();

							$('#loadingjudul').hide();
							$('#loading').hide();
						} catch (e) {
							console.error("JSON parse error:", e, data);
							return;
						}
					});
				} else {
					alert("Gagal: " + data.message);
				}
			});
		}

		function cetakXLSKartuStock()
		{
			var pfcba			= $("#buss_unit").val();
			var productstock  	= document.getElementById("productcode").innerText;
			var datefrom	  	= $("#datefrom").val();
			var dateto		  	= $("#dateto").val();
