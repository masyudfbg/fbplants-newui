	}


	function getPuttotallhp() {
		var tottbsterima	= 0;
		var tottbsolah		= 0;
		var totcpoproduksi	= 0;
		var totcpokirim		= 0;
		var totpkproduksi	= 0;
		var totpkkirim		= 0;
