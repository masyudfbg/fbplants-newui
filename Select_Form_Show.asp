	// Format tampilan tabel: ribuan koma + 2 desimal (1,234,567.89). numformat() lama tetap dipakai untuk input.
	function numformat2(val) {
		var n = parseFloat(String(val == null ? '' : val).replace(/,/g, ''));
		if (isNaN(n)) return val == null ? '' : val;
		var p = (Math.abs(n) < 0.005 ? 0 : n).toFixed(2).split('.');
		return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1];
	}

	function numformat(val) {
		var nStr = Math.round(val).toString();
		nStr = nStr.replace(/\,/g, "");
		var x = nStr.split('.');
		var x1 = x[0];
		var x2 = x.length > 1 ? '.' + x[1] : '';
		var rgx = /(\d+)(\d{3})/;
		while (rgx.test(x1)) {
			x1 = x1.replace(rgx, '$1' + '.' + '$2');
		}
		return x1 + x2;
	}


	function tampilData()
	{
		var companylhd 			= $("#companylhd").val();
		var businessunitlhd 	= $("#businessunitlhd").val();
		var bkmfrom 			= $("#bkmfrom").val();
		var bkmto 				= $("#bkmto").val();
		

		var dt = new Date(bkmfrom);
     	dt.setDate( dt.getDate() - 1 );
		var today = dt.getDate();
		var tomnth = dt.getMonth() + 1;
		var tglawal = tomnth + '/' + today + '/' + dt.getFullYear();

 
		if (bkmfrom != "") { 
				$('#loadingjudul').show();
				$('#loading').show();
				$.post("bkm_viewdata.asp?bkmfrom=" + tglawal + "&bkmto=" + bkmto + "&idview=" + 25 + "&fcba=" + businessunitlhd ,function(data) {
				$('#bodytablelappabrik').empty();
				var json  = JSON.parse(data);
				var jumlview  = json.results.length;
				var no = 1;
				var ttltroughtputhi = 0;
				var ttltroughtputsbi = 0;
				var ttloerhi = 0;
				var ttloersbi = 0;
				var ttlffahi = 0;
				var ttlbiayahi = 0;
				var ttlbiayasbi = 0;
				for (var i = 0; i < jumlview; i++) {
					var cpoffa 			= json.results[i].cpoffa;
					var prod_olah_amnt 	= json.results[i].prod_olah_amnt;
					var prod_olah_amntsbi 	= json.results[i].prod_olah_amntsbi;
					var jamkerja 		= json.results[i].jamkerjahi;
					var jamkerjasbi 	= json.results[i].jamkerjasbi;
					var tbsterimahi 	= json.results[i].tbsterimahi;
					var tbsterimasbi 	= json.results[i].tbsterimasbi;
					var tbssisahi 		= json.results[i].tbssisahi;
					var tbssisasbi 		= json.results[i].tbssisasbi;
					var potongantbshi 	= json.results[i].potongantbshi;
					var potongantbsbi 	= json.results[i].potongantbssbi;

					var cpokirim  		= json.results[i].cpokirim;
					var cpokirimsbi		= json.results[i].cpokirimsbi;
					var adjcpo  		= json.results[i].adjcpo;
					var adjcposbi  		= json.results[i].adjcposbi;
					var cpocothi 		= json.results[i].cpocot;
					var cpocotsbi 		= json.results[i].cpocotsbi;
					var cpocsthi 		= json.results[i].cpocst;
					var cpocstsbi 		= json.results[i].cpocstsbi;
					var cpoothi 		= json.results[i].cpoot;
					var cpootsbi 		= json.results[i].cpootsbi;
					var cpotankisihi 	= json.results[i].cpotankisi;
					var cpotankisisbi 	= json.results[i].cpotankisisbi;
					var totalcpohi		= parseFloat(cpokirim)+(parseFloat(cpocothi)+parseFloat(cpocsthi)+parseFloat(cpoothi)+parseFloat(cpotankisihi));
					var totalcposbi		= parseFloat(cpokirimsbi)+(parseFloat(cpocotsbi)+parseFloat(cpocstsbi)+parseFloat(cpootsbi)+parseFloat(cpotankisisbi));

					var kernelkirimhi	= json.results[i].kernelkirim;
					var kernelkirimsbi	= json.results[i].kernelkirimsbi;
					var kernelsilohi	= json.results[i].kernelsilo;
					var kernelsilosbi	= json.results[i].kernelsilosbi;
					var pktankisihi		= json.results[i].pktankisi;
					var pktankisisbi	= json.results[i].pktankisisbi;
					var totalpkhi		= parseFloat(kernelkirimhi)+(parseFloat(kernelsilohi)+parseFloat(pktankisihi))
					var totalpksbi		= parseFloat(kernelkirimsbi)+(parseFloat(kernelsilosbi)+parseFloat(pktankisisbi))


					//GET Sisa stock CPO
					
					var cposisa 		= parseFloat(cpotankisihi)+parseFloat(cpocothi)+parseFloat(cpocsthi)+parseFloat(cpoothi)-parseFloat(adjcpo);
					var cposisasbi 		= parseFloat(cpotankisisbi)+parseFloat(cpocotsbi)+parseFloat(cpocstsbi)+parseFloat(cpootsbi)-parseFloat(adjcposbi);

					//GET Sisa stock PK
				 	var pksisa 			= parseFloat(pktankisihi)+parseFloat(kernelsilohi);
				 	var pksisasbi		= parseFloat(pktankisisbi)+parseFloat(kernelsilosbi);
						
						
							
					
					
					if(i > 0){   
						var sisakemarin	= json.results[i-1].tbssisahi;
						var sisakemarinsbi	= json.results[i-1].tbssisasbi;
						var tersedia   		= parseFloat(tbsterimahi) + parseFloat(sisakemarin);
						var tersediasbi   	= parseFloat(tbsterimasbi) + parseFloat(sisakemarinsbi);
                		var tbsolah    		= tersedia - tbssisahi-potongantbshi;
                		var tbsolahsbi    	= parseFloat(tersediasbi) - parseFloat(tbssisasbi)-parseFloat(potongantbsbi);
						//alert(tersediasbi);

						var cpocotkemarin 		= json.results[i-1].cpocot;
						var cpocotkemarinsbi 	= json.results[i-1].cpocotsbi;
						var cpocstkemarin 		= json.results[i-1].cpocst;
						var cpocstkemarinsbi 	= json.results[i-1].cpocstsbi;
						var cpootkemarin 		= json.results[i-1].cpoot;
						var cpootkemarinsbi 	= json.results[i-1].cpootsbi;
						var cpotankisikemarin 	= json.results[i-1].cpotankisi;
						var cpotankisikemarinsbi 	= json.results[i-1].cpotankisisbi;
						var totalcpokemarin		= parseFloat(cpocotkemarin)+parseFloat(cpocstkemarin)+parseFloat(cpootkemarin)+parseFloat(cpotankisikemarin);
						var totalcpokemarinsbi	= parseFloat(cpocotkemarinsbi)+parseFloat(cpocstkemarinsbi)+parseFloat(cpootkemarinsbi)+parseFloat(cpotankisikemarinsbi);
						//alert(tbsolah);
						if(tbsolah>0){
							var cpohi			= parseFloat(totalcpohi)-parseFloat(totalcpokemarin);
						}else{
							cpohi = 0;
						}
						if(tbsolahsbi>0){
							var cposbi			= parseFloat(totalcposbi)-parseFloat(totalcpokemarinsbi);
						}else{
							cposbi = 0;
						}

						//hitung kapasitas per jam
						if(jamkerja == 0) {
							var kapasitasjamhi    = 0;
						}else{
							var kapasitasjamhi    = parseFloat(tbsolah)/parseFloat(jamkerja);
						}
						if(jamkerjasbi == 0) {
							var kapasitasjamsbi    = 0;
						}else{
							var kapasitasjamsbi    = parseFloat(tbsolahsbi)/parseFloat(jamkerjasbi);
						}

						//var kernelkirimkemarin	= json.results[i-1].kernelkirim;
						var kernelsilokemarin	= json.results[i-1].kernelsilo;
						var kernelsilokemarinsbi	= json.results[i-1].kernelsilosbi;
						var pktankisikemarin	= json.results[i-1].pktankisi;
						var pktankisikemarinsbi	= json.results[i-1].pktankisisbi;
						var totalpkkemarin		= parseFloat(kernelsilokemarin)+parseFloat(pktankisikemarin);
						var totalpkkemarinsbi	= parseFloat(kernelsilokemarinsbi)+parseFloat(pktankisikemarinsbi);
						var produksipkhi		= parseFloat(totalpkhi)-parseFloat(totalpkkemarin);
						var produksipksbi		= parseFloat(totalpksbi)-parseFloat(totalpkkemarinsbi);

						//OER
						   if(tbsolah== 0){
								oerhi   = 0
						   }else{
								oerhi   = (parseFloat(cpohi)/parseFloat(tbsolah)) *100
								oerhi 	= (oerhi);
						   }

						   if(tbsolahsbi== 0){
								oersbi   = 0
						   }else{
							
								oersbi   = (parseFloat(cposbi)/parseFloat(tbsolahsbi)) *100
								oersbi 	= (oersbi);
						   }

						var docketlist = '';
							docketlist += '<tr id="tru'+i+'" class="font24">';
							docketlist += '<td align="left">' + json.results[i].proddate + '</td>';
							docketlist += '<td align="right">' + numformat2(kapasitasjamhi) + '</td>';
							docketlist += '<td align="right">' + numformat2(kapasitasjamsbi) + '</td>';
							docketlist += '<td align="right">' + numformat2(oerhi) + '</td>';	
							docketlist += '<td align="right">' + numformat2(oersbi) + '</td>';				
							docketlist += '<td align="right">' + (cpoffa) + '</td>';
							docketlist += '<td align="right">' + numformat2(prod_olah_amnt) + '</td>';
							docketlist += '<td align="right">' + numformat2(prod_olah_amntsbi) + '</td>';
						
							//docketlist += '<td align="center"><a target=_blank href="bkm_jurnal_input.Asp?tglbkm='+ json.results[i].lhpno + '"><img src="IMAGES/view.png" alt="View Data border="0"></a></td>';
							docketlist += '</tr>';
							$('#bodytablelappabrik').append(docketlist);
						no++;
						$("#jumldata").val(jumlview);
							ttltroughtputhi += kapasitasjamhi;
							ttltroughtputsbi += kapasitasjamsbi;
							ttloerhi += oerhi;
							ttloersbi += oersbi;
							ttlffahi += cpoffa;
							ttlbiayahi += prod_olah_amnt;
							ttlbiayasbi += prod_olah_amntsbi;
						getPuttotallappabrik(ttltroughtputhi,ttltroughtputsbi,ttloerhi,ttloersbi,ttlffahi,ttlbiayahi,ttlbiayasbi);

					}
					
				}
				$('#loadingjudul').hide();
				$('#loading').hide();
				
			});
		 
		} else {
			$('#bodytablelappabrik').empty();
		}
	}

	function getPuttotallappabrik(ttltroughtputhi,ttltroughtputsbi,ttloerhi,ttloersbi,ttlffahi,ttlbiayahi,ttlbiayasbi)
	{
		$('#ttltroughhputhi').html(numformat2(ttltroughtputhi));
