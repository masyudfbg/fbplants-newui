	</tr>
	<tr>
		<td><font face="Verdana" size="1">Gang</font></td>
		<td>
			<select name="gangdata" id="gangdata" style="width:200px" onchange="getBussUnit()">
				<option value="-">-- Pilih --</option>
				<option value="-" <%if gangSlct="-" then%>selected<%end if%>>--All--</option>
				<%
				If Trim(v_businessunit) <> "" Then
					Dim qBU1, rsBU1
					qBU1 = "SELECT fccode, fcname FROM GANG " & _
						"WHERE fcba = '" & v_businessunit & "' " & _
						"ORDER BY fccode ASC"
					Set rsBU1 = Server.CreateObject("ADODB.Recordset")
					rsBU1.CursorType = 3 : rsBU1.CursorLocation = 3
					rsBU1.Open qBU1, connstr
					Do While Not rsBU1.EOF
				%>
					<option value="<%=rsBU1("fccode")%>"
						<%if cstr(v_businessunit)=cstr(rsBU1("fccode")) then%>selected<%end if%>>
						<%=rsBU1("fccode")%> - <%=rsBU1("fcname")%>
