		var jumgl = parseInt($('#jmljrn').val());
		
		const date1 = new Date(jrnfrom);
		const date2 = new Date(jrnto);
		const diffTime = Math.abs(date2 - date1);
		const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24))+1; 

		if (diffDays <= 31) {
		
		if (jrnfrom != "") { 
		
				$('#loadingjudul').show();
				$('#loading').show();
				$.post("bkm_viewdata.asp?tglprd=" + t1 +"&jrnfrom=" + jrnfrom + "&jrnto=" + jrnto + "&tahun=" + tahun + "&bulan=" + bulan + "&idview=" + 5 + "&sourcecode=" + sourcecode+"&company=" + pcompany+"&fcba=" + pfcba+"&posting=" + posting,function(data) {
