		['view1', 'view2'].forEach(function (id) {
			var table = document.getElementById(id), wrap = document.getElementById(id + 'wrap');
			// baris berisi sel angka tersembunyi (data-t="n") untuk Excel, jadi jumlah sel > jumlah judul
			FbpTable.init(table, { pageSize: 20, allRows: true, thousands: '.', observe: true, onChange: function () {
				var any = document.getElementById('bodytablebsb').rows.length || document.getElementById('bodytablebsb2').rows.length;
				document.getElementById('nrg-hint').style.display = any ? 'none' : '';
			} });
			var row = table.querySelector('tr.fbt-toolbar-row'), tools = row && row.querySelector('.fbt-tools'), foot = wrap.querySelector('.fbt-foot');
			if (tools) wrap.querySelector('.nrg-tools').appendChild(tools);
			// baris toolbar dibuang dari tabel supaya tidak ikut ke file Excel
			if (row) row.parentNode.removeChild(row);
			if (foot) wrap.querySelector('.nrg-foot').appendChild(foot);
		});
	})();
