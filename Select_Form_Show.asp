    function exportExcel(tableId, filename) {
        var tbl = document.getElementById(tableId);
        if (!tbl) { alert('Tabel tidak ditemukan'); return; }
        var clone = tbl.cloneNode(true);
        clone.querySelectorAll('tr.hidden-row').forEach(function(r) {
            r.classList.remove('hidden-row');
        });
        var wb = XLSX.utils.book_new();
        var ws = XLSX.utils.table_to_sheet(clone, { raw: false });
        var range = XLSX.utils.decode_range(ws['!ref']);
        var colWidths = [];
        for (var C = range.s.c; C <= range.e.c; C++) {
            var maxLen = 8;
            for (var R = range.s.r; R <= range.e.r; R++) {
                var cell = ws[XLSX.utils.encode_cell({r:R,c:C})];
                if (cell && cell.v) { var len = String(cell.v).length; if (len > maxLen) maxLen = len; }
            }
            colWidths.push({ wch: Math.min(maxLen + 2, 30) });
        }
        ws['!cols'] = colWidths;
        XLSX.utils.book_append_sheet(wb, ws, filename.substring(0, 31));
        XLSX.writeFile(wb, filename + '.xlsx');
    }

    // Format tampilan tabel: ribuan koma + 2 desimal (1,234,567.89). numformat() lama tetap dipakai untuk input.
    function numformat2(val) {
    	var n = parseFloat(String(val == null ? '' : val).replace(/,/g, ''));
    	if (isNaN(n)) return val == null ? '' : val;
    	var p = (Math.abs(n) < 0.005 ? 0 : n).toFixed(2).split('.');
    	return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1];
    }

    function numformat(val) {
        var nStr  = parseFloat(val).toFixed(2).replace(/\.00$/, '');
        var parts = nStr.split('.');
        parts[0]  = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, '.');
        return parts.join(',');
    }
