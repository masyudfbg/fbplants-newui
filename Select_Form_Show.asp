	function launchwin(winurl,winname,winfeatures){
		newwin = window.open(winurl,winname,winfeatures);
	}

	// Format tampilan tabel: ribuan koma + 2 desimal (1,234,567.89). numformat() lama tetap dipakai untuk input.
	function numformat2(val) {
		var n = parseFloat(String(val == null ? '' : val).replace(/,/g, ''));
		if (isNaN(n)) return val == null ? '' : val;
		var p = (Math.abs(n) < 0.005 ? 0 : n).toFixed(2).split('.');
		return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1];
	}

	function numformat(val) {
		var nStr = Math.round(val).toString();
		nStr = nStr.replace(/\,/g, "");
		var x = nStr.split('.');
		var x1 = x[0];
		var x2 = x.length > 1 ? '.' + x[1] : '';
		var rgx = /(\d+)(\d{3})/;
		while (rgx.test(x1)) {
			x1 = x1.replace(rgx, '$1' + '.' + '$2');
		}
		return x1 + x2;
	}

	function getDayFromMMDDYYYY(dateString) {
		// Memecahkan string tanggal
		const parts = dateString.split('/');

		// Ekstrak bagian hari (indeks 1 dalam array berindeks 0)
		const day = parseInt(parts[1], 10);

		return day;
	}

	function tampilDataMonitoringStokHarian(){
		var pfcba			= $("#buss_unit").val();
		var wrhouse			= $("#wrhouse").val();
		var datefrom	  	= $("#datefrom").val();
		var dateto		  	= $("#dateto").val();

		var tanggal = getDayFromMMDDYYYY(datefrom);

		if(pfcba == 0){
			alert("Business Unit belum dipilih!");
		}
