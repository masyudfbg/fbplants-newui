			dim sqlbkmv, rsBkmView
			sqlbkmv = "SELECT DISTINCT to_number(accountingperiod) bulan, description " & _
					"FROM accountingperiod WHERE accountingperiod BETWEEN 1 AND 12 ORDER BY bulan"
			Set rsBkmView = Server.CreateObject("ADODB.Recordset")
			rsBkmView.CursorType = 3 : rsBkmView.CursorLocation = 3
			rsBkmView.Open sqlbkmv, connstr
			While Not rsBkmView.EOF
				If cint(selectedBulan) = cint(rsBkmView("bulan")) Then
			%>
				<option value="<%=rsBkmView("bulan")%>" selected><%=rsBkmView("description")%></option>
			<%  Else %>
				<option value="<%=rsBkmView("bulan")%>"><%=rsBkmView("description")%></option>
			<%  End If
			rsBkmView.MoveNext : Wend
			rsBkmView.Close : Set rsBkmView = Nothing
			%>
			</select>
			<font face="Verdana" size="1">Tahun</font>
			<select name="tahunbnk" id="tahunbnk" style="width:120px">
			<%
			Dim selectedTahun
			selectedTahun = Request("tahunbnk")
			If Trim(selectedTahun) = "" Then selectedTahun = Year(Now)
			dim sqlbva, rsbva
			sqlbva = "SELECT DISTINCT to_number(accountingyear) tahun FROM accountingyear ORDER BY tahun"
			Set rsbva = Server.CreateObject("ADODB.Recordset")
			rsbva.CursorType = 3 : rsbva.CursorLocation = 3
			rsbva.Open sqlbva, connstr
			While Not rsbva.EOF
				If cint(selectedTahun) = cint(rsbva("tahun")) Then
			%>
				<option value="<%=rsbva("tahun")%>" selected><%=rsbva("tahun")%></option>
			<%  Else %>
				<option value="<%=rsbva("tahun")%>"><%=rsbva("tahun")%></option>
			<%  End If
			rsbva.MoveNext : Wend
			rsbva.Close : Set rsbva = Nothing
			%>
			</select>
		</td>
	</tr>
	<tr>
		<td><font face="Verdana" size="1">Status</font></td>
		<td>
			<select name="statusdata" id="statusdata" style="width:200px">
				<option value="-">-- Pilih Status --</option>
				<option value="-" <%if statusSlct="-" then%>selected<%end if%>>--All--</option>
				<option value="KBT" <%if statusSlct="kbt" then%>selected<%end if%>>KBT</option>
				<option value="KHT" <%if statusSlct="kht" then%>selected<%end if%>>KHT</option>
				<option value="KHL" <%if statusSlct="khl" then%>selected<%end if%>>KHL</option>
			</select>
