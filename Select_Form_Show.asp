    function getTotal(ttlHaPlanted,ttlHaGross,ttlareal_lc,ttlHaHarvested,ttlTotStand,ttlProdStand, ttlHaRawat,ttlHaPupuk,ttlHaPanen,ttlJjgPanen,ttlKgPanen)
	{
