	<script type="text/javascript">
	// Tabel BKM ala DataTables. Hanya tampilan: data tetap diisi tampilData() lewat AJAX;
	// FbpTable membaca ulang baris otomatis setiap #bodytable berganti isi.
	(function () {
		var table = document.getElementById('bkmv-table');
		if (!window.FbpTable || !table) return;
		var ids = { upahtext: 'totalupahview', bahantext: 'totalbahanview', vehicletext: 'totalvehicleview', wiptext: 'totalwipview', tottext: 'totalview' };
		function fmt(n) { return (typeof numformat === 'function') ? numformat(n) : Math.round(n); }
		function stateClass(s) {
			s = (s || '').toLowerCase();
			if (s.indexOf('approv') > -1 || s.indexOf('post') > -1) return 'ok';
			if (s.indexOf('review') > -1) return 'info';
			if (s.indexOf('plan') > -1) return 'warn';
			return '';
		}
		var api = FbpTable.init(table, {
			pageSize: 20, allRows: true, thousands: '.', dateFormat: 'dmy', observe: true,
			onChange: function (rows) {
				// Total ikut hasil pencarian; nilai mentah diambil dari input tersembunyi tiap baris
				var sum = {};
				Object.keys(ids).forEach(function (k) { sum[k] = 0; });
				rows.forEach(function (r) {
					Object.keys(ids).forEach(function (k) {
						var inp = r.querySelector('input[id^="' + k + '"]');
						if (inp) sum[k] += parseFloat(inp.value) || 0;
					});
					var st = r.cells[13], ps = r.cells[14];
					if (st && !st.querySelector('.bkmv-state') && st.textContent.trim()) {
						st.innerHTML = '<span class="bkmv-state ' + stateClass(st.textContent) + '">' + st.innerHTML + '</span>';
					}
					if (ps && !ps.querySelector('.bkmv-state') && ps.textContent.trim()) {
						ps.innerHTML = '<span class="bkmv-state' + (ps.textContent.trim() === 'YA' ? ' ok' : '') + '">' + ps.innerHTML + '</span>';
					}
				});
				if (api) Object.keys(ids).forEach(function (k) { document.getElementById(ids[k]).innerHTML = fmt(sum[k]); });
				var total = api ? api.rows().length : 0;
				document.getElementById('bkmv-hint').style.display = total ? 'none' : '';
			}
		});
		var tools = table.querySelector('.fbt-toolbar-row .fbt-tools'), foot = table.parentNode.querySelector('.fbt-foot');
		if (tools) document.getElementById('bkmv-tools').appendChild(tools);
		if (foot) document.getElementById('bkmv-foot').appendChild(foot);
	})();
	</script>
