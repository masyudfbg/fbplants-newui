	// Format tampilan tabel: ribuan koma + 2 desimal (1,234,567.89). numformat() lama tetap dipakai untuk input.
	function numformat2(val) {
		var n = parseFloat(String(val == null ? '' : val).replace(/,/g, ''));
		if (isNaN(n)) return val == null ? '' : val;
		var p = (Math.abs(n) < 0.005 ? 0 : n).toFixed(2).split('.');
		return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1];
	}

	function numformat(val) {
		var nStr = Math.round(val).toString();
		nStr = nStr.replace(/\,/g, "");
		var x = nStr.split('.');
		var x1 = x[0];
		var x2 = x.length > 1 ? '.' + x[1] : '';
		var rgx = /(\d+)(\d{3})/;
		while (rgx.test(x1)) {
			x1 = x1.replace(rgx, '$1' + '.' + '$2');
		}
		return x1 + x2;
	}


	function cetakPDF()
	{
		var tglawalsls = $("#tglawalsls").val();
		var tglakhirsls = $("#tglakhirsls").val();
		var businessunitar 	= $("#businessunitsls").val();
		
		window.open('p_salesinv_pdf.Asp?tglawal=' + tglawalsls + '&tglakhir=' + tglakhirsls + '&businessunitar=' + businessunitar, '_blank');
	}

	function tampilData()
	{
		var tglawalsls = $("#tglawalsls").val();
		var tglakhirsls = $("#tglakhirsls").val();
		var jumlinv 	= parseInt($('#jmlslsinv').val());
		var posting 	= $("#postingar").val();
		var businessunitar 	= $("#businessunitsls").val();
		var totqty		= 0;
		var totambvat	= 0;
		var totamountvat	= 0;
		var totgrand		= 0;
		var tot  		= 0;
		
	
		if (tglawalsls != "") { 
				$('#loadingjudul').show();
				$('#loading').show();
				$.post("bkm_viewdata.asp?tglawalsls=" + tglawalsls + "&tglakhirsls=" + tglakhirsls + "&posting=" + posting + "&idview=" + 18 + "&fcba=" + businessunitar + "&posting=" + posting,function(data) {
				$('#bodytable').empty();
				var json  = JSON.parse(data);
				var jumlview  = json.results.length;
				var no = 1;
				for (var i = 0; i < jumlview; i++) {

					var fcba = json.results[i].fcba;
					var postingflg = json.results[i].postingflg;
					if(postingflg=="1"){
						postingflg = "YA";
					}else{
						postingflg = "TIDAK";
					}
					
					var docketlist = '';
						docketlist += '<tr id="tru'+i+'">';
						docketlist += '<td align="left">' + json.results[i].invoicecode + '</td>';
						docketlist += '<td align="left">' + json.results[i].transdate + '</td>';
						docketlist += '<td align="left">' + json.results[i].salescontractno + '</td>';
						docketlist += '<td align="left">' + json.results[i].productcode + '</td>';
						docketlist += '<td align="left">' + json.results[i].customername + '</td>';
						docketlist += '<td align="right">' + numformat2(json.results[i].quantity) + '</td>';
						docketlist += '<td align="right">' + numformat2(json.results[i].amount_beforevat) + '</td>';
						docketlist += '<td align="right">' + numformat2(json.results[i].amountvat) + '</td>';				
						docketlist += '<td align="right">' + numformat2(json.results[i].grandtotal) + '</td>';
						docketlist += '<td align="left" class="">' + postingflg + '</td>';
						docketlist += '<td align="center"><a target=_blank href="salesinv_jurnal_view.Asp?invoicecode=' + json.results[i].invoicecode + '&fcba=' + fcba + '&tglinvoice=' + json.results[i].transdate + '"><img src="IMAGES/view.png" alt="View Data Jurnal="0"></a></td>';
						docketlist += '</tr>';
						$('#bodytable').append(docketlist);
					no++;
					$("#jmlslsinv").val(jumlview);
					totqty		+= json.results[i].quantity;
					totambvat	+= json.results[i].amount_beforevat;
					totamountvat	+= json.results[i].amountvat;
					totgrand		+= json.results[i].grandtotal;
					
					
				}
				$('#loadingjudul').hide();
				$('#loading').hide();
				getPuttotal(totqty,totambvat,totamountvat,totgrand);
					
			});
		 
		} else {
			$('#bodytable').empty();
		}
		
	}



