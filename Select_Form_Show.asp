						docketlist += '<td align="left">' + (json.results[i].rowstate) + '<input type="hidden" name="wiptext'+i+'" id="wiptext'+i+'" value='+json.results[i].rowstate+' /></td>';				
						if(type=="Perawatan"){
							docketlist += '<td align="center"><a target=_blank href="rkb_perawatan.Asp?rkbno='+json.results[i].rkbno+ '&fcba='+json.results[i].fcba+'"><img src="IMAGES/view.png" alt="View Data border="0"></a></td>';
							if(json.results[i].rowstate=="Planned"){
								docketlist += '<td align="center"><a target=_blank href="rkb_perawatan1_edit.Asp?rkbno='+json.results[i].rkbno+ '&fcba='+json.results[i].fcba+'&rowstateid=' + json.results[i].rowstate +' "><img src="IMAGES/edit.gif" alt="Edit Data border="0"></a></td>';
							}else{
								docketlist += '<td align="center"><a target=_blank href="rkb_perawatan_adendum.Asp?rkbno='+json.results[i].rkbno+ '&fcba='+json.results[i].fcba+'"><img src="IMAGES/details_open.png" alt="Adendum Data border="0"></a></td>';
							}
						}else if(type=="Panen"){
							docketlist += '<td align="center"><a target=_blank href="rkb_panen.Asp?rkbno='+json.results[i].rkbno+ '&fcba='+json.results[i].fcba+'&rowstateid=' + json.results[i].rowstate +'"><img src="IMAGES/view.png" alt="View Data border="0"></a></td>';
							if(json.results[i].rowstate=="Planned"){
								docketlist += '<td align="center"><a target=_blank href="rkb_panen_new_edit.Asp?rkbno='+json.results[i].rkbno+ '&fcba='+json.results[i].fcba+'&rowstateid=' + json.results[i].rowstate +' "><img src="IMAGES/edit.gif" alt="Edit Data border="0"></a></td>';
							}else{
								docketlist += '<td align="center"><a target=_blank href="rkb_panen_new_adendum.Asp?rkbno='+json.results[i].rkbno+ '&fcba='+json.results[i].fcba+'"><img src="IMAGES/details_open.png" alt="Adendum Data border="0"></a></td>';
							}
						}
						else if(type=="Vehicle"){
							docketlist += '<td align="center"><a target=_blank href="rkb_traksi.Asp?rkbno='+json.results[i].rkbno+ '&fcba='+json.results[i].fcba+'&rowstateid=' + json.results[i].rowstate +'"><img src="IMAGES/view.png" alt="View Data border="0"></a></td>';
							if(json.results[i].rowstate=="Planned"){
								docketlist += '<td align="center"><a target=_blank href="rkb_traksi_edit.Asp?rkbno='+json.results[i].rkbno+ '&fcba='+json.results[i].fcba+'&rowstateid=' + json.results[i].rowstate +' "><img src="IMAGES/edit.gif" alt="Edit Data border="0"></a></td>';
							}else{
