		ttlareal_lc	    = numformat2(ttlareal_lc);
		ttlHaPlanted    = numformat2(ttlHaPlanted);
		ttlHaHarvested	= numformat2(ttlHaHarvested);
		ttlTotStand		= numformat2(ttlTotStand);
		ttlProdStand	= numformat2(ttlProdStand);
