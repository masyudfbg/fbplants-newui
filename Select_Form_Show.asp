	function get_AllowClosingUnit(kolomid)
	{
		
		var tahun = $('#tahun').val();
		var bulan = $('#bulan').val();

		if (tahun != "" && bulan != "") {
			$.post("bkm_viewdata.asp?tahun=" + tahun + "&bulan=" + bulan + "&idview=" + 45 + "&kolomid=" + kolomid, function(data) {
				var json  = JSON.parse(data);
				var closingstatus = json.results[0].closingstatus;
				//alert(closingstatus);
				//var closingStatus = "TRUE";
				 if (closingstatus === "FALSE") {
                    // ENABLE
                    $('#btnprosesdata')
                        .removeClass('disabledButton white')
                        .addClass('button_menu_top');
                    $('#btnlock')
                        .removeClass('disabledButton white')
                        .addClass('button_menu_top');
                } else {
                    // DISABLE
                    $('#btnprosesdata')
                        .removeClass('button_menu_top')
                        .addClass('disabledButton white');
                    $('#btnlock')
                        .removeClass('button_menu_top')
                        .addClass('disabledButton white');
                }
				
				
							
			});
			
		} 
	}


	//get lastupdate closing by unit
	function get_LastupdateClosingUnit(modulid)
	{
		
		var tahun   = $("#tahun").val();
		var bulan 	= $("#bulan").val();
		//var lstupdate = $('#lastupdate1').val();	
		//alert(lstupdate);
		if (tahun != "" && bulan != "") {
			$('#lastupdate1').html("");	
			$.post("bkm_employee.asp?tahun=" + tahun + "&bulan=" + bulan + "&employee=" + 410 + "&modulid=" + modulid, function(data) {
				var json  = JSON.parse(data);
				var lastupdate = json.results[0].lastupdate;
				lastupdate = lastupdate.replace(/\\u002F/g, "/");
				
				 // ✅ FIX DI SINI
            	
				$('#lastupdate1').html(lastupdate);		
			});
			
		} 
	}

	
