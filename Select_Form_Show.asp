	// =====================================================================
	// Tampilan tabel hasil ala DataTables: cari, jumlah baris per halaman,
	// urut kolom, dan pagination. Hanya menyembunyikan/menampilkan & mengurutkan
	// baris yang sudah dirender tampilData(); tidak mengubah fungsi itu.
	// =====================================================================
	var ssTable = (function () {
		var state = { page: 1, size: 10, query: '', sortCol: -1, sortDir: 1 };
		var tbody, info, pager, tools, foot, nomatch, filterInput;

		function rows() { return $(tbody).children('tr').get(); }
		function cellText(tr, col) { var td = tr.cells[col]; return td ? $.trim($(td).text()) : ''; }

		function sortRows() {
			if (state.sortCol < 0) return;
			var list = rows();
			list.sort(function (a, b) {
				var x = cellText(a, state.sortCol), y = cellText(b, state.sortCol);
				var r = x.localeCompare ? x.localeCompare(y, 'id', { numeric: true, sensitivity: 'base' }) : (x > y ? 1 : x < y ? -1 : 0);
				return r * state.sortDir;
			});
			for (var i = 0; i < list.length; i++) tbody.appendChild(list[i]);
		}

		function pageButton(label, page, opts) {
			opts = opts || {};
			var b = document.createElement('button');
			b.type = 'button';
			b.innerHTML = label;
			b.setAttribute('data-page', page);
			if (opts.aria) b.setAttribute('aria-label', opts.aria);
			if (opts.current) b.setAttribute('aria-current', 'page');
			if (opts.disabled) b.disabled = true;
			return b;
		}

		function renderPager(pages) {
			pager.innerHTML = '';
			pager.appendChild(pageButton('<i class="fa fa-angle-left"></i>', state.page - 1, { aria: 'Halaman sebelumnya', disabled: state.page <= 1 }));
			// Maks. 7 tombol: 1 ... (sekitar halaman aktif) ... terakhir
			var list = [];
			if (pages <= 7) { for (var i = 1; i <= pages; i++) list.push(i); }
			else {
				var from = Math.max(2, state.page - 1), to = Math.min(pages - 1, state.page + 1);
				if (state.page <= 3) { from = 2; to = 4; }
				if (state.page >= pages - 2) { from = pages - 3; to = pages - 1; }
				list.push(1);
				if (from > 2) list.push('...');
				for (var j = from; j <= to; j++) list.push(j);
				if (to < pages - 1) list.push('...');
				list.push(pages);
			}
			for (var k = 0; k < list.length; k++) {
				if (list[k] === '...') { var gap = document.createElement('span'); gap.innerHTML = '&hellip;'; pager.appendChild(gap); }
				else pager.appendChild(pageButton(String(list[k]), list[k], { current: list[k] === state.page, aria: 'Halaman ' + list[k] }));
			}
			pager.appendChild(pageButton('<i class="fa fa-angle-right"></i>', state.page + 1, { aria: 'Halaman berikutnya', disabled: state.page >= pages }));
		}

		function render() {
			var all = rows();
			var tokens = $.trim(state.query.toLowerCase()).split(/\s+/);
			if (tokens.length === 1 && tokens[0] === '') tokens = [];
			var hits = [];
			for (var i = 0; i < all.length; i++) {
				var text = $(all[i]).text().toLowerCase(), ok = true;
				for (var t = 0; t < tokens.length; t++) { if (text.indexOf(tokens[t]) === -1) { ok = false; break; } }
				all[i].style.display = 'none';
				all[i].className = all[i].className.replace(/\s*ss-alt/g, '');
				if (ok) hits.push(all[i]);
			}
			var size = state.size > 0 ? state.size : Math.max(hits.length, 1);
			var pages = Math.max(1, Math.ceil(hits.length / size));
			if (state.page > pages) state.page = pages;
			if (state.page < 1) state.page = 1;
			var start = (state.page - 1) * size, end = Math.min(start + size, hits.length);
			for (var h = start; h < end; h++) {
				hits[h].style.display = '';
				if ((h - start) % 2 === 1) hits[h].className += ' ss-alt';
			}

			var hasData = all.length > 0;
			$(tools).toggleClass('ss-hide', !hasData);
			$(foot).toggleClass('ss-hide', !hasData);
			$(nomatch).toggleClass('ss-hide', !(hasData && hits.length === 0));

			if (!hits.length) info.innerHTML = 'Tidak ada data yang ditampilkan';
			else if (state.size === 0) info.innerHTML = 'Menampilkan semua <b>' + hits.length + '</b> data';
			else info.innerHTML = 'Menampilkan <b>' + (start + 1) + '&ndash;' + end + '</b> dari <b>' + hits.length + '</b> data';
			if (tokens.length && hasData) info.innerHTML += ' (difilter dari ' + all.length + ' total)';
			renderPager(pages);
		}

		function updateSortHeaders() {
			$('#ss-result-table th.ss-sortable').each(function (idx) {
				if (idx === state.sortCol) this.setAttribute('aria-sort', state.sortDir === 1 ? 'ascending' : 'descending');
				else this.removeAttribute('aria-sort');
			});
		}

		$(function () {
			tbody = document.getElementById('bodytable');
			info = document.getElementById('ss-info');
			pager = document.getElementById('ss-pager');
			tools = document.getElementById('ss-tools');
			foot = document.getElementById('ss-foot');
			nomatch = document.getElementById('ss-nomatch');
			filterInput = document.getElementById('ss-filter');

			$('#ss-size').on('change', function () { state.size = parseInt(this.value, 10) || 0; state.page = 1; render(); });
			$(filterInput).on('keyup input', function () {
				if (state.query === this.value) return;
				state.query = this.value; state.page = 1; render();
			}).on('keydown', function (e) {
				if (e.keyCode === 13) e.preventDefault(); // jangan submit form frmEntry
			});
			$(pager).on('click', 'button', function () {
				if (this.disabled) return;
				state.page = parseInt(this.getAttribute('data-page'), 10);
				render();
			});
			$('#ss-result-table th.ss-sortable').each(function (idx) {
				$(this).attr('tabindex', '0').on('click keydown', function (e) {
					if (e.type === 'keydown' && e.keyCode !== 13 && e.keyCode !== 32) return;
					e.preventDefault();
					if (state.sortCol === idx) state.sortDir = -state.sortDir;
					else { state.sortCol = idx; state.sortDir = 1; }
					updateSortHeaders();
					sortRows();
					state.page = 1;
					render();
				});
			});
			render();
		});

		return {
			// Dipanggil setelah data baru selesai dimuat
			reset: function () {
				state.page = 1; state.query = ''; state.sortCol = -1;
				if (filterInput) filterInput.value = '';
				updateSortHeaders();
				render();
			}
		};
	})();

	// Tampilan saja: perbarui jumlah hasil & keadaan kosong setelah pencarian selesai.
	// Tidak mengubah tampilData(); hanya membaca hasil yang sudah dirender.
	$(document).ajaxComplete(function (e, xhr, settings) {
		if (!settings || !settings.url || settings.url.indexOf('idview=32') === -1) return;
		var rows = $('#bodytable tr').length;
		$('#ss-count').removeClass('muted').text(rows + ' stock ditemukan');
		$('#ss-empty').toggle(rows === 0).removeClass('error')
			.html('<i class="fa fa-inbox" aria-hidden="true"></i>Tidak ada stock yang cocok dengan filter.');
		ssTable.reset();
	});
	$(document).ajaxError(function (e, xhr, settings) {
		if (!settings || !settings.url || settings.url.indexOf('idview=32') === -1) return;
		$('#loadingjudul').hide();
		$('#loading').hide();
		$('#ss-count').addClass('muted').text('Gagal memuat');
		$('#ss-empty').show().addClass('error')
			.html('<i class="fa fa-exclamation-circle" aria-hidden="true"></i>Gagal memuat data. Silakan coba lagi.');
	});

	</script>


