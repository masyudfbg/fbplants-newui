	<script type="text/javascript">
	// Tabel jurnal ala DataTables. Hanya tampilan: data tetap diisi viewData() lewat AJAX;
	// FbpTable membaca ulang baris otomatis setiap #bodytablejrn berganti isi.
	(function () {
		var table = document.getElementById('jrnv-table');
		if (!window.FbpTable || !table) return;
		function fmt(n) { return (typeof numformat === 'function') ? numformat(n) : Math.round(n); }
		var api = FbpTable.init(table, {
			pageSize: 20, thousands: '.', dateFormat: 'dmy', observe: true,
			onChange: function (rows) {
				// Total ikut hasil pencarian; nilai mentah dari input tersembunyi tiap baris
				var d = 0, k = 0;
				rows.forEach(function (r) {
					var di = r.querySelector('input[id^="debet"]'), ki = r.querySelector('input[id^="kredit"]');
					if (di) d += parseFloat(di.value) || 0;
					if (ki) k += parseFloat(ki.value) || 0;
					var ps = r.cells[10];
					if (ps && !ps.querySelector('.jrnv-post') && ps.textContent.trim()) {
						ps.innerHTML = '<span class="jrnv-post' + (ps.textContent.trim() === 'YA' ? ' ok' : '') + '">' + ps.innerHTML + '</span>';
					}
				});
				if (api) { document.getElementById('totaldebetview').innerHTML = fmt(d); document.getElementById('totalkreditview').innerHTML = fmt(k); }
				document.getElementById('jrnv-hint').style.display = (api && api.rows().length) ? 'none' : '';
			}
		});
		var tools = table.querySelector('.fbt-toolbar-row .fbt-tools'), foot = table.parentNode.querySelector('.fbt-foot');
		if (tools) document.getElementById('jrnv-tools').appendChild(tools);
		if (foot) document.getElementById('jrnv-foot').appendChild(foot);
	})();
	</script>

