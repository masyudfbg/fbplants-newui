		while (rgx.test(x1)) {
			x1 = x1.replace(rgx, '$1' + '.' + '$2');
		}
		return x1 + x2;
	}

    //ambil data detail
	function viewData()
	{
		var bulan 	= $("#bulan").val();
		var tahun 	= $("#tahun").val();
		var akunawal 	= $("#akunawal").val();
		var akunakhir 	= $("#akunakhir").val();
		var pcompanygl = '<%= Session("companycode") %>';
		var pfcbagl    = '<%= Session("fcba") %>';
		var jumgl = parseInt($('#jmlbs').val());
		
		
		if (akunawal != "") { 
				$('#loadingjudul').show();
				$('#loading').show();
				$.post("bkm_viewdata.asp?tahun=" + tahun + "&bulan=" + bulan + "&idview=" + 6 + "&akunawal=" + akunawal + "&company=" + pcompanygl+"&fcba=" + pfcbagl + "&akunakhir=" + akunakhir,function(data) {
				$('#bodytablebs').empty();
				var json  = JSON.parse(data);
				var jumlview  = json.results.length;
				var no = 1;
				var openamnt=0;
				var dbamnt=0;
				var cramnt=0;
				var totopen =0;
				var totdb   =0;
				var totcr   =0;
				var totend  =0;
				
				for (var i = 0; i < jumlview; i++) {
					openamnt = json.results[i].opening_balance;
					dbamnt = json.results[i].debet;
					cramnt = json.results[i].credit;
					
					if ( openamnt != 0 || dbamnt != 0 || cramnt != 0) {
					
					var docketlist = '';
						docketlist += '<tr id="trbs'+i+'">';
						docketlist += '<td align="left">' + no + '</td>';
						docketlist += '<td align="left">' + json.results[i].fccode + '</td>';
						docketlist += '<td align="left">' + json.results[i].fcname + '</td>';
						docketlist += '<td style="display:none;" data-t="n" >' + json.results[i].opening_balance + '</td>';
						docketlist += '<td data-exclude="true" align="right">' + numformat2(json.results[i].opening_balance) + '<input class="ratakanan lebarupah" type="hidden" name="opening_balance' + i + '" id="opening_balance' + i + '" value="' + json.results[i].opening_balance + '"/></td>';
						
						docketlist += '<td style="display:none;" data-t="n" >' + json.results[i].debet + '</td>';
						docketlist += '<td data-exclude="true" align="right">' + numformat2(json.results[i].debet) + '<input class="ratakanan lebarupah" type="hidden" name="debet' + i + '" id="debet' + i + '" value="' + json.results[i].debet + '"/></td>';
						
						docketlist += '<td style="display:none;" data-t="n" >' + json.results[i].credit + '</td>';
						docketlist += '<td data-exclude="true" align="right">' + numformat2(json.results[i].credit) + '<input class="ratakanan lebarupah" type="hidden" name="credit' + i + '" id="credit' + i + '" value="' + json.results[i].credit + '"/></td>';
						
						docketlist += '<td style="display:none;" data-t="n" >' + json.results[i].ending_balance + '</td>';
						docketlist += '<td data-exclude="true" align="right">' + numformat2(json.results[i].ending_balance) + '<input class="ratakanan lebarupah" type="hidden" name="ending_balance' + i + '" id="ending_balance' + i + '" value="' + json.results[i].ending_balance + '"/></td>';
						
						docketlist += '<td style="display:none;" >' + json.results[i].jobgroupcode + '</td>';
						docketlist += '<td style="display:none;" >' + json.results[i].job_forbalancesheetcode + '</td>';
						docketlist += '<td style="display:none;" >' + json.results[i].job_forprofitandlosscode + '</td>';
						docketlist += '<td style="display:none;" >' + json.results[i].job_forcashflowcode + '</td>';
						docketlist += '<td style="display:none;" >' + json.results[i].job_forbudgetcode + '</td>';
						
						docketlist += '</tr>';
						$('#bodytablebs').append(docketlist);
					no++;
					$("#jmlbs").val(jumlview);
					totopen += json.results[i].opening_balance;
					totdb   += json.results[i].debet;
					totcr   += json.results[i].credit;
					totend  += json.results[i].ending_balance;
					}
					
				}

				$('#loadingjudul').hide();
				$('#loading').hide();
				getPuttotal(totopen,totdb,totcr,totend);
				
				
			});
		 
		} else {
			$('#bodytablebs').empty();
		}
	}
	
	function getPuttotal(totopen,totdb,totcr,totend) {
		var totawal	= 0;
		var totakhir= 0;
		var totdebet= 0;
		var totkredit= 0;
		
		totawal      = numformat(totopen);
		totdebet     = numformat(totdb);
		totkredit    = numformat(totcr);
		totakhir     = numformat(totend);
		
		$('#totalawalbs').html((totawal));
		$('#totaldebetbs').html((totdebet));
		$('#totalcreditbs').html((totkredit));
		$('#totalakhirbs').html((totakhir));
		
	}

