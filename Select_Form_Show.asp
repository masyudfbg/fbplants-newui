	function getExport1() {
    var bulan      = $("#bulan").val() || "";
    var tahun      = $("#tahun").val() || "";
    var pcompanygl = $("#companybs").val() || "";
    var pfcbagl    = $("#businessunitbs").val() || "";

    var fileName = `Neraca_PerGroup_${pcompanygl}_${pfcbagl}_${tahun}${bulan}.xlsx`;

    var rows = $('#bodytablebs tbody tr');

    var groups = {};

    rows.each(function(index, row) {
        var $tds = $(row).find('td');

        if ($tds.length < 11) {
            console.warn(`Baris ke-${index + 1} diabaikan karena kolom kurang dari 11`);
            return; 
        }

        var groupCode = $tds.eq(8).text().trim();
        var groupName = $tds.eq(9).text().trim();

        function parseNumber(text) {
            if (!text) return 0;
            var cleanText = text.replace(/\./g, '').replace(/,/g, '.');
            var num = parseFloat(cleanText);
            return isNaN(num) ? 0 : num;
        }
        var saldoAwal  = parseNumber($tds.eq(4).text());
        var debet      = parseNumber($tds.eq(6).text());
        var kredit     = parseNumber($tds.eq(7).text());
        var saldoAkhir = parseNumber($tds.eq(10).text());

        if (!groupCode) {
            console.warn(`Baris ke-${index + 1} diabaikan karena groupCode kosong`);
            return;
        }

        if (!groups[groupCode]) {
            groups[groupCode] = {
                name: groupName,
                saldoAwal: 0,
                debet: 0,
                kredit: 0,
                saldoAkhir: 0
            };
        }

        groups[groupCode].saldoAwal += saldoAwal;
        groups[groupCode].debet += debet;
        groups[groupCode].kredit += kredit;
        groups[groupCode].saldoAkhir += saldoAkhir;
    });

    function formatNumber(num) {
        return num.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    var exportHtml = '<table id="tableExportGroup" border="1" style="border-collapse: collapse;">';
    exportHtml += '<thead><tr style="background-color:#f2f2f2;">';
    exportHtml += '<th>Group Code</th><th>Group Name</th><th>Saldo Awal</th><th>Debet</th><th>Kredit</th><th>Saldo Akhir</th>';
    exportHtml += '</tr></thead><tbody>';

    for (var code in groups) {
        var g = groups[code];
        exportHtml += '<tr>';
        exportHtml += `<td>${code}</td>`;
        exportHtml += `<td>${g.name}</td>`;
        exportHtml += `<td align="right">${formatNumber(g.saldoAwal)}</td>`;
        exportHtml += `<td align="right">${formatNumber(g.debet)}</td>`;
        exportHtml += `<td align="right">${formatNumber(g.kredit)}</td>`;
        exportHtml += `<td align="right">${formatNumber(g.saldoAkhir)}</td>`;
        exportHtml += '</tr>';
    }
    exportHtml += '</tbody></table>';

    $("#tableExportGroup").remove();

    $("body").append(exportHtml);
    try {
        TableToExcel.convert(document.getElementById("tableExportGroup"), {
            name: fileName,
            sheet: {
                name: "NeracaPerGroup"
            }
        });
    } catch (error) {
        console.error("Error saat export Excel:", error);
        alert("Gagal export Excel, cek console untuk detail.");
    }
}

		
	// Format tampilan tabel: ribuan koma + 2 desimal (1,234,567.89). numformat() lama tetap dipakai untuk input.
	function numformat2(val) {
		var n = parseFloat(String(val == null ? '' : val).replace(/,/g, ''));
		if (isNaN(n)) return val == null ? '' : val;
		var p = (Math.abs(n) < 0.005 ? 0 : n).toFixed(2).split('.');
		return p[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + p[1];
	}

	function numformat(val) {
		var nStr = Math.round(val).toString();
		nStr = nStr.replace(/\,/g, "");
		var x = nStr.split('.');
		var x1 = x[0];
		var x2 = x.length > 1 ? '.' + x[1] : '';
		var rgx = /(\d+)(\d{3})/;
		while (rgx.test(x1)) {
			x1 = x1.replace(rgx, '$1' + '.' + '$2');
		}
		return x1 + x2;
	}

