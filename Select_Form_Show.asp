		ttlHaPupuk	    = numformat(ttlHaPupuk);
		ttlHaPanen		= numformat(ttlHaPanen);
		ttlJjgPanen	    = numformat(ttlJjgPanen);
		ttlKgPanen	    = numformat(ttlKgPanen);
		
		$("#ttlHaGross").html(ttlHaGross);
		$("#ttlareal_lc").html(ttlareal_lc);
