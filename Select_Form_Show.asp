	function getPuttotal(p_upah,p_bahan,p_vra) {
		
		totupah 	= numformat(p_upah);
		totbahan 	= numformat(p_bahan);
		totvra 		= numformat(p_vra);
		$('#totalupahrkb').html(totupah);
		$('#totalbahanrkb').html(totbahan);
		$('#totalvrarkb').html(totvra);
		$('#totalwiprkb').html(0);
		
	}

