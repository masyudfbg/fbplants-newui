	function openPopupKartuStock(buss_unit){
		var buss_unit = $("#buss_unit").val();
		launchwin('popup_kartustock.asp?fcba='+ buss_unit +'&Mode=Print','newwindow','width='+(1000)+',height='+(705)+',screenX=0,screenY=0,directories=0,fullscreen=0,location=0,menubar=0,scrollbars=1,status=0,toolbar=1');
