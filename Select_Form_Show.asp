	function viewDataBibit() {
        var hppfrom  = $("#hppfrom").val();
        var hppto    = $("#hppto").val();
        var pcompany = $("#companyhppday").val();
        var pfcba    = $("#businessunithppday").val();

        if (pcompany == "-") { alert("COMPANY BELUM DIPILIH"); return false; }
        if (pfcba == null)   { alert("UNIT BELUM DIPILIH");    return false; }

        $('#loadingjudul').show();
        $('#loading').show();
        $('#bodytablehppbibit_dly').empty();

        $.post("bkm_viewdata.asp?bkmfrom=" + hppfrom + "&bkmto=" + hppto +
            "&idview=46&company=" + pcompany + "&fcba=" + pfcba, function(data) {

            var json    = JSON.parse(data);
            var results = json.results;
            var s = { kec:0, tanam:0, pn1:0, mn1:0, tr:0, prp:0, pn2:0, mn2:0, alo:0, tot:0, hpp1:0, hpp2:0 };
            var tbody = '';

            for (var i = 0; i < results.length; i++) {
                var row  = results[i];
                var kec  = Number(row.kecambah)       || 0;
                var tanam= Number(row.tanam_kecambah)  || 0;
                var pn1  = Number(row.prenursery)      || 0;
                var mn1  = Number(row.main_nursery)    || 0;
                var tr   = Number(row.transfer)        || 0;
                var prp  = Number(row.persiapan)       || 0;
                var pn2  = Number(row.prenursery2)     || 0;
                var mn2  = Number(row.main_nursery2)   || 0;
                var alo  = Number(row.alokasi)         || 0;
                var tot  = prp + pn2 + mn2 + alo;
                var hpn  = pn1 > 0 ? tot / pn1 : 0;
                var hmn  = mn1 > 0 ? tot / mn1 : 0;

                tbody += '<tr>';
                tbody += '<td class="bc">' + (i + 1)           + '</td>';
                tbody += '<td class="bl">' + (row.company||'')  + '</td>';
                tbody += '<td class="bl">' + (row.fcba||'')     + '</td>';
                tbody += '<td class="bl">' + (row.docdate||'')  + '</td>';
                tbody += '<td class="br">' + numformat2(kec)     + '</td>';
                tbody += '<td class="br">' + numformat2(tanam)   + '</td>';
                tbody += '<td class="br">' + numformat2(pn1)     + '</td>';
                tbody += '<td class="br">' + numformat2(mn1)     + '</td>';
                tbody += '<td class="br">' + numformat2(tr)      + '</td>';
                tbody += '<td class="br">' + numformat2(prp)     + '</td>';
                tbody += '<td class="br">' + numformat2(pn2)     + '</td>';
                tbody += '<td class="br">' + numformat2(mn2)     + '</td>';
                tbody += '<td class="br">' + numformat2(alo)     + '</td>';
                tbody += '<td class="br">' + numformat2(tot)     + '</td>';
                tbody += '<td class="br" style="display: none;">' + (pn1 > 0 ? numformat2(hpn) : '0') + '</td>';
                tbody += '<td class="br">' + (mn1 > 0 ? numformat2(hmn) : '0') + '</td>';
                tbody += '</tr>';

                s.kec   += kec;
                s.tanam += tanam;
                s.pn1   += pn1;
                s.mn1   += mn1;
                s.tr    += tr;
                s.prp   += prp;
                s.pn2   += pn2;
                s.mn2   += mn2;
                s.alo   += alo;
                s.tot   += tot;
                s.hpp1 	+= hpn;
				s.hpp2 	= s.tot / s.mn1;
            }

            // Hitung HPP footer dari akumulasi total
            var s_hpn = s.pn1 > 0 ? s.tot / s.pn1 : 0;
            var s_hmn = s.mn1 > 0 ? s.tot / s.mn1 : 0;

            $('#bodytablehppbibit_dly').html(tbody);

            $('#ttl_kecambah').text(numformat2(s.kec));
            $('#ttl_tanam_kecambah').text(numformat2(s.tanam));
            $('#ttl_prenursery1').text(numformat2(s.pn1));
            $('#ttl_mainnursery1').text(numformat2(s.mn1));
            $('#ttl_transfer').text(numformat2(s.tr));
            $('#ttl_persiapan').text(numformat2(s.prp));
            $('#ttl_prenursery2').text(numformat2(s.pn2));
            $('#ttl_mainnursery2').text(numformat2(s.mn2));
            $('#ttl_alokasi').text(numformat2(s.alo));
            $('#ttl_total').text(numformat2(s.tot));
            $('#ttl_hpp_pn').text(s.pn1 > 0 ? numformat2(s.hpp1) : '0');
            $('#ttl_hpp_mn').text(numformat2(s.hpp2));

            $("#jmlhpp_dly").val(results.length);
            $('#loadingjudul').hide();
            $('#loading').hide();
        });
    }

