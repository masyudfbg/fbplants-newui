<%
Dim company47, v_absYear, v_absMonth, v_absGangCode, v_absView
company47      = Request("company")
v_absYear      = Request("tahunbnk")
v_absMonth     = Request("bulanbnk")
v_businessunit = Request("businessunitbnk")
statusSlct = Request("statusdata")
gangSlct = Request("gangdata")

If Trim(company47)      = "" Then company47      = Session("CompanyCode")
If Trim(v_businessunit) = "" Then v_businessunit = ""
If Trim(v_absYear)      = "" Then v_absYear      = Year(Now)
If Trim(v_absMonth)     = "" Then v_absMonth     = Month(Now)

If Trim(v_businessunit) = "-" Then
	whereFcba = " IN (SELECT fccode FROM businessunit WHERE fccompanycode='" & company47 & "' AND isactive='TRUE' AND fctype='E')"
ElseIf Trim(v_businessunit) = "" Then
	whereFcba = " = '" & Session("FCBA") & "'"
Else
	whereFcba = " = '" & v_businessunit & "'"
End If

If v_absYear  = "" Then v_absYear  = Year(Now)
If v_absMonth = "" Then v_absMonth = Month(Now)
If v_absView  = "" Then v_absView  = "ABSEN"

Dim strAbs, emptyTd, emptyIdx, strMonth, strNextMonth, strNextYear, strStatus, strGang
strMonth = Right("0" & CInt(v_absMonth), 2)
If CInt(v_absMonth) = 12 Then
	strNextMonth = "01" : strNextYear = CInt(v_absYear) + 1
Else
	strNextMonth = Right("0" & (CInt(v_absMonth)+1), 2) : strNextYear = CInt(v_absYear)
End If

' Status / Present Grade
if statusSlct = "-" And Trim(statusSlct) = "" then
    strStatus = " "
else
    strStatus = " AND em.presentgrade IN ('KHL','KHT','KBT')"
end if

' Gang Code - hanya filter jika bukan "-" DAN bukan spasi/kosong
if gangSlct <> "-" And Trim(gangSlct) <> "" then
    strGang = " AND em.gangcode = '" & gangSlct & "'"
else
    strGang = ""
end if

' ===== QUERY ABSENSI =====
strAbs = "WITH payroll AS (" & _
		 "  SELECT fcba, employeecode, SUM(total) AS total_amount" & _
		 "  FROM BKMPAYROLL_DAILY" & _
		 "  WHERE fcba " & whereFcba & _
		 "  AND period_year=" & CInt(v_absYear) & " AND period_month=" & CInt(v_absMonth) & _
		 "  GROUP BY fcba, employeecode" & _
		 ")," & _
		 "src AS (" & _
		 "  SELECT ag.fcba, b.bkmdate AS fddate, ag.employeecode," & _
		 "         em.fcname AS employeename, em.presentgrade AS status, em.gangcode," & _
		 "         NVL(p.total_amount,0) AS total_amount, ag.mandays AS mandays" & _
		 "  FROM BKMUPAHDTL ag" & _
		 "  INNER JOIN BKMHDR b ON b.bkmno=ag.bkmno AND b.fcba=ag.fcba AND b.postingflg='1'" & _
		 "  INNER JOIN employee em ON em.fcba=ag.fcba AND em.fccode=ag.employeecode" & _
		 "  LEFT JOIN payroll p ON p.fcba=ag.fcba AND p.employeecode=ag.employeecode" & _
		 "  WHERE ag.fcba " & whereFcba & _
		 "  AND TO_CHAR(b.bkmdate,'yyyy-mm')='" & CInt(v_absYear) & "-" & strMonth & "'" & _
		 "  AND ag.attendance IN ('KJ','DL','KK','TG')" & _ 
		 strStatus & _
		 strGang & _
		 "  GROUP BY ag.fcba,b.bkmdate,ag.employeecode,em.fcname,em.presentgrade,em.gangcode,p.total_amount ,ag.mandays" & _
		 ")" & _
		 " SELECT fcba,employeecode,employeename,status,gangcode,"


Dim d
For d = 1 To 31
	strAbs = strAbs & " SUM(DECODE(EXTRACT(DAY FROM fddate)," & d & ",mandays,0)) day_" & d & ","
Next
strAbs = strAbs & " SUM(mandays) AS total, MAX(total_amount) AS total_amount" & _
		 " FROM src GROUP BY fcba,employeecode,employeename,status,gangcode ORDER BY employeecode ASC"
'-- Print SQL
'response.write strAbs

Dim rsAbs
Set rsAbs = Server.CreateObject("ADODB.Recordset")
rsAbs.Open strAbs, connstr, 3

Dim absDay(31), absTot, absNo, absCls, ttlAmt
For d = 1 To 31 : absDay(d) = 0 : Next
absTot = 0 : absNo = 1 : ttlAmt = 0

' ===== QUERY BAHAN =====
Dim strBahan
strBahan = "WITH src AS (" & _
		   "  SELECT ag.fcba, ag.itemcode," & _
		   "         NVL(s.fcname,'') AS fcname, NVL(s.unitofmeasurement,'') AS unitofmeasurement," & _
		   "         b.bkmdate AS fddate, ag.qty," & _
		   "         (SELECT amtperunit FROM stockledger WHERE itemcode=ag.itemcode AND storecode='ST1'" & _
		   "          AND fcba=ag.fcba AND amtperunit<>0 AND YEAR=" & CInt(v_absYear) & " AND MONTH=" & CInt(strMonth) & _
		   "          FETCH FIRST 1 ROWS ONLY) as amtrp" & _
		   "  FROM BKMBAHANDTL ag" & _
		   "  INNER JOIN BKMHDR b ON b.bkmno=ag.bkmno AND b.fcba=ag.fcba" & _
		   "  LEFT JOIN STOCK s ON s.fccode=ag.itemcode AND s.fcba=ag.fcba" & _
		   "  WHERE ag.fcba " & whereFcba & _
		   "  AND TO_CHAR(b.bkmdate,'yyyy-mm')='" & CInt(v_absYear) & "-" & strMonth & "'" & _
		   ") SELECT itemcode,fcname,unitofmeasurement,fcba,"
For d = 1 To 31
	strBahan = strBahan & " SUM(DECODE(EXTRACT(DAY FROM fddate)," & d & ",qty,0)) day_" & d & ","
Next
strBahan = strBahan & " SUM(qty) AS total, SUM(qty*amtrp) AS ttlrp" & _
		   " FROM src GROUP BY itemcode,fcname,unitofmeasurement,fcba ORDER BY itemcode ASC"

Dim rsBahan
Set rsBahan = Server.CreateObject("ADODB.Recordset")
rsBahan.Open strBahan, connstr, 3

Dim bahanDay(31), bahanTot, bahanNo, bahanCls, bahanTotRp
For d = 1 To 31 : bahanDay(d) = 0 : Next
bahanTot = 0 : bahanNo = 1 : bahanTotRp = 0

Dim strBahan1
strBahan1 = " WITH src AS ( " & _
			" SELECT  " & _
			" i.FCBA, " & _
			" i2.STOCKCODE itemcode, " & _
			" NVL(s.FCNAME, '')            AS fcname, " & _
			" NVL(s.UNITOFMEASUREMENT, '') AS unitofmeasurement, " & _
			" i.SIVDATE                    AS fddate, " & _
			" i2.QUANTITY, " & _
			" sl.AMTPERUNIT                AS totalrp " & _
			" FROM ISSUE i " & _
			" INNER JOIN ISSUEDETAILS i2 ON i2.SIVCODE = i.SIVCODE AND i2.FCBA    = i.FCBA " & _
			" LEFT JOIN STOCK s          ON s.FCCODE   = i2.STOCKCODE  AND s.FCBA     = i.FCBA " & _
			" LEFT JOIN STOCKLEDGER sl   ON sl.ITEMCODE = i2.STOCKCODE AND sl.FCBA     = i.FCBA " & _
			" WHERE i.FCBA " & whereFcba & " AND TO_CHAR(i.SIVDATE, 'yyyy-mm') = '" & CInt(v_absYear) & "-" & strMonth & "' AND s.STOCKGROUPCODE = 101) " & _
			" SELECT itemcode,fcname,unitofmeasurement,fcba,"
For d = 1 To 31
	strBahan1 = strBahan1 & " SUM(DECODE(EXTRACT(DAY FROM fddate)," & d & ",quantity,0)) day_" & d & ","
Next
strBahan1 = strBahan1 & " SUM(quantity) AS total, SUM(totalrp * quantity) AS ttlrp" & _
		   " FROM src GROUP BY itemcode,fcname,unitofmeasurement,fcba ORDER BY itemcode ASC"

'response.write strBahan1
Dim rsBahan1
Set rsBahan1 = Server.CreateObject("ADODB.Recordset")
rsBahan1.Open strBahan1, connstr, 3

Dim bahanDay1(31), bahanTot1, bahanNo1, bahanCls1, bahanTotRp1
For d = 1 To 31 : bahanDay1(d) = 0 : Next
bahanTot1 = 0 : bahanNo1 = 1 : bahanTotRp1 = 0

' ===== QUERY VEHICLE =====
Dim strVehicle
strVehicle = "SELECT fcba, kodekendaraan, namakendaraan,"
For d = 1 To 31
	strVehicle = strVehicle & " SUM(DECODE(TO_NUMBER(TO_CHAR(fddate,'dd'))," & d & ",total_km,0)) day_" & d & ","
Next
strVehicle = strVehicle & " SUM(total_km) total_km, status, SUM(amountrp)  amountrp " & _
			 " FROM (SELECT " & _
			"	  b.FCBA, " & _
			"	  e.fccode AS kodekendaraan, " & _
			"	  f.UNITS AS status, " & _
			"	  e.fcname AS namakendaraan, " & _
			"	  b.BKMDATE AS fddate, " & _
			"	  SUM(a.UNIT) AS total_km, " & _
			"	  ROUND(SUM(NVL(b.TOTVRA , 0))) AS amountrp, " & _
			"	  a.BKMNO, " & _
			"	  e.vehiclegroupcode " & _
			"	FROM BKMVEHICLEDTL a " & _
			"	LEFT JOIN BKMHDR b  ON  a.BKMNO = b.BKMNO AND a.FCBA = b.FCBA " & _
			"	LEFT JOIN JOBMASTER C      ON  a.ACTCODE = c.FCCODE " & _
			"	LEFT JOIN JOBGROUPMASTER D ON  c.JOBGROUPCODE = d.FCCODE " & _
			"	LEFT JOIN vehicle e        ON  b.VEHICLECODE = e.FCCODE AND a.FCBA = e.FCBA " & _
			"	LEFT JOIN VEHICLEGROUP f  ON  e.VEHICLEGROUPCODE = f.VEHICLEGROUPCODE AND a.FCBA = f.FCBA " & _
			"	WHERE  b.POSTINGFLG  = 1 AND b.FCBA " & whereFcba & _
			"	  AND  TO_CHAR(b.BKMDATE, 'yyyymm') = " & v_absYear & " || LPAD(" & v_absMonth & ", 2, 0) " & _
			"	  AND  c.JOBGROUPCODE NOT IN ('6210000', '6310000', '1114000') " & _
			"	GROUP BY " & _
			"	  b.FCBA, e.fccode, " & _
			"	  f.UNITS, e.fcname, " & _
			"	  b.BKMDATE, a.BKMNO, e.vehiclegroupcode) " & _
			"GROUP BY fcba, " & _
			"         kodekendaraan, " & _
			"         namakendaraan, " & _
			"         status " & _
			"ORDER BY kodekendaraan ASC "
'response.write strVehicle
Dim rsVehicle
Set rsVehicle = Server.CreateObject("ADODB.Recordset")
rsVehicle.Open strVehicle, connstr, 3

Dim vehicleDay(31), vehicleTot, vehicleTotRp, vehicleNo, vehicleCls
For d = 1 To 31 : vehicleDay(d) = 0 : Next
vehicleTot = 0 : vehicleNo = 1
vehicleTotRp = 0 : vehicleNo = 1
%>

