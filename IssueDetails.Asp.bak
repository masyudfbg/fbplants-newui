<body>
<!--#include file="top.jsp"-->
<div style=" width:21.7%; float:left;margin-left:0.3%; margin-top:0.3%; margin-bottom:0.3%;">
 <!--#include file="menu.asp"-->
</div>
<div class="judul_head" valign="top" bgcolor="#fff" style=" width:77.4%; margin-left:0.3%; margin-right:0.3%; margin-top:0.3%; margin-bottom:0.3%; float:left; border:none;"> 
 	<div class="judul">
	   Module : <%=request("txtModule")%> / <%=request("txtTable")%>
	</div>
 <div class="box_both" style="overflow:scroll;">  
 <%
 '-------------awal-----------------------
 Dim xCode,fcCode,cmdView,PoCode,IssueDate,ITEMCODE,QUANTITY,AMOUNT, LineNoHist
 Dim txtModule,txtTable,txtSearch,txtField,i,q,nCountofField,NO,txtJenis
 Dim Jobcode, LocationType, LocationCode, Remarks, Reference
 Dim qLineMax, rsqLineMax, tempMaxLine
 Dim qTotalRecordOnHand, rsTotalRecordOnHand, tempTotalRecordOnHand
 Dim qQuantityOnHand, rsQuantityOnHand, tempQuantityOnHand, QuantityOriginal
 Dim done, qq  
 Dim qLessZero, rsLessZero, tempislesszero
 Dim qLineUpper, rsqLineUpper, totalUpper
 Dim qQuantity, rsqQuantity, totalQuantity,LineNoKey

 Dim qStockMin, rsqStockMin, stockmin, tempStringError

 Dim monthprev,bulanprevsplit,tglprevsplit,thnprevsplit,tglnow,tglawal
 Dim tglbulanprev,bulanprev_split,tglprev_split,thnprev_split
 

 Dim rsReceiveDetail, txtStoreCode
 Dim v_CrossCekDetail, txtLineNoHist, originalQuantity
 Dim txtItemCodeDelete
 Dim qDeleteHist
 Dim strLineMax, rsstrLineMax, tempMaxLineNo , txtLineNoKey
 Dim Cek_IsDailyClosing : Cek_IsDailyClosing = ""


 txtTable =Request("txtTable")
 txtModule=Request("txtModule")
 txtSearch=Request("txtSearch")
 txtField =Request("txtField")

 if request("fccOde")="" then
    fcCode="" '----- Nantinya Ambil dari Format Master
 else
    fcCode = request("fccOde")
 end if
 
 
 txtJenis = request("txtJenis") '---- Untuk Membedakan Jenis Data Yang akan diolah [insert,edit,delete]
 
 '---- Data Header
 if request("sivdateurl") <>"" then
   IssueDate   = request("sivdateurl")
 elseif Request("IssueDate")<>"" then
   IssueDate   = Request("IssueDate")
 else
   IssueDate   = textDate(date)
 end if

 xCode 		= Request("xCode")

 'monthprev 		 = DateAdd("m", -1, IssueDate)
 tglnow		 	 = IssueDate
 bulanprevsplit  = left(tglnow,2)
 tglprevsplit    = mid(tglnow,4,2)
 thnprevsplit    = right(tglnow,4)

 tglawal 		 = bulanprevsplit & "/" & "01" & "/" & thnprevsplit
 
 'tglbulanprev = DateAdd("m", -1, IssueDate)
 tglbulanprev = IssueDate
 bulanprev_split  = month(tglbulanprev)
 tglprev_split    = day(tglbulanprev)
 thnprev_split    = year(tglbulanprev)

 'Response.Write tglnow1

 
 '---- Data Details
 JobCode=Request("JobCode")
 doc_ref=Request("doc_ref")
 LocationType=Request("LocationType")
 LocationCode=Request("LocationCode")
 Remarks = Request("Remarks")
 Reference = Request("Reference")
 ITEMCODE=Request("ITEMCODE")
 LineNoKey=Request("LineNoKey")
 QUANTITY=Request("QUANTITY")
 AMOUNT =Request("AMOUNT")
 Linenohist = Request ("linenohist")
 
 '--- Action ke Database di Oracle [ insert,edit,delete ]
 if Request("txtJenis")="New" or Request("txtJenis")= "Header" or Request("txtJenis")= "Details" or Request("txtJenis")="Edit" Then
	
	if Request("txtJenis")= "Header" then
	   connstr.BeginTrans
	   Cek_IsDailyClosing = IsDailyClosing(Session("FCBA"), IssueDate)
		If Cek_IsDailyClosing = "FALSE" then
			   If err.number=0 then
				  q="Delete from Issue where  SivCODE='" & fcCode & "' and fcBA='" & Session("fcBA") & "'"
				  connStr.execute(q)
				  if err.number  = 0 then
					 connStr.CommitTrans
				  end if
			   end if
		else
			err.number = 1001
			err.description = "Tanggal """ & IssueDate & """, sudah di closing, sehingga tidak bisa melakukan insert/update/delete data, Silahkan konsultasikan dengan administrator anda"
		End If
       cmdView	= "True"
	elseif Request("txtJenis")= "Details" then
	
	    connstr.BeginTrans
		
		Cek_IsDailyClosing = IsDailyClosing(Session("FCBA"), IssueDate)
		If Cek_IsDailyClosing = "FALSE" then
	   
			q = "Select storecode from Issue where SivCODE='" & fcCode & _
				"' and fcBA='" & Session("fcBA") & "'"
				
				
			Set rsReceiveDetail = Server.CreateObject("ADODB.Recordset")
			rsReceiveDetail.Open q, connstr
					
			IF Not rsReceiveDetail.eof then
				txtStoreCode = rsReceiveDetail("STORECODE")
			End if
			rsReceiveDetail.Close
			set rsReceiveDetail = Nothing		   
		   
		   
			q = "Select stockcode, linenohist, quantity, lineNoKey from IssueDetails where SivCODE='" & fcCode & _
				"' and LineNoKey='" & request("LineNoKey") & _
				"' and STOCKCODE='" & request("ItemCode") & _
				"' and fcBA='" & Session("fcBA") & "' " & _
				"  and linenohist = " & Linenohist
			

			Set rsReceiveDetail = Server.CreateObject("ADODB.Recordset")
			rsReceiveDetail.Open q, connstr
			
		
					
			IF Not rsReceiveDetail.eof then
				txtLineNoHist = rsReceiveDetail("LINENOHIST")
				originalQuantity = rsReceiveDetail("QUANTITY")
				txtItemCodeDelete = rsReceiveDetail("stockcode")
				txtLineNoKey = rsReceiveDetail("LineNoKey")
			End if
			rsReceiveDetail.Close
			set rsReceiveDetail = Nothing			

			v_CrossCekDetail = cmdCheckHist(txtLineNoHist, Request("ItemCode"))
		

				q =  "Delete from stocktranshist " & _
					 "where " & _
					 "lineno = " & txtLineNoHist & " and " & _
					 "fcba = '" & Session("fcBA") & "'"
			
				connStr.execute(q)
							
									
				q="Delete from IssueDetails where  SivCODE='" & fcCode & "' and LineNoKey=" & LineNoKey & " and fcBA='" & Session("fcBA") & "'" & _
				   "  and linenohist = " & Linenohist
				connStr.execute(q)
				if err.number  = 0 then
				   connStr.CommitTrans
				end if
		else
			err.number = 1001
			err.description = "Tanggal """ & IssueDate & """, sudah di closing, sehingga tidak bisa melakukan insert/update/delete data, Silahkan konsultasikan dengan administrator anda"
		End If

		cmdView	= "True"
	elseif Request("txtJenis")="New" then
	  connstr.BeginTrans	  
		Cek_IsDailyClosing = IsDailyClosing(Session("FCBA"), IssueDate)
		If Cek_IsDailyClosing = "FALSE" then
			  Dim rsPO
			  Set rsPO = Server.CreateObject("ADODB.Recordset")
			  rsPO.Open "Select sivcode from Issue where SIVCODE='" & fcCode & "'AND FCBA = '" & Session("FCBA") & "'", connstr
			  IF rsPO.eof then	    
			  
				 q="Insert into Issue (SIVCODE, DOC_REF, STORECODE, SIVDATE, FCENTRY, FCEDIT, FCIP, FCBA, LASTUPDATE, LASTTIME) " & _
				 "values ('" & fcCode & "','" &  DOC_REF & "','" &  xCode & "', to_date('" & IssueDate & "','mm/dd/yyyy') " & _
				 ",'" &  Session("CodeName") & "','" & Session("CodeName") & "','" & _
				 Request.ServerVariables("REMOTE_ADDR") &"','" & Session("fcBA") & "', sysdate, To_Char(sysdate,'HH24:MI'))"
				 connStr.execute(q)
				 'response.Write(q)
			  End if
			  rsPO.Close
				
				' Add by NAF to handle Inventory Stock On Hand
				' Insert the History of Received Inventory Transaction
				
				qLessZero = "select islesszero from stock " & _	   
					"where " & _
					"fccode = '" & ITEMCODE & "' and " & _
					"fcba = '" & session("fcBA") & "'" 
				
				set rsLessZero = Server.CreateObject("ADODB.Recordset")
				rsLessZero.Open qLessZero, connstr
				if not rsLessZero.eof then
					tempislesszero = rsLessZero("islesszero")
				else
					tempislesszero = "FALSE"
				end if 
					
			

				qQuantityOnHand = "select sum(nvl(t.openingbalanceqty,0)) as openingbalanceqty,sum(nvl(t.receivenoteqty,0)) as receivenoteqty, " & _
				" sum(nvl(t.issueqty,0)) as issueqty,sum(nvl(t.quantitytransfered,0)) as quantitytransfered,sum(nvl(t.quantityreceived,0)) as quantityreceived," & _
				" (sum(nvl(t.openingbalanceqty,0))+sum(nvl(t.receivenoteqty,0))-sum(nvl(t.issueqty,0))-sum(nvl(t.quantitytransfered,0))+sum(nvl(t.quantityreceived,0))+sum(nvl(t.qtywriteoff,0))) as qty " & _
				" from( " & _
				"		select nvl(l.openingbalanceqty,0) openingbalanceqty, 0 as receivenoteqty,0 as issueqty,0 as quantitytransfered,0 as quantityreceived,0 as qtywriteoff " & _
				"		from stockledger l " & _
				" 		where l.YEAR='" & thnprev_split & "' and l.MONTH='" & bulanprev_split & "' and l.fcba='" & session("fcBA") & "' " & _
				"		AND l.itemcode='" & ITEMCODE & "' union all  " & _
				"		select 0 as openingbalanceqty,nvl(rd.quantity,0) quantity,0 as issueqty, " & _
				"		0 as quantitytransfered,0 as quantityreceived,0 as qtywriteoff " & _
				"		from receivenote r,receivenotedetail rd " & _
				"		where r.receivenotecode=rd.receivenotecode and r.rndate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy') and r.fcba='" & session("fcBA") &"' " & _
				"		and r.storecode='" & xCode & "' and rd.purchaseitemcode='" & ITEMCODE & "' " & _
				"		union all  " & _
				"		select 0 as openingbalanceqty,0 as receivenoteqty,nvl(d.quantity,0) quantity,0 as quantitytransfered, 0 as quantityreceived,0 as qtywriteoff  " & _
				"		from issue h,issuedetails d  " & _
				"		where h.sivcode=d.sivcode and h.fcba='" & session("fcBA") &"' and h.sivdate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy')  " & _
				" 		and h.storecode='" & xCode & "' and d.STOCKCODE='" & ITEMCODE & "' " & _
				"		union all  " & _
				"		select 0 as openingbalanceqty,0 as receivenoteqty,0 as issueqty,nvl(d.quantitytransfered,0) quantitytransfered,0 as quantityreceived,0 as qtywriteoff " & _
				"		from transporttaskdtl_tab d,transporttask_tab h  " & _
				"		where h.orderno=d.orderno and h.fcba='" & session("fcBA") &"' AND h.orderdate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy')  " & _
				"		and d.storecode='" & xCode & "' and d.STOCKCODE='" & ITEMCODE & "' " & _
				"		union all  " & _
				"		select 0 as openingbalanceqty,0 as receivenoteqty,0 as issueqty,0 as quantitytransfered,nvl(d.quantityreceived,0) quantityreceived,0 as qtywriteoff  " & _
				"		from receivedtask_tab h,receivedtaskdtl_tab d " & _
				"		where h.orderno=d.orderno and h.orderdate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy') and h.fcba='" & session("fcBA") &"'  " & _
				"		and d.locationcode='" & xCode & "' and d.STOCKCODE='" & ITEMCODE & "' " & _
				"  			UNION ALL " & _
				" 		select 0 as openingbalanceqty,0 as receivenoteqty,0 as issueqty,0 as quantitytransfered, " & _
				" 		0 as quantityreceived,nvl(d.quantity,0)  as qtywriteoff  " & _
				" 		from writeoff h,writeoffdetails d " & _
				" 		where h.writeoffcode=d.writeoffcode and h.wodate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy') and h.fcba='" & session("fcBA") & "' " & _ 
				"	)t  "

			'	Response.Write qQuantityOnHand
								  
				set rsQuantityOnHand = Server.CreateObject("ADODB.Recordset")
				rsQuantityOnHand.Open qQuantityOnHand, connstr
				if not rsQuantityOnHand.eof then
					tempQuantityOnHand = cdbl(rsQuantityOnHand("qty"))
				else
					tempQuantityOnHand = 0
				end if 		

				qStockMin = "select nvl(min_value,0) stockmin from stock " & _
							"where fccode = '"& ITEMCODE &"'" & _
							"and fcba = '" & session("fcBA") & "'" 
					
					set rsqStockMin = Server.CreateObject("ADODB.Recordset")
					rsqStockMin.Open qStockMin, connstr
					if not rsqStockMin.eof then
						stockmin = cdbl(to_nol(rsqStockMin("stockmin")))
					else
						stockmin = 0
					end if 	
				
				if (tempQuantityOnHand - Quantity >= 0) or tempislesszero = "TRUE"  then 

					' Added By Sendy 12/03/2018
					' qStockMin = "select nvl(min_value,0) stockmin from stock " & _
					' 			"where fccode = '"& ITEMCODE &"'" & _
					' 			"and fcba = '" & session("fcBA") & "'" 
					
					' set rsqStockMin = Server.CreateObject("ADODB.Recordset")
					' rsqStockMin.Open qStockMin, connstr
					' if not rsqStockMin.eof then
					' 	stockmin = cdbl(to_nol(rsqStockMin("stockmin")))
					' else
					' 	stockmin = 0
					' end if 	

					if (tempQuantityOnHand - Quantity < stockmin ) then 
						tempString = "Anda sudah melewati batas stock minimum, silahkan order barang lagi."				 
						response.Write  "<font color=#000000 pointsize=9 face=Arial, Helvetica, sans-serif>" & tempString & "</font>"
					' response.write quantity
					' response.write stockmin
					End if 
				
					qLineMax = "select nvl(max(lineno),0) tempMaxLine from stocktranshist " & _
					"where " & _
					"fcba = '" & session("fcBA") & "'" 
					
					set rsqLineMax = Server.CreateObject("ADODB.Recordset")
					rsqLineMax.Open qLineMax, connstr
					if not rsqLineMax.eof then
						tempMaxLine = cdbl(rsqLineMax("tempMaxLine"))
					else
						tempMaxLine = 0
					end if 

					tempMaxLine = tempMaxLine + 1
						
					
					q = "Insert into StockTransHist ( " & _
						" LINENO, FCBA, DOCUMENTNO, STOCKCODE, TRANSDATE, TRANSTYPE, STORECODE, SOURCETYPE, SOURCECODE, TARGETTYPE, TARGETCODE, QUANTITY, LASTUPDATE, LASTTIME) values ( "& _
						  tempMaxLine & ",'" & _ 
						  session("fcBA") & "','" & _
						  fccode & "','" & _
						  ITEMCODE &"'," & _
						  "to_date('" & IssueDate & "','mm/dd/yyyy') ,'" & _
						  "ST_ISSUED" & "','" & _
						  xCode & "'," & _
						  "'ST','" & _
						  xCode & "','" & _
						  LOCATIONTYPE & "','" & _
						  LOCATIONCODE & "'," & _
						  -1 * Quantity & ", sysdate, To_Char(sysdate,'HH24:MI') ) "
													
					connStr.execute(q)
					
					
					' Added by NAF, 2012-12-01
					 strLineMax = " select nvl(max(linenokey),0) maxLineNoKey from IssueDetails " & _
							   " where " & _
							   " fcba = '" & Session("fcBA") & "'"
							   
				  
				
					Set rsstrLineMax = Server.CreateObject("ADODB.Recordset")
					rsstrLineMax.CursorType = 3
					rsstrLineMax.CursorLocation = 3
					rsstrLineMax.Open strLineMax, connstr
					
					if not rsstrLineMax.eof then
						tempMaxLineNo = cdbl(rsstrLineMax("maxLineNoKey")) + 1
					end if
								
					rsstrLineMax.Close
					set rsstrLineMax = Nothing 
					' End of Added by NAF, 2012-12-01

					q=  "Insert into  IssueDetails (SIVCODE, STOCKCODE, LOCATIONCODE, LOCATIONTYPE, QUANTITY, PRICE, AMOUNT, " & _
						"JOBCODE, REFERENCE, REMARKS, FCENTRY, FCEDIT, FCIP, FCBA, linenohist, LineNoKey, LASTUPDATE, LASTTIME ) " & _
						"values ('" & fcCode & "','" & ITEMCODE & "','"  &  LOCATIONCODE & "','" & LOCATIONTYPE & "'" & _
						",'" & Quantity & "',0,0,'" & Jobcode & "','" &  Reference & "','" & Remarks & "','" & Session("CodeName")  & "','" & Session("CodeName") & "','" & _
						Request.ServerVariables("REMOTE_ADDR") &"','" & Session("fcBA") & "',"& tempMaxLine & "," &tempMaxLineNo & ", sysdate, To_Char(sysdate,'HH24:MI') )"
						' response.Write(q)
					
					connStr.execute(q)

					if err.number  = 0 then
						connStr.CommitTrans
					end if

					else
					done = 1		
				end if

		else
			err.number = 1001
			err.description = "Tanggal """ & IssueDate & """, sudah di closing, sehingga tidak bisa melakukan insert/update/delete data, Silahkan konsultasikan dengan administrator anda"
		End If
        cmdView	= "True"
		
	elseif Request("txtJenis")="Edit" and Request("Add")="Update" then
	    connstr.BeginTrans
		
		Cek_IsDailyClosing = IsDailyClosing(Session("FCBA"), IssueDate)
		If Cek_IsDailyClosing = "FALSE" then
		
			
			totalUpper = 0
			
			qLineUpper =   "select count(*) totalUpper from stocktranshist " & _
						   "where " & _
						   "lineno > " & linenohist & " and " & _
						   "fcba = '" & Session("fcBA") & "' and " & _
						   "stockcode = '" & ItemCode & "' " 
						   
			'response.write qLineUpper
			set rsqLineUpper = Server.CreateObject("ADODB.Recordset")
			rsqLineUpper.Open qLineUpper, connstr
			
			if not rsqLineUpper.eof then
				totalUpper = cdbl(rsqLineUpper("totalUpper"))
			else
				totalUpper = 0
			end if 

				
				qQuantity = "select quantity  from stocktranshist " & _
					"where " & _
					"lineno = " & linenohist & " and " & _ 
					"fcba = '" & Session("fcBA") & "'"
					
				
				set rsqQuantity= Server.CreateObject("ADODB.Recordset")
				rsqQuantity.Open qQuantity, connstr

				if not rsqQuantity.eof then
					totalQuantity = cdbl(rsqQuantity("quantity"))
				else
					totalQuantity = 0
				end if 
				
				' Add by NAF to handle Inventory Stock On Hand
				' Insert the History of Received Inventory Transaction
				

				
				qLessZero = "select islesszero from stock " & _	   
					"where " & _
					"fccode = '" & ITEMCODE & "' and " & _
					"fcba = '" & session("fcBA") & "'" 
				
				
				set rsLessZero = Server.CreateObject("ADODB.Recordset")
				rsLessZero.Open qLessZero, connstr
				if not rsLessZero.eof then
					tempislesszero = rsLessZero("islesszero")
				else
					tempislesszero = "FALSE"
				end if 

				
				
				qQuantityOnHand = "select sum(nvl(t.openingbalanceqty,0)) as openingbalanceqty,sum(nvl(t.receivenoteqty,0)) as receivenoteqty, " & _
				" sum(nvl(t.issueqty,0)) as issueqty,sum(nvl(t.quantitytransfered,0)) as quantitytransfered,sum(nvl(t.quantityreceived,0)) as quantityreceived," & _
				" (sum(nvl(t.openingbalanceqty,0))+sum(nvl(t.receivenoteqty,0))-sum(nvl(t.issueqty,0))-sum(nvl(t.quantitytransfered,0))+sum(nvl(t.quantityreceived,0))+sum(nvl(t.qtywriteoff,0))) as qty " & _
				" from( " & _
				"		select l.openingbalanceqty, 0 as receivenoteqty,0 as issueqty,0 as quantitytransfered,0 as quantityreceived,0 as qtywriteoff " & _
				"		from stockledger l " & _
				" 		where l.YEAR='" & thnprev_split & "' and l.MONTH='" & bulanprev_split & "' and l.fcba='" & session("fcBA") & "' " & _
				"		AND l.itemcode='" & ITEMCODE & "' union all  " & _
				"		select 0 as openingbalanceqty,rd.quantity,0 as issueqty, " & _
				"		0 as quantitytransfered,0 as quantityreceived,0 as qtywriteoff " & _
				"		from receivenote r,receivenotedetail rd " & _
				"		where r.receivenotecode=rd.receivenotecode and r.rndate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy') and r.fcba='" & session("fcBA") &"' " & _
				"		and r.storecode='" & xCode & "' and rd.purchaseitemcode='" & ITEMCODE & "' " & _
				"		union all  " & _
				"		select 0 as openingbalanceqty,0 as receivenoteqty,d.quantity,0 as quantitytransfered, 0 as quantityreceived,0 as qtywriteoff  " & _
				"		from issue h,issuedetails d  " & _
				"		where h.sivcode=d.sivcode and h.fcba='" & session("fcBA") &"' and h.sivdate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy')  " & _
				" 		and h.storecode='" & xCode & "' and d.STOCKCODE='" & ITEMCODE & "' " & _
				"		union all  " & _
				"		select 0 as openingbalanceqty,0 as receivenoteqty,0 as issueqty,d.quantitytransfered,0 as quantityreceived,0 as qtywriteoff " & _
				"		from transporttaskdtl_tab d,transporttask_tab h  " & _
				"		where h.orderno=d.orderno and h.fcba='" & session("fcBA") &"' AND h.orderdate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy')  " & _
				"		and d.storecode='" & xCode & "' and d.STOCKCODE='" & ITEMCODE & "' " & _
				"		union all  " & _
				"		select 0 as openingbalanceqty,0 as receivenoteqty,0 as issueqty,0 as quantitytransfered,d.quantityreceived,0 as qtywriteoff  " & _
				"		from receivedtask_tab h,receivedtaskdtl_tab d " & _
				"		where h.orderno=d.orderno and h.orderdate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy') and h.fcba='" & session("fcBA") &"'  " & _
				"		and d.locationcode='" & xCode & "' and d.STOCKCODE='" & ITEMCODE & "' " & _
				"  			UNION ALL " & _
				" 		select 0 as openingbalanceqty,0 as receivenoteqty,0 as issueqty,0 as quantitytransfered, " & _
				" 		0 as quantityreceived,d.quantity as qtywriteoff  " & _
				" 		from writeoff h,writeoffdetails d " & _
				" 		where h.writeoffcode=d.writeoffcode and h.wodate between to_date('" & tglawal & "','mm/dd/yyyy') and to_date('" & IssueDate & "','mm/dd/yyyy') and h.fcba='" & session("fcBA") & "' " & _ 
				"	)t  "
								  
				'response.write 	qQuantityOnHand			  
				set rsQuantityOnHand = Server.CreateObject("ADODB.Recordset")
				rsQuantityOnHand.Open qQuantityOnHand, connstr
				if not rsQuantityOnHand.eof then
					QuantityOriginal = cdbl(rsQuantityOnHand("qty"))
				else
					QuantityOriginal = 0
				end if 	
				


				if ((tempislesszero = "TRUE") or ((QuantityOriginal - totalQuantity - Quantity) >= 0)) then 
				
					qDeleteHist = "delete stocktranshist " & _
					" where " & _
					" lineno = " & linenohist & " and " & _ 
					" fcba = '" & Session("fcBA") & "'"
					

					connStr.execute(qDeleteHist)


					qq = "Insert into StockTransHist ( " & _
						" LINENO, FCBA, DOCUMENTNO, STOCKCODE, TRANSDATE, TRANSTYPE, STORECODE, SOURCETYPE, SOURCECODE, TARGETTYPE, TARGETCODE, QUANTITY, LASTUPDATE, LASTTIME) values ( "& _
						  linenohist & ",'" & _ 
						  session("fcBA") & "','" & _
						  fccode & "','" & _
						  ITEMCODE &"'," & _
						  "to_date('" & IssueDate & "','mm/dd/yyyy') ,'" & _
						  "ST_ISSUED" & "','" & _
						  xCode & "'," & _
						  "'ST','" & _
						  xCode & "','" & _
						  LOCATIONTYPE & "','" & _
						  LOCATIONCODE & "'," & _
						  -1 * Quantity & ", sysdate, To_Char(sysdate,'HH24:MI') ) "
													
					connStr.execute(qq)
			   
			   
			   
					q = " Update IssueDetails set" & _
						"     Quantity = " & Quantity & _
						"     , REFERENCE = '" & Reference & "'" & _
						"     , JobCode = '" & JobCode & "'" & _
						"     , Locationtype = '" & Locationtype & "'" & _
						"     , Locationcode = '" & Locationcode & "'" & _
						"     , REMARKS = '" & Remarks & "'" & _
						"     , LASTUPDATE = sysdate " & _
						"     , LASTTIME = To_Char(sysdate,'HH24:MI') " & _
						" where SIVCODE = '" & fcCode & "' and StockCode = '" & ItemCode & "' and fcBA = '" & Session("fcBA") & "' and linenokey ='"& linenokey &"'"
					' response.write q
					connStr.execute(q)
					
					
					if err.number  = 0 then
						connStr.CommitTrans
					end if
				else
					done = 1
				end if
		else
			err.number = 1001
			err.description = "Tanggal """ & IssueDate & """, sudah di closing, sehingga tidak bisa melakukan insert/update/delete data, Silahkan konsultasikan dengan administrator anda"
		End If
			
        cmdView	= "True"
    else
        cmdView	= "True"
	end if								 
	'Response.Write "sql " & q
 else
    cmdView	= request("cmdView")
 End if

 Dim rsPurchase
 set rsPurchase = server.CreateObject("Adodb.recordset")
 q="select to_char(SivDate,'mm/dd/yyyy') SivDate,StoreCode from Issue  " & _
  " where SivCode='" & fcCode & "' and " & _
  " fcBA='" & session("fcBA") & "'"
 rsPurchase.Open q, connstr
 if Not rsPurchase.Eof then
    IssueDate=rsPurchase("SivDate")
	xCode=rsPurchase("StoreCode")
 End if
 if done = 1 then 
	connStr.RollbackTrans   
	err.description = "Nilai Quantity tidak boleh Negatif atau Saldo belum didefinisikan"
	response.Write  "<div class = ""error"">" & err.description & "</div>"
 end if
 if done = 2 then 
	connStr.RollbackTrans   
	err.description = "Terdapat transaksi setelah data ini, harap menghapus transaksi setelah ini"
	response.Write  "<div class = ""error"">" & err.description & "</div>"
 end if
 if err.number <> 0 then
   connStr.RollbackTrans   
   response.Write  "<div class = ""error"">" & err.description & "</div>"
 End if
 '-------------ISI Payment Form
 
Dim val_IsTrue : val_IsTrue = "N"
Dim oRecordSet, oSQLQuery
oSQLQuery = " select 'Y' istrue" & _
            " from periodcontrol" & _
	        " where fcba = '" & Session("fcBA") & "'" & _
	        "       and to_date ('" & IssueDate & "', 'mm/dd/yyyy') >= currentdate" & _
	        "       and to_date ('" & IssueDate & "', 'mm/dd/yyyy') <= last_day(add_months(currentdate, 1))" & _
	        "       and upper(system) = upper('Stores')"
			
set oRecordSet = server.CreateObject("Adodb.recordset")
oRecordSet.Open oSQLQuery, connstr
If Not oRecordSet.Eof then
	val_IsTrue = oRecordSet("istrue")
Else
	val_IsTrue = "N"
End if
'response.Write oSQLQuery
oRecordSet.Close
Set oRecordSet = Nothing

	' Added By Sendy untuk validasi menu 11/17/2018
	Dim Menu : Menu = "N"
	Dim oRecordSetMenu, oSQLQueryMenu
	oSQLQueryMenu = " SELECT 'Y' istrue FROM users_tab " & _
				" WHERE fccode = '" & Session("CodeName") & "' AND MENU_ISSUE = 'TRUE'" 
	' response.write oSQLQueryMenu
	set oRecordSetMenu = server.CreateObject("Adodb.recordset")
	oRecordSetMenu.Open oSQLQueryMenu, connstr
	If Not oRecordSetMenu.Eof then
		Menu = oRecordSetMenu("istrue")
	Else
		Menu = "N"
	End if
	' End
