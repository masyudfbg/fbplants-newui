                <font face="Verdana" size="1">Location Code</font> <span class="satuan_item" id="locationname">&nbsp;</span></a></td></tr>
			
			<input type="hidden" size="15" name="LineNoKey" value="<%=LineNoKey%>" readonly="True" style="background:#999999">
