                         "            , nvl(field_api.getvalid_ha (fccode, fcba, to_date(" & Year(Session("v_General_Charges")) & "||lpad(" & Month(Session("v_General_Charges")) & ",2,'0')||'01','yyyymmdd')), 0) unit" & _
