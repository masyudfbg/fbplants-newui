					 <td align="left">10<select name="D_10"><%cmdCallCombo "WORKINGTIME",rsSetup("D_10"),"",""%></select></td>
					 <td align="left">20<select name="D_20"><%cmdCallCombo "WORKINGTIME",rsSetup("D_20"),"",""%></select></td>
