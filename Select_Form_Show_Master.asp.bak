				<option value="<%=rsGroupA("FCCODE")%>" selected><%=rsGroupA("FCNAME")%></option> 
			<%End If%>
			<%rsGroupA.movenext
			loop
			End if
			rsGroupA.Close
			set rsGroupA = Nothing
			q=""
			%>
