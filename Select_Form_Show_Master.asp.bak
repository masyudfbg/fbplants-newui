            q = " SELECT p.fccode, p.fcname FROM parameter p WHERE p.parcode = 'E0103' and fcba = '" & Session("fcBA") & "' ORDER BY p.fccode"
            Set rsPrevious = Server.CreateObject("ADODB.Recordset")
