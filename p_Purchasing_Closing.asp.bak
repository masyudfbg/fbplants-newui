					' connStr.execute("Commit")
					
					' post_hutang_supplier = 0
					' post_hutang_supplier = cdbl(to_nol(rsReceive2("amount")))					
					
					' rsReceive2.MoveNext
			  ' loop
			' End if
			
			' qReceiveCR = " SELECT " & _
						' " hdr.fcba " & _ 
						' " , dtl.invoiceno invoicecode " & _ 
						' " , hdr.transdate invoicedate " & _
						' " , hdr.suppliername SUPPLIERCODE " & _ 
						' " , supp.controljob controljob " & _
						' " , parameterdetail.param_1 jobcode " & _
						' " , job.job_category targettype " & _
						' " , gcmaster.fccode targetcode " & _
						' " , dtl.description description " & _
						' " , round(NVL(dtl.totalamount,0),2) amount " & _
						' " , round(NVL(dtl.othercost,0),2) othercost " & _ 
						' " , NVL(hdr.ppn,0) ppn " & _
						' " , NVL(hdr.pph,0) pph " & _
						' " FROM invoiceservicedtl dtl " & _
						' " INNER JOIN invoiceservicehdr hdr ON (dtl.invoiceno = hdr.invoiceno AND dtl.fcba = hdr.fcba) " & _
						' " INNER JOIN parameterdetail ON DTL.FCBA = parameterdetail.fcba AND parameterdetail.parheadcode = 'CONTROLJOB_MODULE' " & _
						' " AND parcode='HARDCODE' and fccode = 'PURCHASE' " & _
						' " INNER JOIN supplier supp ON (hdr.suppliername = supp.fccode AND hdr.fcba = supp.fcba) " & _
						' " INNER JOIN job ON (dtl.fcba = job.fcba AND parameterdetail.param_1 = job.fccode) " & _
						' " INNER JOIN gcmaster ON (DTL.FCBA = gcmaster.fcba AND gcmaster.item = job.job_category) " & _
						' " WHERE TO_NUMBER(TO_CHAR(hdr.transdate,'mm')) = '" & Month(Session("v_Purchase")) & "'" &  _
						' "       AND TO_NUMBER(TO_CHAR(hdr.transdate,'yyyy')) = '" & Year(Session("v_Purchase")) & "'" & _
						' "       AND hdr.fcba = '" & Session("fcBA") & "'" & _
						' "       AND hdr.invoice_type <> 'TBS'" 
			
			' 'response.write qReceiveCR
			
			' Set rsReceiveCR = Server.CreateObject("ADODB.Recordset")
			' rsReceiveCR.Open qReceiveCR, connstr
			' if not rsReceiveCR.eof then
			   ' Do While Not rsReceiveCR.eof
			   
					' maxLineNo = maxLineNo + 1
					' qCost_ActivityCR3="Insert into Cost_Activity " & _
								 ' "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
								 ' "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA,  closing_date, process_date, " & _
								 ' " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
								 ' " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
								 ' " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
								 ' " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
								 ' " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
								 ' " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
								 ' " LASTUPDATE, LASTTIME ) " & _
								 ' " values (" & maxLineNo & ", to_date('" & rsReceiveCR("INVOICEDATE") & "','mm/dd/yyyy') " & ",'" & rsReceiveCR("jobcode") & "','PR','" & "PR" & "','" & rsReceiveCR("INVOICECODE") & "'," & _
								 ' "'" &  rsReceiveCR("description") & "','" & rsReceiveCR("targettype") & "','" & rsReceiveCR("targetcode") & "'," & _
								 ' -1*cdbl(to_nol(rsReceiveCR("amount"))) & ",'" & rsReceiveCR("INVOICECODE") & "', 0,0,'" & rsReceiveCR("fcba") & "',"  & _
								 ' " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
								 ' " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', 'CB','Cr'),'"  & rsReceiveCR("SUPPLIERCODE") & "'," & _
								 ' " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', 'CB','Cr'),'"  & rsReceiveCR("INVOICECODE") & "'," & _
								 ' " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', 'CB','Cr'),'"  & rsReceiveCR("description") & "'," & _
								 ' " '',''," & _
								 ' " '','','Dr', " & _
								 ' Month(Session("v_Purchase")) & ", " & _
								 ' Year(Session("v_Purchase")) & ", " & _	
								 ' " sysdate, to_char(sysdate,'HH24:MI')) "
								 
					' 'response.write qCost_ActivityCR3&"<br>"
					' response.Flush()
					' connstr.execute(qCost_ActivityCR3)
					' connStr.execute("Commit")
					
					' rsReceiveCR.MoveNext
			  ' loop
			' End if			   
		'--end if
		%>
		<br><br>
		<%
		' Get the Prefix of Purchase Request

		q = " select to_char(add_months( to_date('" & Session("v_Purchase") & "','MM/DD/YYYY') ,1),'YY') tempDateYear, to_char(add_months(to_date('" & Session("v_Purchase") & "','MM/DD/YYYY') ,1),'MM') tempDateMonth from dual"
	    Set rsDate = Server.CreateObject("ADODB.Recordset")
		rsDate.CursorType = 3
		rsDate.CursorLocation = 3
		 'response.Write(q)
		rsDate.Open q, connstr
		if not rsDate.eof then
		    tempDateYear = rsDate("tempDateYear")
			tempDateMonth = rsDate("tempDateMonth")
		else
		    tempDateYear = ""
			tempDateMonth = ""
		end if
		
		rsDate.close
		set rsDate = Nothing

		tempPrefix = Session("fcBA") & tempDateYear &  tempDateMonth
		tempSuffix = ""
		tempLengthPad = 3
		q = "begin ControlNumber_Api.Generate_Data ('PURCHASEREQUEST',add_months(to_date('" & Session("v_Purchase") & "','MM/DD/YYYY'),1),'" & _ 
		                                            tempPrefix & "','" & tempSuffix & "'," & _
													tempLengthPad & ",'" &  Session("fcBA") & "','" & Session("CodeName") & "','" & _
													Session("CodeName") & "','" & Request.ServerVariables("REMOTE_ADDR") & "'); end;" 
	    ' response.write q
		connStr.execute(q)			
         
		tempPrefix = "DOC" & Session("fcBA") & tempDateYear &  tempDateMonth
		tempSuffix = ""
		tempLengthPad = 3
		q = "begin ControlNumber_Api.Generate_Data ('UPLOADPO',add_months(to_date('" & Session("v_Purchase") & "','MM/DD/YYYY'),1),'" & _ 
		                                            tempPrefix & "','" & tempSuffix & "'," & _
													tempLengthPad & ",'" &  Session("fcBA") & "','" & Session("CodeName") & "','" & _
													Session("CodeName") & "','" & Request.ServerVariables("REMOTE_ADDR") & "'); end;" 
	    'response.write q
		connStr.execute(q)	 
	     
		
		' Format Grn No adalah GRNKSBTTMMXXXX
		tempPrefix = "GRN" &  Session("fcBA") & tempDateYear & "" & tempDateMonth 
		tempSuffix = ""
		tempLengthPad = 4
		q = "begin ControlNumber_Api.Generate_Data ('RECEIVENOTE',add_months(to_date('" & Session("v_Purchase") & "','MM/DD/YYYY'),1),'" & _ 
		                                            tempPrefix & "','" & tempSuffix & "'," & _
													tempLengthPad & ",'" &  Session("fcBA") & "','" & Session("CodeName") & "','" & _
													Session("CodeName") & "','" & Request.ServerVariables("REMOTE_ADDR") & "'); end;" 
	    connStr.execute(q)											

													
													
		txtLastDay  =FormatDateTime(LastDayOfMonth(Session("v_Purchase"),"2"),2)
		txtNextMonth=FormatDateTime(LastDayOfMonth(Session("v_Purchase"),"2")+1,2)
		
		' Add By Akbar 18 Desemeber 2015
		
			Dim QAccountPeriod,rsAccountPeriod,temp_NextCloseAccountingPeriod, temp_NextCloseAccountingYear, temp_NextCurrentAccountingPeriod, temp_NextCurrentAccountingYear,temp_EndingAccountingPeriod
				
			QAccountPeriod	=	" select periodcontrol_api.GetNextCloseAccountingPeriod(system,fcba) NextCloseAccountingPeriod ,  " & _ 
								" periodcontrol_api.GetNextCloseAccountingYear(system,fcba) NextCloseAccountingYear ,  " & _ 
								" periodcontrol_api.GetNextCurrentAccountingPeriod(system,fcba) NextCurrentAccountingPeriod ,  " & _ 
								" periodcontrol_api.GetNextCurrentAccountingYear(system,fcba) NextCurrentAccountingYear,  " & _ 
								" periodcontrol_api.GetEndingAccountingPeriodTY(system,'" & Session("fcBA") & "')  EndingAccountingPeriod " & _ 
								" from periodcontrol p  " & _ 
								" where UPPER(system) ='PURCHASE' and fcba='" & Session("fcBA") & "'"
			Set rsAccountPeriod = Server.CreateObject("ADODB.Recordset")
				rsAccountPeriod.CursorType = 3
				rsAccountPeriod.CursorLocation = 3
				rsAccountPeriod.Open QAccountPeriod, connstr
				if not rsAccountPeriod.eof then
					temp_NextCloseAccountingPeriod =  Cint(rsAccountPeriod("NextCloseAccountingPeriod"))
					temp_NextCloseAccountingYear   =  Cint(rsAccountPeriod("NextCloseAccountingYear"))
					temp_NextCurrentAccountingPeriod = Cint(rsAccountPeriod("NextCurrentAccountingPeriod"))
					temp_NextCurrentAccountingYear = Cint(rsAccountPeriod("NextCurrentAccountingYear"))
					temp_EndingAccountingPeriod = Cint(rsAccountPeriod("EndingAccountingPeriod"))
				else
					Response.Write  "<font face=Verdana size=1 color=red>" & "SAC Plant Error, No PERIODCONTROL for PURCHASE " & "<br>"
				end if
			rsAccountPeriod.close
			set rsAccountPeriod = Nothing		
			
			IF temp_NextCurrentAccountingPeriod < 12   THEN
			
				q=" Update PeriodControl Set LASTPERIODPOSTED=last_day(add_months(LASTPERIODPOSTED,1)),CURRENTDATE=add_months(CURRENTDATE,1) " & _ 
				   " ,CloseAccountingPeriod = " & temp_NextCloseAccountingPeriod & " " & _  
				  " ,CloseAccountingYear = " & temp_NextCloseAccountingYear & " " & _  
				  " ,CurrentAccountingPeriod = " & temp_NextCurrentAccountingPeriod & " " & _  
				  " ,CurrentAccountingYear = " & temp_NextCurrentAccountingYear & " " & _   
				  " ,lastupdate = sysdate, lasttime = to_char(sysdate, 'hh24:mi') " & _
				  " where UPPER(system) ='PURCHASE' and fcba='" & Session("fcBA") & "'"
			ELSE
			    IF temp_NextCloseAccountingPeriod < 12 THEN
				   q=" Update PeriodControl Set LASTPERIODPOSTED=last_day(add_months(LASTPERIODPOSTED,1)) ,CURRENTDATE=add_months(CURRENTDATE,1) " & _ 
					  " ,CloseAccountingPeriod = " & temp_NextCloseAccountingPeriod & " " & _  
				  " ,CloseAccountingYear = " & temp_NextCloseAccountingYear & " " & _  
				  " ,CurrentAccountingPeriod = " & temp_NextCurrentAccountingPeriod & " " & _  
				  " ,CurrentAccountingYear = " & temp_NextCurrentAccountingYear & " " & _   
					  " ,lastupdate = sysdate, lasttime = to_char(sysdate, 'hh24:mi') " & _
					  " where UPPER(system) ='PURCHASE' and fcba='" & Session("fcBA") & "'"
				ELSE
				   IF temp_NextCloseAccountingPeriod = 12 THEN
						 q=" Update PeriodControl Set LASTPERIODPOSTED=last_day(add_months(LASTPERIODPOSTED,1)) " & _ 
						  " ,CloseAccountingPeriod = " & temp_NextCloseAccountingPeriod & " " & _  
						  " ,CloseAccountingYear = " & temp_NextCloseAccountingYear & " " & _  
						  " ,CurrentAccountingPeriod = " & temp_NextCurrentAccountingPeriod & " " & _  
						  " ,CurrentAccountingYear= " & temp_NextCurrentAccountingYear & " " & _  
						  " ,lastupdate = sysdate, lasttime = to_char(sysdate, 'hh24:mi') " & _
						  " where  UPPER(system) ='PURCHASE' AND fcba='" & Session("fcBA") & "'"
					ELSE
					    q=" Update PeriodControl Set " & _ 
						  " CloseAccountingPeriod = " & temp_NextCloseAccountingPeriod & " " & _  
						  " ,CloseAccountingYear = " & temp_NextCloseAccountingYear & " " & _  
						  " ,CurrentAccountingPeriod = " & temp_NextCurrentAccountingPeriod & " " & _  
						  " ,CurrentAccountingYear= " & temp_NextCurrentAccountingYear & " " & _  
						  " ,lastupdate = sysdate, lasttime = to_char(sysdate, 'hh24:mi') " & _
						  " where  UPPER(system) ='PURCHASE'  AND fcba='" & Session("fcBA") & "'"
					 
                    END IF					
			    END IF
			END IF
			
			IF temp_NextCloseAccountingPeriod = temp_EndingAccountingPeriod AND temp_NextCurrentAccountingPeriod = 1  THEN
			
				q=" Update PeriodControl Set CURRENTDATE=add_months(CURRENTDATE,1) " & _ 
				  " ,CloseAccountingPeriod = " & temp_NextCloseAccountingPeriod & " " & _  
				  " ,CloseAccountingYear = " & temp_NextCloseAccountingYear & " " & _  
				  " ,CurrentAccountingPeriod = " & temp_NextCurrentAccountingPeriod & " " & _  
				  " ,CurrentAccountingYear = " & temp_NextCurrentAccountingYear & " " & _  
				  " ,lastupdate = sysdate, lasttime = to_char(sysdate, 'hh24:mi') " & _
				  " where  UPPER(system) ='PURCHASE' and fcba='" & Session("fcBA") & "'"
				ww = " eMPAT " 
			END IF
			
		connStr.execute(q)


		
		TimeAkhir=Time()
		Lama =TimeAkhir-TimeAwal
		Response.Write "<font color=Black>Finish ... " & time() & "<br><br>"
		Response.Write " Time Elapsed " & Hour(Lama) & " Hours " & Minute(Lama) & " Minutes " &  Second(Lama) & " Seconds."
		
	'--Added by Ukie at 25-Oct-2012--	
	Endingtime = FormatDateTime(CDate(Now))

	qLineMax = "select nvl(max(lineno),0) tempMaxLine from CLOSINGLOG where fcba = '" & session("fcBA") & "' AND SYSTEM = 'Purchase'" 
								
		set rsqLineMax = Server.CreateObject("ADODB.Recordset")
		rsqLineMax.Open qLineMax, connstr
		if not rsqLineMax.eof then
			tempMaxLine = cdbl(rsqLineMax("tempMaxLine"))
		else
			tempMaxLine = 0
		end if 

		tempMaxLine = tempMaxLine + 1

	strClosingLog = " INSERT INTO CLOSINGLOG(SYSTEM, FCBA, STARTINGTIME, ENDINGTIME, LINENO, LASTUPDATE, LASTTIME) VALUES (" & _
					" 'Purchase', " & _
					" '" & Session("fcBA") & "'," & _
					" TO_DATE('" & Startingtime & "', 'mm/dd/yyyy HH:MI:ssam')," & _
					" TO_DATE('" & Endingtime & "', 'mm/dd/yyyy HH:MI:ssam')," & _
					" " & tempMaxLine & "" & _
					" , SYSDATE, TO_CHAR(SYSDATE,'HH24:MI'))"
	connStr.execute(strClosingLog)

	strLenghtime = 	" SELECT" & _
					" FCBA," & _
					" LINENO," & _
					" SYSTEM," & _
					" TO_CHAR(STARTINGTIME, 'DD.MM.YYYY:HH24:MI:SS') STARTINGTIME," & _
					" TO_CHAR(ENDINGTIME, 'DD.MM.YYYY:HH24:MI:SS') ENDINGTIME," & _
					" TRUNC((((86400*(ENDINGTIME-STARTINGTIME))/60)/60)/24) DAYS," & _
					" TRUNC(((86400*(ENDINGTIME-STARTINGTIME))/60)/60)-24*(TRUNC((((86400*(ENDINGTIME-STARTINGTIME))/60)/60)/24)) HRS," & _
					" TRUNC((86400*(ENDINGTIME-STARTINGTIME))/60)-60*(TRUNC(((86400*(ENDINGTIME-STARTINGTIME))/60)/60)) MIN," & _
					" TRUNC(86400*(ENDINGTIME-STARTINGTIME))-60*(TRUNC((86400*(ENDINGTIME-STARTINGTIME))/60)) SEC" & _
					" FROM CLOSINGLOG" & _
					" WHERE FCBA = '" & Session("fcBA") & "' AND LINENO = " & tempMaxLine & " AND SYSTEM = 'Purchase'"
				
	Set rsLenghtime = Server.CreateObject("ADODB.Recordset")
	rsLenghtime.CursorType = 3
	rsLenghtime.CursorLocation = 3
	rsLenghtime.Open strLenghtime, connstr

	upClosingLog = " UPDATE CLOSINGLOG SET" & _
					" LENGTHTIME = '" & rsLenghtime(5) & " Days " & rsLenghtime(6) & " Hours " & rsLenghtime(7) & " Minutes " & rsLenghtime(8) & " Seconds " & "'" & _
					" WHERE FCBA = '" & Session("fcBA") & "' AND LINENO = " & tempMaxLine & " AND SYSTEM = 'Purchase'"		
	connStr.execute(upClosingLog)
	'--End Added--

		%>
		<script language="JavaScript" type="text/javascript" >
		document.getElementById('status_running').style.visibility = 'hidden';
		</script>
		<br><br><img src="images/ok.gif" />Purchasing Closing is completed...
	<%end if
	if err.number <> 0 then
		connStr.RollbackTrans
		response.Write  "<font color=#FF0000 pointsize=9 face=Arial, Helvetica, sans-serif>" & err.description & "</font>"
		cmdView	= "True"%>
		<script language="JavaScript" type="text/javascript" >
		document.getElementById('status_running').style.visibility = 'hidden';
		</script>
		<img src="images/error.gif" />
		 <% fine_result_01 = 0 %>	
	<% else %>
		 <% fine_result_01 = 1 %>	
	 <% End if %>
	 
	 <%
	 if doneReceive <> 1 then 
		connStr.RollbackTrans
		response.Write  "<font color=#FF0000 pointsize=9 face=Arial, Helvetica, sans-serif>Receive String still not defined in PROCESS_TABLEREF_TAB, Call your Administrator </font>"
		cmdView	= "True"%>
		<script language="JavaScript" type="text/javascript" >
		document.getElementById('status_running').style.visibility = 'hidden';
		</script>
		<img src="images/error.gif" />
		 <% fine_result_02 = 0 %>	
	<% else %>
		 <% fine_result_02 = 1 %>	
	<% end if %>

	 <%
	 if doneInvoice <> 1 then 
		connStr.RollbackTrans
		response.Write  "<font color=#FF0000 pointsize=9 face=Arial, Helvetica, sans-serif>Invoice String still not defined in PROCESS_TABLEREF_TAB, Call your Administrator </font>"
		cmdView	= "True"%>
		<script language="JavaScript" type="text/javascript" >
		document.getElementById('status_running').style.visibility = 'hidden';
		</script>
		<img src="images/error.gif" />
		<% fine_result_03 = 0 %>	
	<% else %>
		<% fine_result_03 = 1 %>	
	<% end if %>


	<% 
		if fine_result_01 = 1 and fine_result_02 = 1 and fine_result_03 = 1 then 
			txtLastDay  =cmdFindPeriod("Purchase")
			txtNextMonth=cmdPeriodClose("Purchase")
			
			Session("v_Purchase") = txtLastDay
			Session("cls_Purchase")= txtNextMonth	
		end if
	 
	%> 

	<%
else 
%>
	<script language="JavaScript" type="text/javascript" >
	document.getElementById('status_running').style.visibility = 'hidden';
	</script>
	<br><br><img src="images/error.gif">Purchasing Closing is NOT completed...
	<%
    tempErrorWaterFlow = "Please Check Previous Closing Process, its still not DONE yet"
    response.Write  "<font color=#FF0000 pointsize=9 face=Arial, Helvetica, sans-serif>" & tempErrorWaterFlow & "</font>" %>
	<script language="JavaScript" type="text/javascript" >
	document.getElementById('status_running').style.visibility = 'hidden';
	</script>	
	<img src="images/error.gif" />
<%
end if
%> 


  
</body>
