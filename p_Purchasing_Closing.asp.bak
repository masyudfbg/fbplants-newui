		'--if Session("Estate_Mill") = "HO" then
			'-- Begin Transporter Invoice
			
			'-- Insert Debet 1
			
			'-- INVOICE TRANSPORTER
			Response.Write "<font face='Verdana' size='1' color='black'>" & "Closing Transporter Invoice" & "<br>" : response.flush()
			qTransporterInvDB1 = 	"   SELECT ish.invoicecode," & _
									"          ish.fcba," & _
									"          ish.invoicedate," & _
									"		   to_number(to_char(ish.invoicedate,'MM')) accountingperiod," & _
       								"          to_number(to_char(ish.invoicedate,'YYYY')) accountingyear," & _
									"          ish.transportercode," & _
									"          ish.paid," & _
									"          ish.pocode," & _
									"          ish.stono," & _
									"          isd.amount," & _
									"          ish.pph," & _
									"          ish.amountpph," & _
									"          ish.totalamount," & _
									"          ish.no_faktur," & _
									"          ish.fakturdate," & _
									"          isd.do_no," & _
									"          isd.receivenotecode," & _
									"          isd.itemcode," & _
									"          isd.unitprice," & _
									"          isd.quantity," & _
									"          isd.lineno" & _
									"     FROM invoicestodetail isd" & _
									"          INNER JOIN invoicesto ish" & _
									"             ON (    ish.invoicecode = isd.invoicecode" & _
									"                 AND ish.fcba = isd.fcba" & _
									"                 AND ish.pocode = isd.pocode" & _
									"                 AND ish.stono = isd.stono)" & _
									"    WHERE     TO_NUMBER(TO_CHAR (ish.invoicedate, 'MM')) = '"& Month(Session("v_Purchase")) &"'" & _
									"          AND TO_NUMBER(TO_CHAR (ish.invoicedate, 'yyyy')) = '"& year(Session("v_Purchase")) &"'" & _
									"          AND ish.fcba = '"& session("fcba") &"'" 

			Set rsTransporterInvDB1 = Server.CreateObject("ADODB.Recordset")
			rsTransporterInvDB1.Open qTransporterInvDB1, connstr
			if not rsTransporterInvDB1.eof then
				Do While Not rsTransporterInvDB1.eof
				
					 maxLineNo = maxLineNo + 1
					 qCost_ActivityTRDB1="Insert into Cost_Activity " & _
									 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
									 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA, closing_date, process_date, " & _
									 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
									 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
									 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
									 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
									 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
									 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
									 " LASTUPDATE, LASTTIME,journalprefix ) " & _
									 " values (" & maxLineNo & ",to_date('" & rsTransporterInvDB1("invoicedate") & "','mm/dd/yyyy') " & ",'" & txtControlJob & "','PR','PR','" & rsTransporterInvDB1("INVOICECODE") & "'," & _
									 " '','CB','BS'," & _
									 " '" &  rsTransporterInvDB1("AMOUNT") & "','" & rsTransporterInvDB1("ITEMCODE") & "'," & "0,0,'" & rsTransporterInvDB1("fcba") & "',"  & _
									 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
									 " 'STO - Transporter Code No :','"  & rsTransporterInvDB1("transportercode") & "'," & _
									 " 'STO - STO INVOICE No :','"  & rsTransporterInvDB1("INVOICECODE") & "'," & _
									 " 'STO - PO Code :','"  & rsTransporterInvDB1("POCODE") & "'," & _
									 " 'Auto - Itemcode :','"  & rsTransporterInvDB1("ITEMCODE") & "', " & _
									 " 'Line No:', '" & rsTransporterInvDB1("LINENO") & "','Db', " & _
									 " " & rsTransporterInvDB1("ACCOUNTINGPERIOD") & "," & rsTransporterInvDB1("ACCOUNTINGYEAR") & "," & _
									 " sysdate, to_char(sysdate,'HH24:MI'),'STO') "
					
					' response.Write qCost_ActivityTRDB1 & " </br>"
					
					 connstr.execute(qCost_ActivityTRDB1)
					 connStr.execute("Commit")
					 
					rsTransporterInvDB1.MoveNext
				loop
			end if	
			'-- End Insert Debet 1
			
			'-- Begin Insert Credit 1
			qTransporterInvCR1 =	"   SELECT ish.invoicecode," & _
									"          ish.fcba," & _
									"          ish.invoicedate," & _
									"		   to_number(to_char(ish.invoicedate,'MM')) accountingperiod," & _
       								"          to_number(to_char(ish.invoicedate,'YYYY')) accountingyear," & _
									"          ish.transportercode," & _
									"          ish.paid," & _
									"          ish.pocode," & _
									"          ish.stono," & _
									"          round(-1 * (isd.amount * ish.pph ),2) amount," & _
									"          ish.pph," & _
									"          ish.amountpph," & _
									"          ish.totalamount," & _
									"          ish.no_faktur," & _
									"          isd.do_no," & _
									"          isd.receivenotecode," & _
									"          isd.itemcode," & _
									"          isd.unitprice," & _
									"          isd.quantity," & _
									"          isd.lineno" & _
									"     FROM invoicestodetail isd" & _
									"          INNER JOIN invoicesto ish" & _
									"             ON (    ish.invoicecode = isd.invoicecode" & _
									"                 AND ish.fcba = isd.fcba" & _
									"                 AND ish.pocode = isd.pocode" & _
									"                 AND ish.stono = isd.stono)" & _
									"    WHERE     TO_NUMBER(TO_CHAR (ish.invoicedate, 'MM')) = '"& Month(Session("v_Purchase")) &"'" & _
									"          AND TO_NUMBER(TO_CHAR (ish.invoicedate, 'yyyy')) = '"& year(Session("v_Purchase")) &"'" & _
									"          AND ish.fcba = '"& session("fcba") &"'" 
									
			'response.write qTransporterInvCR1 & "</br>"
			
			Set rsTransporterInvCR1 = Server.CreateObject("ADODB.Recordset")
			rsTransporterInvCR1.Open qTransporterInvCR1, connstr
			if not rsTransporterInvCR1.eof then
				Do While Not rsTransporterInvCR1.eof
					
					 maxLineNo = maxLineNo + 1
					 qCost_ActivityTRCR1 = "Insert into Cost_Activity " & _
									 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
									 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA, closing_date, process_date, " & _
									 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
									 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
									 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
									 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
									 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
									 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
									 " LASTUPDATE, LASTTIME,journalprefix ) " & _
									 " values (" & maxLineNo & ",to_date('" & rsTransporterInvCR1("invoicedate") & "','mm/dd/yyyy') " & ",'" & get_controljob_tax(arr_controljob_tax, "PPH_23", 1) & "','PR','PR','" & rsTransporterInvCR1("INVOICECODE") & "'," & _
									 " '','CB','BS'," & _
									 " '" &  rsTransporterInvCR1("AMOUNT") & "','" & rsTransporterInvCR1("ITEMCODE") & "'," & "0,0,'" & rsTransporterInvCR1("fcba") & "',"  & _
									 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
									 " 'STO - Transporter Code No :','"  & rsTransporterInvCR1("transportercode") & "'," & _
									 " 'STO - STO INVOICE No :','"  & rsTransporterInvCR1("INVOICECODE") & "'," & _
									 " 'STO - PO Code :','"  & rsTransporterInvCR1("POCODE") & "'," & _
									 " 'Auto - Itemcode :','"  & rsTransporterInvCR1("ITEMCODE") & "', " & _
									 " 'Line No:', '" & rsTransporterInvCR1("LINENO") & "','Cr', " & _
									 " " & rsTransporterInvCR1("ACCOUNTINGPERIOD") & "," & rsTransporterInvCR1("ACCOUNTINGYEAR") & "," & _
									 " sysdate, to_char(sysdate,'HH24:MI'),'STO') "
									 
					 'response.write qCost_ActivityTRCR1
					 connstr.execute(qCost_ActivityTRCR1)
					 connStr.execute("Commit")
					 
					rsTransporterInvCR1.MoveNext
				loop
			end if	
			'-- End Insert Credit 1
			
			'-- Insert Credit 2
			qTransporterInvCR2 =	" SELECT ish.invoicecode," & _
									"        ish.fcba," & _
									"        ish.invoicedate," & _
									"        TO_NUMBER (TO_CHAR (ish.invoicedate, 'MM')) accountingperiod," & _
									"        TO_NUMBER (TO_CHAR (ish.invoicedate, 'YYYY')) accountingyear," & _
									"        ish.transportercode," & _
									"        tr.controljob," & _
									"        ish.paid," & _
									"        ish.pocode," & _
									"        ish.stono," & _
									"        round( -1 * (isd.amount + (isd.amount * ish.pph)) ,2) amount_hutang_contractor," & _
									"        ish.pph," & _
									"        ish.amountpph," & _
									"        ish.totalamount," & _
									"        ish.no_faktur," & _
									"        ish.fakturdate," & _
									"        isd.do_no," & _
									"        isd.receivenotecode," & _
									"        isd.itemcode," & _
									"        isd.unitprice," & _
									"        isd.quantity," & _
									"        isd.lineno" & _
									"   FROM invoicestodetail isd" & _
									"        INNER JOIN invoicesto ish" & _
									"           ON (ish.invoicecode = isd.invoicecode AND ish.fcba = isd.fcba)" & _
									"        INNER JOIN transporter tr" & _
									"           ON (tr.fccode = ish.transportercode AND tr.fcba = ish.fcba)" & _
									"  WHERE     TO_NUMBER(TO_CHAR (ish.invoicedate, 'MM')) = '"& Month(Session("v_Purchase")) &"'" & _
									"        AND TO_NUMBER(TO_CHAR (ish.invoicedate, 'yyyy')) = '"& Year(Session("v_Purchase")) &"'" & _
									"        AND ish.fcba = '"& session("fcba") &"'" 
			'response.Write qTransporterInvCR2
			Set rsTransporterInvCR2 = Server.CreateObject("ADODB.Recordset")
			rsTransporterInvCR2.Open qTransporterInvCR2, connstr
			if not rsTransporterInvCR2.eof then
				Do While Not rsTransporterInvCR2.eof
					 
					 maxLineNo = maxLineNo + 1
					qCost_ActivityTRCR2 = " Insert into Cost_Activity " & _
										 " (LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
										 " TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA, closing_date, process_date, " & _
										 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
										 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
										 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
										 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
										 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
										 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
										 " LASTUPDATE, LASTTIME,journalprefix ) " & _
										 " values (" & maxLineNo & ",to_date('" & rsTransporterInvCR2("INVOICEDATE") & "','mm/dd/yyyy') " & ",'" & rsTransporterInvCR2("controljob") & "','PR','PR','" & rsTransporterInvCR2("INVOICECODE") & "'," & _
										 " '','CA','" & rsTransporterInvCR2("transportercode") & "'," & _
										 " '" &  cdbl(to_nol(rsTransporterInvCR2("amount_hutang_contractor"))) & "','" & rsTransporterInvCR2("ITEMCODE") & "'," & "0,0,'" & rsTransporterInvCR2("fcba") & "',"  & _
										 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
									     " 'STO - Transporter Code No :','"  & rsTransporterInvCR2("transportercode") & "'," & _
										 " 'STO - STO INVOICE No :','"  & rsTransporterInvCR2("invoicecode") & "'," & _
										 " 'STO - PO Code :','"  & rsTransporterInvCR2("POCODE") & "'," & _
										 " 'Auto - Itemcode :','"  & rsTransporterInvCR2("ITEMCODE") & "', " & _
										 " 'Line No:', '" & rsTransporterInvCR2("LINENO") & "','Cr', " & _
										 " " & rsTransporterInvCR2("ACCOUNTINGPERIOD") & "," & rsTransporterInvCR2("ACCOUNTINGYEAR") & "," & _
										 " sysdate, to_char(sysdate,'HH24:MI'),'STO') "

					 'response.Write qCost_ActivityTRCR2
					 connstr.execute(qCost_ActivityTRCR2)
					 connStr.execute("Commit")

					rsTransporterInvCR2.MoveNext
				loop
			end if	
			'-- End Insert Credit 2
			
		'-- End Transporter Invoice
		'--end if
		qjournal=	" MERGE INTO cost_activity x " & _
					" USING " & _
					" ( " & _
					"  SELECT fcba,referenceno,idx||LPAD(ROWNUM,4,0) seq from " & _
					"  ( " & _
					"  SELECT DISTINCT fcba,referenceno,'" & session("COMPANYNO") & "/'||fcba||'/'||journalprefix||'/'||LPad(accountingperiod,2,0)||'/'||accountingyear||'/' as idx  " & _
					"  FROM cost_activity WHERE fcba='" & Session("FCBA") & "' AND accountingperiod="& Month(Session("v_Purchase")) & " AND accountingyear=" & Year(Session("v_Purchase")) & " AND journalprefix='STO' " & _
					"  Order BY referenceno " & _
					"  ) " & _
					" )y ON (x.referenceno =  y.referenceno and x.fcba=y.fcba) " & _
					" WHEN MATCHED THEN " & _
					" UPDATE SET x.journalno = y.seq " 
		connstr.execute(qjournal)
		connStr.execute("Commit")
		Response.Write "<font face=Verdana size=1 color=blue>" & "Closing Transporter Invoice is successfully...." & "<br><br>" : response.flush()
	
		
		' INVOICE SPECIAL
		'--if Session("Estate_Mill") = "HO" then
    		Response.Write "<font face='Verdana' size='1' color='black'>" & "Closing Special Invoice" & "<br>" : response.flush()
			qReceive = 	" SELECT hdr.fcba " & _
						"		 , dtl.invoiceno invoicecode" & _
						"        , hdr.transdate invoicedate" & _
						"        , hdr.suppliername SUPPLIERCODE" & _
						"        , supp.controljob" & _
						"        , dtl.jobcode" & _
						"        , dtl.targettype" & _
						"        , dtl.targetcode" & _
						"        , dtl.description" & _
						"        , round(NVL(dtl.amount,0),2) amount" & _
						"        , round(NVL(dtl.othercost,0),2) othercost" & _
						"        , NVL(hdr.ppn,0) ppn" & _
						"        , NVL(hdr.pph,0) pph" & _
						" FROM invoiceservicedtl dtl" & _
						" INNER JOIN invoiceservicehdr hdr ON (dtl.invoiceno = hdr.invoiceno AND dtl.fcba = hdr.fcba)" & _
						" INNER JOIN supplier supp ON (hdr.suppliername = supp.fccode AND hdr.fcba = supp.fcba)" & _
						" WHERE TO_NUMBER(TO_CHAR(hdr.transdate,'mm')) = '" & Month(Session("v_Purchase")) & "'" &  _
						"       AND TO_NUMBER(TO_CHAR(hdr.transdate,'yyyy')) = '" & Year(Session("v_Purchase")) & "'" & _
						"       AND hdr.fcba = '" & Session("fcBA") & "'" & _
						"       AND hdr.invoice_type <> 'TBS'"
			  
			Set rsReceive = Server.CreateObject("ADODB.Recordset")
			rsReceive.Open qReceive, connstr
			if not rsReceive.eof then
			   Do While Not rsReceive.eof			
					
					maxLineNo = maxLineNo + 1
					qCost_ActivityDB="Insert into Cost_Activity " & _
								 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
								 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA,  closing_date, process_date, " & _
								 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
								 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
								 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
								 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
								 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
								 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
								 " LASTUPDATE, LASTTIME, journalprefix ) " & _
								 " values (" & maxLineNo & ", to_date('" & rsReceive("INVOICEDATE") & "','mm/dd/yyyy') " & ",'" & rsReceive("jobcode") & "','PR','" & "PR" & "','" & rsReceive("INVOICECODE") & "'," & _
								 "'" &  rsReceive("description") & "','" & rsReceive("targettype") & "','" & rsReceive("targetcode") & "'," & _
								 cdbl(to_nol(rsReceive("amount"))) & ",'" & rsReceive("INVOICECODE") & "', 0,0,'" & rsReceive("fcba") & "',"  & _
								 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', 'CB','Cr'),'"  & rsReceive("SUPPLIERCODE") & "'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', 'CB','Cr'),'"  & rsReceive("INVOICECODE") & "'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', 'CB','Cr'),'"  & rsReceive("description") & "'," & _
								 " '',''," & _
								 " '','','Dr', " & _
								 Month(Session("v_Purchase")) & ", " & _
								 Year(Session("v_Purchase")) & ", " & _	
								 " sysdate, to_char(sysdate,'HH24:MI'),'SIV') "
								 
					response.Flush()			 
					connstr.execute(qCost_ActivityDB)
					
					if cdbl(to_nol(rsReceive("ppn"))) <> 0 then
						post_amount_ppn = 0
						post_amount_ppn = cdbl(to_nol(rsReceive("ppn")))*cdbl(to_nol(rsReceive("amount")))/100
					
						maxLineNo = maxLineNo + 1
						qCost_ActivityDB="Insert into Cost_Activity " & _
									 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
									 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA,  closing_date, process_date, " & _
									 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
									 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
									 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
									 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
									 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
									 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
									 " LASTUPDATE, LASTTIME, journalprefix ) " & _
									 " values (" & maxLineNo & ", to_date('" & rsReceive("INVOICEDATE") & "','mm/dd/yyyy') " & ",'" & get_controljob_tax(arr_controljob_tax, "PPN", 2) & "','PR','" & "PR" & "','" & rsReceive("INVOICECODE") & "'," & _
									 "'" &  rsReceive("description") & "','" & "CB" & "','" & "BS" & "'," & _
									 post_amount_ppn & ",'" & rsReceive("INVOICECODE") & "', 0,0,'" & rsReceive("fcba") & "',"  & _
									 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', 'CB','Cr'),'"  & rsReceive("SUPPLIERCODE") & "'," & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', 'CB','Cr'),'"  & rsReceive("INVOICECODE") & "'," & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', 'CB','Cr'),'"  & rsReceive("description") & "'," & _
									 " '',''," & _
									 " '','','Dr', " & _
									 Month(Session("v_Purchase")) & ", " & _
									 Year(Session("v_Purchase")) & ", " & _	
									 " sysdate, to_char(sysdate,'HH24:MI'),'SIV') "
									 
						response.Flush()			 
						connstr.execute(qCost_ActivityDB)
					else
						post_amount_ppn = 0
					end if
					
					
					
					if cdbl(to_nol(rsReceive("othercost"))) <> 0 then
					
						maxLineNo = maxLineNo + 1
						qCost_ActivityDB="Insert into Cost_Activity " & _
									 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
									 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA,  closing_date, process_date, " & _
									 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
									 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
									 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
									 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
									 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
									 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
									 " LASTUPDATE, LASTTIME , journalprefix) " & _
									 " values (" & maxLineNo & ", to_date('" & rsReceive("INVOICEDATE") & "','mm/dd/yyyy') " & ",'" & job_othercharge & "','PR','" & "PR" & "','" & rsReceive("INVOICECODE") & "'," & _
									 "'" &  rsReceive("description") & "','" & "CB" & "','" & "BS" & "'," & _
									 cdbl(rsReceive("othercost")) & ",'" & rsReceive("INVOICECODE") & "', 0,0,'" & rsReceive("fcba") & "',"  & _
									 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', 'CB','Cr'),'"  & rsReceive("SUPPLIERCODE") & "'," & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', 'CB','Cr'),'"  & rsReceive("INVOICECODE") & "'," & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', 'CB','Cr'),'"  & rsReceive("description") & "'," & _
									 " '',''," & _
									 " '','','Dr', " & _
									 Month(Session("v_Purchase")) & ", " & _
									 Year(Session("v_Purchase")) & ", " & _	
									 " sysdate, to_char(sysdate,'HH24:MI'),'SIV') "
									 
						response.Flush()			 
						connstr.execute(qCost_ActivityDB)
					end if
					
					
					if cdbl(to_nol(rsReceive("pph"))) <> 0 then
						post_amount_pph = 0
						post_amount_pph = cdbl(to_nol(rsReceive("pph")))*cdbl(to_nol(rsReceive("amount")))/100
					
						maxLineNo = maxLineNo + 1
						qCost_ActivityDB="Insert into Cost_Activity " & _
									 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
									 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA,  closing_date, process_date, " & _
									 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
									 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
									 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
									 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
									 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
									 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
									 " LASTUPDATE, LASTTIME , journalprefix) " & _
									 " values (" & maxLineNo & ", to_date('" & rsReceive("INVOICEDATE") & "','mm/dd/yyyy') " & ",'" & get_controljob_tax(arr_controljob_tax, "PPH_23", 2) & "','PR','" & "PR" & "','" & rsReceive("INVOICECODE") & "'," & _
									 "'" &  rsReceive("description") & "','" & "CB" & "','" & "BS" & "'," & _
									 -1*post_amount_pph & ",'" & rsReceive("INVOICECODE") & "', 0,0,'" & rsReceive("fcba") & "',"  & _
									 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', 'CB','Cr'),'"  & rsReceive("SUPPLIERCODE") & "'," & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', 'CB','Cr'),'"  & rsReceive("INVOICECODE") & "'," & _
									 " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', 'CB','Cr'),'"  & rsReceive("description") & "'," & _
									 " '',''," & _
									 " '','','Dr', " & _
									 Month(Session("v_Purchase")) & ", " & _
									 Year(Session("v_Purchase")) & ", " & _	
									 " sysdate, to_char(sysdate,'HH24:MI'),'SIV') "
									 
						response.Flush()			 
						connstr.execute(qCost_ActivityDB)
					else
						post_amount_pph = 0
					end if
					
					post_hutang_supplier = 0
					post_hutang_supplier = cdbl(to_nol(rsReceive("amount"))) +post_amount_ppn +cdbl(to_nol(rsReceive("othercost"))) -post_amount_pph
					
					maxLineNo = maxLineNo + 1
					qCost_ActivityCR="Insert into Cost_Activity " & _
								 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
								 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA,  closing_date, process_date, " & _
								 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
								 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
								 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
								 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
								 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
								 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
								 " LASTUPDATE, LASTTIME , journalprefix) " & _
								 " values (" & maxLineNo & " ,to_date('" & rsReceive("INVOICEDATE") & "','mm/dd/yyyy') " & ",'" & rsReceive("CONTROLJOB") & "','PR','" & "PR" & "','" & rsReceive("INVOICECODE") & "'," & _
								 "'" &  rsReceive("description") & "','AP','" & rsReceive("SUPPLIERCODE") & "'," & _
								 "" &  -1*post_hutang_supplier & ",'" & rsReceive("INVOICECODE") & "', 0,0,'" & rsReceive("fcba") & "',"  & _
								 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate, " & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', 'CB','Cr'),'"  & rsReceive("SUPPLIERCODE") & "'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', 'CB','Cr'),'"  & rsReceive("INVOICECODE") & "'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', 'CB','Cr'),'"  & rsReceive("description") & "'," & _
								 " '',''," & _
								 " '','','Cr', " & _	
								 Month(Session("v_Purchase")) & ", " & _
								 Year(Session("v_Purchase")) & ", " & _							 
								 " sysdate, to_char(sysdate,'HH24:MI'),'SIV') "
								 
					'response.write qCost_ActivityCR
					response.Flush()
					connstr.execute(qCost_ActivityCR)
					connStr.execute("Commit")
					
					rsReceive.MoveNext
			  loop
			End if
			
					qjournal=	" MERGE INTO cost_activity x " & _
					" USING " & _
					" ( " & _
					"  SELECT fcba,referenceno,idx||LPAD(ROWNUM,4,0) seq from " & _
					"  ( " & _
					"  SELECT DISTINCT fcba,referenceno,'" & session("COMPANYNO") & "/'||fcba||'/'||journalprefix||'/'||LPad(accountingperiod,2,0)||'/'||accountingyear||'/' as idx  " & _
					"  FROM cost_activity WHERE fcba='" & Session("FCBA") & "' AND accountingperiod="& Month(Session("v_Purchase")) & " AND accountingyear=" & Year(Session("v_Purchase")) & " AND journalprefix='SIV' " & _
					"  Order BY referenceno " & _
					"  ) " & _
					" )y ON (x.referenceno =  y.referenceno and x.fcba=y.fcba) " & _
					" WHEN MATCHED THEN " & _
					" UPDATE SET x.journalno = y.seq " 
		connstr.execute(qjournal)
		connStr.execute("Commit")
		Response.Write "<font face=Verdana size=1 color=blue>" & "Closing Special Invoice is successfully...." & "<br><br>" : response.flush()
	
		
