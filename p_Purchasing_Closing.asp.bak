								 " Cost_Activity_Info_Api.Get_Title_Reference_04('PR', 'CB','Dr'),''," & _
								 " '','','Dr', " & _
								 Month(Session("v_Purchase")) & ", " & _
								 Year(Session("v_Purchase")) & ", " & _
								 " sysdate, to_char(sysdate,'HH24:MI'),'INV')"
