<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>ePlaS- Purchase Closing</title>
</head>
<body>
<%
Session("v_Purchase") = cmdFindPeriod("Purchase")
Session("cls_Purchase") = cmdPeriodClose("Purchase")

Session("CurP_Purchase") = cmdFindAccountPeriod("Purchase")
Session("ClsP_Purchase") = cmdAccountPeriodClose("Purchase")

curr_documentno = ""
prev_documentno = ""
Dim TimeAwal,TimeAkhir,Hitung,Lama
TimeAwal=Time()

'--Added by Ukie at 25-Oct-2012--	
Dim Startingtime, Endingtime
Startingtime = FormatDateTime(CDate(Now))
'--End Added--		
%>
<div id="status_running"><img src="ICON/working.gif"></div><br>
<font face="Verdana" size="1">
Purchasing Last Period Close <%=FormatDateTime(Session("cls_Purchase"),1)%> <br> 
Purchasing Current Period is <%=FormatDateTime(Session("v_Purchase"),1)%> <br><br>
Please Wait...<br>
<%
 Response.Write "Start ..." & Time() & "<br><br>" 
dim rsReceive,rsPO,qReceive, qReceive2, qPO,qControlJob,nPurchaseControl,rsControlJob,txtControlJob,qCost_ActivityDB,qCost_ActivityCR,nQtyReceived,qNormalisasi
Dim NormalisasiInvoiceLedger, SelectInvoiceLedger, rsInvoiceLedger, InsertInvoiceLedger ,vchar
Dim fine_result_01, fine_result_02, fine_result_03, rsReceive2, qCost_ActivityDB2, qCost_ActivityCR2
Dim qjournal 
Dim maxLineNo

' New Concept Variable, By NAF, 12 May 2013
Dim tempProcessCode, tempProcessNameCode, tempRefCodeReceive, tempRefCodeInvoice, qReference
Dim rsReferenceReceive, rsReferenceInvoice
Dim txtRefNumberKeys_Receive, txtRefStringSeparator_Receive , txtRefStringKeys_Receive 
Dim txtRefNumberKeys_Invoice, txtRefStringSeparator_Invoice , txtRefStringKeys_Invoice
Dim txtRefStringValues_Receive, txtRefStringValues_Invoice
Dim doneReceive, doneInvoice
' End Modification.


' XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
' Add by NAF to select lastperiodposted
Dim qPeriodControl, rsPeriodControl, temp_datePeriodControl



' Water Flow Check, By NAF
' 2 December 2013

Dim qWaterFlowCheck, rsWaterFlowCheck, CheckWaterFlow, tempErrorWaterFlow

qWaterFlowCheck = " select PERIODCONTROL_API.getStatusPrevClosing('Purchase','" & Session("fcBA")  & "') waterFlowCheck from dual "

Set rsWaterFlowCheck = Server.CreateObject("ADODB.Recordset")
rsWaterFlowCheck.CursorType = 3
rsWaterFlowCheck.CursorLocation = 3
rsWaterFlowCheck.Open qWaterFlowCheck, connstr

if not rsWaterFlowCheck.eof then
    CheckWaterFlow = rsWaterFlowCheck("waterFlowCheck")
else
    Response.Write  "<font face=Verdana size=1 color=red>" & "SAC Plant Error, No WATER FLOW CHECK for Purchase " & "<br>"
end if
rsWaterFlowCheck.close
set rsWaterFlowCheck = Nothing

arr_dataintraco_eof = true
qWaterFlowCheck = " SELECT fccode, fcba FROM intraco_tab"

Set rsWaterFlowCheck = Server.CreateObject("ADODB.Recordset")
rsWaterFlowCheck.Open qWaterFlowCheck, connstr

if not rsWaterFlowCheck.eof then
	arr_dataintraco = rsWaterFlowCheck.getrows()
	arr_dataintraco_eof = false
end if
rsWaterFlowCheck.close : set rsWaterFlowCheck = Nothing

private function get_jobintraco(arr_, fcba_)
	result_ = ""
	arr1 = ""
	arr1 = arr_
	if not arr_dataintraco_eof then
		for xyz=0 to ubound(arr1,2)
			if cstr(""&arr1(1,xyz)) = fcba_ then result_ = arr1(0,xyz)
		next
	end if
	get_jobintraco = result_
end function

arr_controljob_tax_eof = true
qWaterFlowCheck = " SELECT fccode, controljob_in, controljob_out FROM controljob_tax"

Set rsWaterFlowCheck = Server.CreateObject("ADODB.Recordset")
rsWaterFlowCheck.Open qWaterFlowCheck, connstr

if not rsWaterFlowCheck.eof then
	arr_controljob_tax = rsWaterFlowCheck.getrows()
	arr_controljob_tax_eof = false
end if
rsWaterFlowCheck.close : set rsWaterFlowCheck = Nothing
private function get_controljob_tax(arr_, fccode_, col_in_or_out_)
	result_ = ""
	arr1 = ""
	arr1 = arr_
	if not arr_dataintraco_eof then
		for xyz=0 to ubound(arr1,2)
			if cstr(""&arr1(0,xyz)) = fccode_ then result_ = arr1(col_in_or_out_,xyz)
		next
	end if
	get_controljob_tax = result_
end function

if CheckWaterFlow = "TRUE" then 


	qPeriodControl=" select  add_months(LASTPERIODPOSTED,1) LastPeriodPosted from PERIODCONTROL  " & _
	  " where SYSTEM='Purchase' and fcba='" & Session("fcBA") & "'"

	Set rsPeriodControl = Server.CreateObject("ADODB.Recordset")
	rsPeriodControl.CursorType = 3
	rsPeriodControl.CursorLocation = 3
	rsPeriodControl.Open qPeriodControl, connstr

	if not rsPeriodControl.eof then
		temp_datePeriodControl = rsPeriodControl("LASTPERIODPOSTED")
	else
		Response.Write  "<font face=Verdana size=1 color=red>" & "SAC Plant Error, No PERIODCONTROL for Purchase " & "<br>"
	end if
	' End Added
	'XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
	'---- Control Job


	' Remarked by NAF, as per New Concept, 7 May 2013
	' qControlJob="select ControlJob from Module where NAME='Purchase'"
	' Now we use new concept for picking Control Job, by using Process Control Tables
	' as per last concept are NOT able to pick data per Business Unit.

	tempProcessCode = "PURCHASE_CLOSING"
	tempProcessNameCode = "p_Purchasing_Closing.asp"
	tempRefCodeReceive = "RECEIVENOTEDETAIL"
	tempRefCodeInvoice = "INVOICEDETAIL"

	qControlJob = " SELECT parameterdetail_api.get_param_1 ('" & Session("FCBA") & "', 'HARDCODE', 'CONTROLJOB_MODULE', 'PURCHASE') ControlJob FROM DUAL"

	' End Of Modification., 7 May 2013.

	Set rsControlJob = Server.CreateObject("ADODB.Recordset")
	rsControlJob.Open qControlJob, connstr
	if not rsControlJob.eof then
	   txtControlJob=rsControlJob("ControlJob")
	else
	   Response.Write  "<font face=Verdana size=1 color=red>" & "SAC Plant Error SAC20021 Control Job For Purchase is Empty"
	   txtControlJob=""
	end if
	rsControlJob.close : set rsControlJob = Nothing
	
	qControlJob = " SELECT fccode FROM parameterdetail WHERE fcba = '" & Session("FCBA") & "' AND parcode = 'HARDCODE' AND parheadcode = 'JOBCODE_OTHERCHARGE'"

	' End Of Modification., 7 May 2013.

	Set rsControlJob = Server.CreateObject("ADODB.Recordset")
	rsControlJob.Open qControlJob, connstr
	if not rsControlJob.eof then
	   job_othercharge = rsControlJob("fccode")
	else
	   Response.Write  "<font face=Verdana size=1 color=red>" & "SAC Plant Error SAC20021 Control Job For Other Charges is Empty"
	   job_othercharge = ""
	end if
	rsControlJob.close : set rsControlJob = Nothing

	' Take the Reference of Cost Activity, as per New Concept, by using this reference, we can directly refer to Original Table
	' by NAF, 12 May 2013
	' First, take the Original Table of RECEIVENOTE.
	qReference = "select REF_NUMBERKEYS, REF_STRINGSEPARATOR, REF_STRINGKEYS " & _
				  " from process_tableref_tab " & _
				  " where " & _
				  " processcode = '" & tempProcessCode & "' and " & _
				  " upper(processnamecode) =  upper('" & tempProcessNameCode & "') and " & _
				  " fccode =  '" & tempRefCodeReceive & "'"

	Set rsReferenceReceive = Server.CreateObject("ADODB.Recordset")
	rsReferenceReceive.CursorType = 3
	rsReferenceReceive.CursorLocation = 3
	rsReferenceReceive.Open qReference, connstr

	doneReceive = 1
	if not rsReferenceReceive.eof then
		txtRefNumberKeys_Receive = rsReferenceReceive("REF_NUMBERKEYS")
		txtRefStringSeparator_Receive = rsReferenceReceive("REF_STRINGSEPARATOR")
		txtRefStringKeys_Receive = rsReferenceReceive("REF_STRINGKEYS")
		doneReceive = 1
	else
		doneReceive = 0
	end if
	rsReferenceReceive.close
	set rsReferenceReceive = Nothing



	' Second, take the Original Table of INVOICEDETAIL.
	qReference = "select REF_NUMBERKEYS, REF_STRINGSEPARATOR, REF_STRINGKEYS " & _
				  " from process_tableref_tab " & _
				  " where " & _
				  " processcode = '" & tempProcessCode & "' and " & _
				  " upper(processnamecode) =  upper('" & tempProcessNameCode & "') and " & _
				  " fccode =  '" & tempRefCodeInvoice & "'"

	Set rsReferenceInvoice = Server.CreateObject("ADODB.Recordset")
	rsReferenceInvoice.CursorType = 3
	rsReferenceInvoice.CursorLocation = 3
	rsReferenceInvoice.Open qReference, connstr

	doneInvoice = 1
	if not rsReferenceInvoice.eof then
		txtRefNumberKeys_Invoice = rsReferenceInvoice("REF_NUMBERKEYS")
		txtRefStringSeparator_Invoice = rsReferenceInvoice("REF_STRINGSEPARATOR")
		txtRefStringKeys_Invoice = rsReferenceInvoice("REF_STRINGKEYS")
		doneInvoice = 1
	else
		doneInvoice = 0
	end if
	rsReferenceInvoice.close
	set rsReferenceInvoice = Nothing


	' To Pick max Line No in Cost_Activity
	qMaxLineNo = " select nvl(max(nvl(lineno,0)),0) maxLineNo " & _
					" from cost_activity " & _
					" where " & _
					" fcba = '" & Session("fcBA") & "' "
					
	Set rsqMaxLineNo = Server.CreateObject("ADODB.Recordset")
	rsqMaxLineNo.CursorType = 3
	rsqMaxLineNo.CursorLocation = 3
	rsqMaxLineNo.Open qMaxLineNo, connstr

	if not rsqMaxLineNo.eof then
		maxLineNo = cdbl(rsqMaxLineNo("maxLineNo"))
	else
		maxLineNo = 0
	end if
	rsqMaxLineNo.close
	set rsqMaxLineNo = Nothing





	if txtControlJob<>"" then
	
		'---- Normalisasi
		arr_normalisasi_eof = true
		' qPeriodControl = " select lineno from cost_activity " & _
						 ' " where ACCOUNTINGPERIOD = " & Mid(Session("CurP_Purchase"),5,2) & "" & _
						 ' "       and ACCOUNTINGYEAR = " & Mid(Session("CurP_Purchase"),1,4) & "" & _
						 ' "       and fcBA = '" & Session("fcBA") & "'" & _
						 ' "       and Sourcetype = 'PR'"

		' Set rsPeriodControl = Server.CreateObject("ADODB.Recordset")
		' rsPeriodControl.Open qPeriodControl, connstr

		' if not rsPeriodControl.eof then
		  ' arr_normalisasi = rsPeriodControl.getrows()
		  ' arr_normalisasi_eof = false
		' end if
		
		' if not arr_normalisasi_eof then
			' for xyz=0 to ubound(arr_normalisasi,2)
				' qNormalisasiDetail = " DELETE FROM cost_activity_hist_tab WHERE lineheaderno = '"&arr_normalisasi(0,xyz)&"' AND fcba =  '" & Session("fcBA") & "'"
				' ' connstr.execute(qNormalisasiDetail)
				
				' qNormalisasiDetail = " DELETE FROM cost_activity WHERE lineno = '"&arr_normalisasi(0,xyz)&"' AND fcba =  '" & Session("fcBA") & "'"
				' ' response.Write qNormalisasiDetail
				' connstr.execute(qNormalisasiDetail)
			' next
		' end if
		
				qNormalisasiDetail = " DELETE FROM cost_activity WHERE ACCOUNTINGPERIOD = " & Month(Session("v_Purchase")) & "" & _
									"       and ACCOUNTINGYEAR = " & Year(Session("v_Purchase")) & "" & _
									"       and fcBA = '" & Session("fcBA") & "'" & _
									"       and Sourcetype = 'PR'"
				connstr.execute(qNormalisasiDetail)
		
		
		'-- GOODS RECEIVE
		Response.Write "<font face='Verdana' size='1' color='black'>" & "Closing Good Received Note" & "<br>" : response.flush()
		qReceive = " SELECT r.rndate" & _
		           "        , rd.receivenotecode" & _
		           "        , rd.purchaseitemcode" & _
		           "        , rd.jobcode" & _
				   "        , parameterdetail_api.get_fccode (rd.fcba, 'HARDCODE', 'STO_RECEIVENOTE' ) stocodejob" & _
		           "        , rd.quantity" & _
		           "        , rd.locationtype" & _
		           "        , rd.locationcode" & _
		           "        , r.suppliercode" & _
				   "        , supplier_api.get_supp_name(r.suppliercode,r.fcba) suppliername" & _
		           "        , r.pocode" & _
		           "        , po.purchaseby" & _
		           "        , rd.purchaselinenokey" & _
		           "        , round(NVL(rd.amountreceived,0) ,2) AS amountreceived" & _
		           "        , round(NVL(rd.amount,0) ,2) AS amount" & _
		           "        , decode(po.ppn , 0 ,0, round(NVL(rd.amountreceived * (po.ppn/100),0) ,2)) AS ppn_stock" & _
				   "        , (SELECT controljob_out FROM controljob_tax WHERE fccode = 'PPN_B') AS jobcodeppn "  & _
				   "        , round(NVL((pod.quantity /rd.quantity) * pod.otcstock1 ,0),2) AS othercharge_pbbkb75 "  & _
				   "        , round(NVL((pod.quantity /rd.quantity) * pod.otcstock2 ,0),2) AS othercharge_pbbkb10 "  & _
				   "        , round(NVL((pod.quantity /rd.quantity) * pod.otcstock3 ,0),2) AS othercharge_ongkir "  & _
				   "        , round(NVL((pod.quantity /rd.quantity) * pod.otcstock4 ,0),2)  AS othercharge "  & _
				   "        , round(NVL((pod.quantity /rd.quantity) * pod.ppn_othercharge ,0),2) AS ppn_other "  & _
				   "        , rd.amountsto_receive  AS amountsto "  & _
				   "        , (round( NVL(rd.amountreceived,0) ,2)+ decode(po.ppn , 0 ,0, round(NVL(rd.amountreceived * (po.ppn/100),0) ,2))  " & _ 
				   "         + round(NVL((pod.quantity /rd.quantity) * pod.otcstock1 ,0),2) + round(NVL((pod.quantity /rd.quantity) * pod.otcstock2 ,0),2) " & _ 
				   "         + round(NVL((pod.quantity /rd.quantity) * pod.otcstock3 ,0),2) + round(NVL((pod.quantity /rd.quantity) * pod.otcstock4 ,0),2)) " & _
				   "         + round(NVL((pod.quantity /rd.quantity) * pod.ppn_othercharge ,0),2) + NVL(rd.amountsto_receive,0)  As TotAmountReceived " & _
		           " FROM receivenotedetail rd" & _
				   " INNER JOIN receivenote r ON (rd.receivenotecode = r.receivenotecode AND rd.fcba = r.fcba)" & _
				   " LEFT JOIN purchaseorder po ON (po.pocode = r.pocode AND po.fcba = r.fcba)" & _
				   " LEFT JOIN purchaseorderdetails pod ON (pod.pocode = po.pocode AND pod.fcba = po.fcba AND pod.linenokey = rd.purchaselinenokey)" & _
		           " WHERE TO_NUMBER(TO_CHAR(r.rndate,'mm')) = '" & Month(Session("v_Purchase")) & "'" & _
		           "       AND TO_NUMBER(TO_CHAR(r.rndate,'yyyy')) = '" & Year(Session("v_Purchase")) & "'" & _
		           "       AND rd.fcba = '" & Session("fcBA") & "'"
		  
		  
		Set rsReceive = Server.CreateObject("ADODB.Recordset")
		rsReceive.Open qReceive, connstr
		if not rsReceive.eof then
		   Do While Not rsReceive.eof
		   
				if cdbl(to_nol(rsReceive("amountreceived"))) > 0 then
					maxLineNo = maxLineNo + 1
				qCost_ActivityDB="Insert into Cost_Activity " & _
								 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
								 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA, closing_date, process_date, " & _
								 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
								 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
								 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
								 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
								 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
								 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
								 " LASTUPDATE, LASTTIME,journalprefix ) " & _
								 " values (" & maxLineNo & ", to_date('" & rsReceive("RNDATE") & "','mm/dd/yyyy') " & ",'" & rsReceive("JOBCODE") & "','PR','" & "PR" & "','" & rsReceive("POCODE") & "'," & _
								 "'" &  rsReceive("PURCHASEITEMCODE") & "','" & rsReceive("LOCATIONTYPE") & "','" & rsReceive("LOCATIONCODE") & "'," & _
								 "" &  rsReceive("amountreceived") & ",'" & rsReceive("RECEIVENOTECODE") & "'," & rsReceive("QUANTITY") & ",0,'" & Session("fcBA") & "',"  & _
								 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate , " & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'"  & rsReceive("LOCATIONCODE") & "'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'Penerimaan Stock '," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'" & rsReceive("POCODE") & " Supplier: "  & rsReceive("suppliername") & " (" & rsReceive("suppliercode") & ")'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_04('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'"  & rsReceive("PURCHASEITEMCODE") & "'," & _
								 " '','" & rsReceive("purchaselinenokey") & "','Dr', " & _
								 Month(Session("v_Purchase")) & ", " & _
								 Year(Session("v_Purchase")) & ", " & _
								 " sysdate, to_char(sysdate,'HH24:MI'),'GRN')"
					 ' response.write "<br/>" & rsReceive("RECEIVENOTECODE")
					 ' response.write qCost_ActivityDB
					response.Flush()
					connstr.execute(qCost_ActivityDB)
					connStr.execute("Commit")
				end if
				
				if cdbl(to_nol(rsReceive("ppn_stock"))) > 0 then
					maxLineNo = maxLineNo + 1
					qCost_ActivityDB="Insert into Cost_Activity " & _
								 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
								 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA, closing_date, process_date, " & _
								 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
								 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
								 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
								 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
								 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
								 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
								 " LASTUPDATE, LASTTIME,journalprefix ) " & _
								 " values (" & maxLineNo & ", to_date('" & rsReceive("RNDATE") & "','mm/dd/yyyy') " & ",'" & rsReceive("jobcodeppn") & "','PR','" & "PR" & "','" & rsReceive("POCODE") & "'," & _
								 "'" &  rsReceive("PURCHASEITEMCODE") & "','" & rsReceive("LOCATIONTYPE") & "','" & rsReceive("LOCATIONCODE") & "'," & _
								 "" &  rsReceive("ppn_stock") & ",'" & rsReceive("RECEIVENOTECODE") & "'," & rsReceive("QUANTITY") & ",0,'" & Session("fcBA") & "',"  & _
								 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate , " & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'"  & rsReceive("LOCATIONCODE") & "'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'PPN Stock '," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'" & rsReceive("POCODE") & " Supplier: "  & rsReceive("suppliername") & " (" & rsReceive("suppliercode") & ")'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_04('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'"  & rsReceive("PURCHASEITEMCODE") & "'," & _
								 " '','" & rsReceive("purchaselinenokey") & "','Dr', " & _
								 Month(Session("v_Purchase")) & ", " & _
								 Year(Session("v_Purchase")) & ", " & _
								 " sysdate, to_char(sysdate,'HH24:MI'),'GRN')"
					 ' response.write "<br/>" & rsReceive("RECEIVENOTECODE")
					 ' response.write qCost_ActivityDB
					response.Flush()
					connstr.execute(qCost_ActivityDB)
					connStr.execute("Commit")
				end if
				
				if cdbl(to_nol(rsReceive("othercharge_pbbkb75"))) <> 0 then
					maxLineNo = maxLineNo + 1
					qCost_ActivityDB="Insert into Cost_Activity " & _
								 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
								 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA, closing_date, process_date, " & _
								 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
								 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
								 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
								 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
								 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
								 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
								 " LASTUPDATE, LASTTIME ,journalprefix) " & _
								 " values (" & maxLineNo & ", to_date('" & rsReceive("RNDATE") & "','mm/dd/yyyy') " & ",'" & rsReceive("JOBCODE") & "','PR','" & "PR" & "','" & rsReceive("POCODE") & "'," & _
								 "'" &  rsReceive("PURCHASEITEMCODE") & "','" & rsReceive("LOCATIONTYPE") & "','" & rsReceive("LOCATIONCODE") & "'," & _
								 "" &  rsReceive("othercharge_pbbkb75") & ",'" & rsReceive("RECEIVENOTECODE") & "'," & rsReceive("QUANTITY") & ",0,'" & Session("fcBA") & "',"  & _
								 " to_date('" & temp_datePeriodControl & "','mm/dd/yyyy') , sysdate , " & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_01('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'"  & rsReceive("LOCATIONCODE") & "'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_02('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'Other Stock Charge - PBBKB 7.5% '," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_03('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'" & rsReceive("POCODE") & " Supplier: "  & rsReceive("suppliername") & " (" & rsReceive("suppliercode") & ")'," & _
								 " Cost_Activity_Info_Api.Get_Title_Reference_04('PR', '" & rsReceive("LOCATIONTYPE") & "','Dr'),'"  & rsReceive("PURCHASEITEMCODE") & "'," & _
								 " '','" & rsReceive("purchaselinenokey") & "','Dr', " & _
								 Month(Session("v_Purchase")) & ", " & _
								 Year(Session("v_Purchase")) & ", " & _
								 " sysdate, to_char(sysdate,'HH24:MI'),'GRN')"
					 'response.write qCost_ActivityDB
					response.Flush()
					connstr.execute(qCost_ActivityDB)
					connStr.execute("Commit")
				end if
				
				if cdbl(to_nol(rsReceive("othercharge_pbbkb10"))) <> 0 then
					maxLineNo = maxLineNo + 1
					qCost_ActivityDB="Insert into Cost_Activity " & _
								 "(LINENO, TDATE, JOBCODE, SOURCE,SOURCETYPE, SOURCECODE, SOURCECODE_STATUS, " & _
								 "TARGETTYPE, TARGETCODE, AMOUNT, REFERENCENO, QUANTITY, OUTPUT,FCBA, closing_date, process_date, " & _
								 " TITLE_REFERENCE_01, AUTO_REFERENCE_01, " & _
								 " TITLE_REFERENCE_02, AUTO_REFERENCE_02, " & _
								 " TITLE_REFERENCE_03, AUTO_REFERENCE_03, " & _
								 " TITLE_REFERENCE_04, AUTO_REFERENCE_04, " & _
								 " TITLE_REFERENCE_05, AUTO_REFERENCE_05, DEBETCREDIT, " & _
								 " ACCOUNTINGPERIOD, ACCOUNTINGYEAR, " & _
								 " LASTUPDATE, LASTTIME,journalprefix ) " & _
								 " values (" & maxLineNo & ", to_date('" & rsReceive("RNDATE") & "','mm/dd/yyyy') " & ",'" & rsReceive("JOBCODE") & "','PR','" & "PR" & "','" & rsReceive("POCODE") & "'," & _
								 "'" &  rsReceive("PURCHASEITEMCODE") & "','" & rsReceive("LOCATIONTYPE") & "','" & rsReceive("LOCATIONCODE") & "'," & _
