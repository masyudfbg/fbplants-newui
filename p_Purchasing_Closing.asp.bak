		qjournal=	" MERGE INTO cost_activity x " & _
					" USING " & _
					" ( " & _
					"  SELECT fcba,referenceno,idx||LPAD(ROWNUM,4,0) seq from " & _
					"  ( " & _
					"  SELECT DISTINCT fcba,referenceno,'" & session("COMPANYNO") & "/'||fcba||'/'||journalprefix||'/'||LPad(accountingperiod,2,0)||'/'||accountingyear||'/' as idx  " & _
					"  FROM cost_activity WHERE fcba='" & Session("FCBA") & "' AND accountingperiod="& Month(Session("v_Purchase")) & " AND accountingyear=" & Year(Session("v_Purchase")) & " AND journalprefix='GRN' " & _
					"  Order BY referenceno " & _
					"  ) " & _
					" )y ON (x.referenceno =  y.referenceno and x.fcba=y.fcba) " & _
					" WHEN MATCHED THEN " & _
					" UPDATE SET x.journalno = y.seq " 
		connstr.execute(qjournal)
		connStr.execute("Commit")
		Response.Write "<font face=Verdana size=1 color=blue>" & "Closing Good Received Note is successfully...." & "<br><br>" : response.flush()
		
      
	  '-- INVOCE PURCHASING 
		Response.Write "<font face='Verdana' size='1' color='black'>" & "Closing Purchase Invoice" & "<br>" : response.flush()
        qReceive =                  " SELECT ish.invoicecode," & _
									"        ish.fcba," & _
									"        ish.invoicedate," & _
									"        ish.suppliercode," & _
									"        tr.controljob jobinvoice_Cr," & _
									"        pmd.param_1 jobinvoice_db," & _
									"        (SELECT controljob_out FROM controljob_tax WHERE fccode = 'PPN') AS jobcodeppn_db," & _
									"        (SELECT controljob_out FROM controljob_tax WHERE fccode = 'PPN_B') AS jobcodeppn_cr," & _
									"        pmd2.fccode jobDP_cr," & _
									"		 tr.fcname suppliername," & _ 
									"        round(NVL(ish.paid,0),2) paid, " & _
									"        ish.pocode," & _
									"        round(NVL(ish.totalppn,0),2) totalppn," & _
									"        round(NVL(ish.totalamount,0),2) totalamount," & _
									"        NVL(ish.no_faktur,'') no_faktur, " & _
									"        To_char(NVL(ish.fakturdate,'01/01/1900'),'MM/DD/YYYY') fakturdate," & _
									"        round(NVL(ish.otherchargestock,0),2) otherchargestock," & _
									"		 round(NVL(ish.dp,0),2) dp " & _
									"   FROM  invoice ish " & _
									"        INNER JOIN supplier tr " & _
									"        ON (tr.fccode = ish.suppliercode AND tr.fcba = ish.fcba) " & _
									"        INNER JOIN " & _
									"        (SELECT fcba, param_1 FROM parameterDETAIL WHERE parcode = 'HARDCODE' AND PARHEADCODE = 'CONTROLJOB_MODULE' AND fccode = 'PURCHASE') pmd " & _
									"        ON (ish.fcba = pmd.fcba) " & _
									"        INNER JOIN " & _
									"        (SELECT fcba, fccode FROM parameterDETAIL WHERE parcode = 'HARDCODE' AND PARHEADCODE = 'JOBCODE_OTHERCHARGE') pmd2 " & _
									"        ON (ish.fcba = pmd2.fcba) " & _
									"  WHERE     TO_NUMBER(TO_CHAR (ish.invoicedate, 'MM')) = '"& Month(Session("v_Purchase")) &"'" & _
									"        AND TO_NUMBER(TO_CHAR (ish.invoicedate, 'yyyy')) = '"& Year(Session("v_Purchase")) &"'" & _
									"        AND ish.fcba = '"& session("fcba") &"'" 
									
        Set rsReceive = Server.CreateObject("ADODB.Recordset")
		rsReceive.Open qReceive, connstr
		
		if not rsReceive.eof then
		   Do While Not rsReceive.eof
		   
				if cdbl(to_nol(rsReceive("dp"))) > 0 then
				    maxLineNo = maxLineNo + 1
